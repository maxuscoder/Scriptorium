<Window x:Class="Scriptorium.App.Views.EditMomentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit moment" Width="500" ResizeMode="NoResize" SizeToContent="Height"
    Style="{StaticResource Dialog.Window}" WindowStartupLocation="CenterOwner"
    FontFamily="{StaticResource FontFamily.Application}">
    <StackPanel>
        <TextBlock Style="{StaticResource Text.PanelTitle}" Text="Edit moment" />
        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Text="Update the title, times, notes, or tags. Times use hours:minutes:seconds." />
        <TextBlock Margin="0,16,0,6" Style="{StaticResource Text.Label}" Text="Title" />
        <TextBox x:Name="TitleInput" Style="{StaticResource Input.TextBox}" AutomationProperties.Name="Title" />
        <TextBlock Margin="0,12,0,6" Style="{StaticResource Text.Label}" Text="Start time" />
        <TextBox x:Name="StartInput" Style="{StaticResource Input.TextBox}" AutomationProperties.Name="Start time" />
        <TextBlock Margin="0,12,0,6" Style="{StaticResource Text.Label}" Text="End time (optional)" />
        <TextBox x:Name="EndInput" Style="{StaticResource Input.TextBox}" AutomationProperties.Name="End time" />
        <TextBlock Margin="0,12,0,6" Style="{StaticResource Text.Label}" Text="Notes (optional)" />
        <TextBox x:Name="NotesInput" Style="{StaticResource Input.TextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Notes" />
        <TextBlock Margin="0,12,0,6" Style="{StaticResource Text.Label}" Text="Tags (comma separated)" />
        <TextBox x:Name="TagsInput" Style="{StaticResource Input.TextBox}" AutomationProperties.Name="Tags" />
        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="CancelButton" Margin="0,0,8,0" Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" />
            <Button x:Name="SaveButton" Click="OnSave" Content="Save changes" IsDefault="True" Style="{StaticResource Button.Primary}" />
        </StackPanel>
    </StackPanel>
</Window>
