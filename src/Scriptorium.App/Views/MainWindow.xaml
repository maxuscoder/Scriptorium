<Window x:Class="Scriptorium.App.Views.MainWindow" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    Title="Scriptorium" Icon="/Scriptorium.App;component/Assets/scriptorium.ico"
    Width="1200" Height="760" MinWidth="800" MinHeight="500"
    WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
    Background="{DynamicResource Brush.SurfaceHeader}"
    UseLayoutRounding="True" SnapsToDevicePixels="True"
    Loaded="OnLoaded" SizeChanged="OnSizeChanged">
    <!-- Windows owns the non-client title bar, caption controls and resize frame. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:Sidebar x:Name="SidebarNavigation" />
        <Border Grid.Column="1" Background="{DynamicResource Brush.Background}">
            <ContentControl MinWidth="0" MinHeight="0" Content="{Binding CurrentPage}" />
        </Border>
        <controls:NotificationCenter Grid.ColumnSpan="2" HorizontalAlignment="Right"
            VerticalAlignment="Top" Margin="{StaticResource Spacing.M}"
            DataContext="{Binding Notifications}" Panel.ZIndex="10" IsHitTestVisible="True" />
    </Grid>
</Window>
