<Window
    x:Class="Scriptorium.App.Views.MainWindow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Scriptorium"
    Width="1200"
    Height="760"
    MinWidth="800"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    Loaded="OnLoaded"
    SizeChanged="OnSizeChanged"
    mc:Ignorable="d">
    <Grid Background="{StaticResource Brush.Background}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:Sidebar x:Name="SidebarNavigation" />

        <ContentControl
            Grid.Column="1"
            Margin="0,0,0,0"
            MinWidth="0"
            MinHeight="0"
            Content="{Binding CurrentPage}" />
    </Grid>
</Window>
