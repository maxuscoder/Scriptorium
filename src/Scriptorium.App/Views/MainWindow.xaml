<Window
    x:Class="Scriptorium.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Scriptorium"
    Width="1100"
    Height="700"
    MinWidth="800"
    MinHeight="500"
    mc:Ignorable="d">
    <Grid Background="{StaticResource Brush.Background}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:Sidebar Grid.RowSpan="2" />

        <Border
            Grid.Column="1"
            Padding="{StaticResource Padding.Header}"
            Background="{StaticResource Brush.SurfaceHeader}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Text.PageTitle}"
                    Text="{Binding PageTitle}" />
                <Grid Grid.Column="1">
                    <TextBox
                        x:Name="GlobalSearchBox"
                        VerticalContentAlignment="Center"
                        ToolTip="Search all imported media"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource Input.TextBox}" />
                    <TextBlock
                        Margin="11,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.TextMuted}"
                        IsHitTestVisible="False"
                        Text="Search all imported media">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=GlobalSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <ContentControl
            Grid.Row="1"
            Grid.Column="1"
            MinWidth="0"
            MinHeight="0"
            Content="{Binding CurrentPage}" />
    </Grid>
</Window>
