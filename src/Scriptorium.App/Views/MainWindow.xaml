<Window
    x:Class="Scriptorium.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Scriptorium"
    Width="1100"
    Height="700"
    MinWidth="800"
    MinHeight="500"
    mc:Ignorable="d">
    <Grid Background="#171A21">
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Background" Value="#2B3240" />
                <Setter Property="BorderBrush" Value="#3A4355" />
                <Setter Property="Foreground" Value="#F4F6FA" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Foreground" Value="#D6DBE5" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.RowSpan="2"
            Background="#20242E"
            BorderBrush="#303746"
            BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <TextBlock
                    DockPanel.Dock="Top"
                    Margin="8,8,8,28"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#F4F6FA"
                    Text="SCRIPTORIUM" />

                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Pages}"
                    SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="15" Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border
            Grid.Column="1"
            Padding="32,0"
            Background="#1C2029"
            BorderBrush="#303746"
            BorderThickness="0,0,0,1">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="#F4F6FA"
                Text="{Binding PageTitle}" />
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl
                MinWidth="0"
                MinHeight="0"
                Margin="32"
                Content="{Binding SelectedPage}" />
        </ScrollViewer>
    </Grid>
</Window>
