<Window x:Class="Scriptorium.App.Views.SaveMomentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Save moment" Width="500" ResizeMode="NoResize" SizeToContent="Height"
    Style="{StaticResource Dialog.Window}" WindowStartupLocation="CenterOwner"
    FontFamily="{StaticResource FontFamily.Application}">
    <StackPanel>
        <TextBlock Style="{StaticResource Text.PanelTitle}" Text="Save moment" />
        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                   Text="Save a timestamp or add an end time for a sequence. Times use hours:minutes:seconds." />
        <TextBlock Margin="0,16,0,6" Style="{StaticResource Text.Label}" Text="Start time" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Use current" Click="OnCurrentStart" Style="{StaticResource Button.Secondary}" />
            <TextBox x:Name="StartInput" Style="{StaticResource Input.TextBox}" AutomationProperties.Name="Start time" />
        </DockPanel>
        <TextBlock Margin="0,12,0,6" Style="{StaticResource Text.Label}" Text="End time (optional)" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Use current" Click="OnCurrentEnd" Style="{StaticResource Button.Secondary}" />
            <TextBox x:Name="EndInput" Style="{StaticResource Input.TextBox}" AutomationProperties.Name="End time" />
        </DockPanel>
        <TextBlock Margin="0,12,0,6" Style="{StaticResource Text.Label}" Text="Title" />
        <TextBox x:Name="TitleInput" Style="{StaticResource Input.TextBox}" AutomationProperties.Name="Title" />
        <TextBlock Margin="0,12,0,6" Style="{StaticResource Text.Label}" Text="Notes (optional)" />
        <TextBox x:Name="NotesInput" Style="{StaticResource Input.TextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Notes" />
        <TextBlock Margin="0,12,0,6" Style="{StaticResource Text.Label}" Text="Tags (comma separated)" />
        <TextBox x:Name="TagsInput" Style="{StaticResource Input.TextBox}" AutomationProperties.Name="Tags" />
        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="CancelButton" Margin="0,0,8,0" Click="OnCancel" Content="Cancel" Style="{StaticResource Button.Secondary}" IsCancel="True" />
            <Button x:Name="SaveButton" Click="OnSave" Content="Save moment" Style="{StaticResource Button.Primary}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
