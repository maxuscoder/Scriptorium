<Window FontFamily="{StaticResource FontFamily.Application}"
    x:Class="Scriptorium.App.Views.MediaTypeSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Review folder media"
    Width="860" Height="680" ResizeMode="NoResize"
    Style="{StaticResource Dialog.Window}" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Text="ADD TO YOUR LIBRARY" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.PanelTitle}" Text="Review your media" />
            <TextBlock Margin="0,8,0,0" FontWeight="Medium" Text="{Binding FolderName}" TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{Binding FolderPath}" ToolTip="{Binding FolderPath}" TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Summary}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Padding="9,5" CornerRadius="6" Background="{DynamicResource Brush.Surface}">
                    <TextBlock FontSize="12" Text="{Binding MovieCount}" />
                </Border>
                <Border Margin="6,0,0,0" Padding="9,5" CornerRadius="6" Background="{DynamicResource Brush.Surface}">
                    <TextBlock FontSize="12" Text="{Binding TvShowCount}" />
                </Border>
                <Border Margin="6,0,0,0" Padding="9,5" CornerRadius="6" Background="{DynamicResource Brush.Surface}">
                    <TextBlock FontSize="12" Text="{Binding TutorialCount}" />
                </Border>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}" Text="MEDIA FILE" />
                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}" Text="MEDIA TYPE" />
                </Grid>
                <ListBox x:Name="MediaFilesList" Grid.Row="1" ItemsSource="{Binding Files}" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource Brush.TextPrimary}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True" HorizontalContentAlignment="Stretch"
                         AutomationProperties.Name="Media files to import">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="8" Background="{DynamicResource Brush.Surface}">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Extension}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Location}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ClassificationNote}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" VerticalAlignment="Center" ItemsSource="{Binding MediaTypes}"
                                              DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                              SelectedValue="{Binding MediaType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource Input.ComboBox}" ItemContainerStyle="{StaticResource Input.ComboBoxItem}"
                                              AutomationProperties.Name="{Binding FileName, StringFormat='Media type for {0}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="A folder can contain different media types." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Click="OnCancel" Content="Cancel" Style="{StaticResource Button.Secondary}" />
                <Button x:Name="AddFolderButton" Click="OnAddFolder" Content="{Binding ImportLabel}" IsEnabled="{Binding CanImport}"
                        IsDefault="True" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
