<Window
    x:Class="Scriptorium.App.Views.MediaTypeSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:Scriptorium.Core.Models;assembly=Scriptorium.Core"
    Title="Choose media type"
    Width="420"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
    <Border Margin="20" Style="{StaticResource Dialog.Surface}">
        <StackPanel>
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{StaticResource Brush.TextPrimary}"
                Text="What does this folder contain?" />
            <TextBlock
                Margin="0,8,0,0"
                Foreground="{StaticResource Brush.TextSecondary}"
                Text="Choose one supported media type. All media found in this folder will be classified with it."
                TextWrapping="Wrap" />
            <ComboBox
                x:Name="MediaTypeComboBox"
                Margin="0,20,0,0"
                Padding="8"
                SelectionChanged="OnMediaTypeSelectionChanged">
                <ComboBoxItem Tag="{x:Static models:MediaType.Tutorial}">Tutorials</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static models:MediaType.TvShow}">TV shows</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static models:MediaType.Movie}">Movies</ComboBoxItem>
            </ComboBox>
            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Click="OnCancel"
                    Content="Cancel"
                    Style="{StaticResource Button.Secondary}" />
                <Button
                    x:Name="AddFolderButton"
                    Click="OnAddFolder"
                    Content="Add folder"
                    IsEnabled="False"
                    Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
