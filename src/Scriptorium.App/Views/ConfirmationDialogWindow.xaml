<Window
    x:Class="Scriptorium.App.Views.ConfirmationDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="440"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
    <Border Margin="20" Style="{StaticResource Dialog.Surface}">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.PanelTitle}" />
            <TextBlock
                x:Name="MessageText"
                Margin="0,10,0,0"
                Foreground="{DynamicResource Brush.TextSecondary}"
                TextWrapping="Wrap" />
            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Click="OnCancel"
                    Content="Cancel"
                    IsCancel="True"
                    IsDefault="True"
                    Style="{StaticResource Button.Secondary}" />
                <Button
                    Click="OnConfirm"
                    Content="Confirm"
                    IsDefault="False"
                    Style="{StaticResource Button.Destructive}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
