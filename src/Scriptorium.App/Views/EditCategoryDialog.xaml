<Window
    x:Class="Scriptorium.App.Views.EditCategoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Scriptorium.App.Behaviors"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    Title="Edit category"
    Width="440"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Brush.Background}"
    Foreground="{DynamicResource Brush.TextPrimary}">
    <Border Margin="20" Style="{StaticResource Dialog.Surface}" behaviors:MotionBehavior.Enter="True">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.PanelTitle}" Text="Edit category" />
            <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Helper}" Text="Change the collection name or its subtle library accent." />
            <TextBlock Margin="0,20,0,6" Style="{StaticResource Text.Label}" Text="Category name" />
            <TextBox x:Name="NameTextBox" Style="{StaticResource Input.TextBox}" />
            <TextBlock Margin="0,16,0,6" Style="{StaticResource Text.Label}" Text="Collection accent" />
            <controls:CategoryColorPicker x:Name="ColorPicker" HorizontalAlignment="Left" />
            <TextBlock x:Name="ValidationMessage" Margin="0,12,0,0" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0" IsCancel="True" Content="Cancel" Style="{StaticResource Button.Secondary}" />
                <Button Click="OnSave" Content="Save changes" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
