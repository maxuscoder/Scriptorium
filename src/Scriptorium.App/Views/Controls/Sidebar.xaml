<UserControl
    x:Class="Scriptorium.App.Views.Controls.Sidebar"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls">
    <Border
        Background="{StaticResource Brush.Surface}"
        BorderBrush="{StaticResource Brush.Border}"
        BorderThickness="0,0,1,0">
        <DockPanel Margin="{StaticResource Spacing.M}">
            <TextBlock
                DockPanel.Dock="Top"
                Margin="8,8,8,28"
                Style="{StaticResource Text.Brand}"
                Text="SCRIPTORIUM" />

            <ItemsControl ItemsSource="{Binding NavigationItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Style="{StaticResource NavigationItemButton}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:Sidebar}}}"
                            CommandParameter="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSize.Heading}"
                                    Text="{Binding Icon}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSize.Navigation}"
                                    Text="{Binding Label}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
