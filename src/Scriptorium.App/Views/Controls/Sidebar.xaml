<UserControl x:Class="Scriptorium.App.Views.Controls.Sidebar" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="SidebarNavigationItemTemplate">
            <Button Style="{StaticResource Shell.NavigationItem}"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:Sidebar}}}"
                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Shell.NavigationIcon}" />
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Shell.ExpandedText}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Border Background="{DynamicResource Brush.Sidebar.Frost}" BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="0,0,1,0" CornerRadius="0,0,0,0">
        <DockPanel Margin="{StaticResource Shell.Padding}" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="{StaticResource Shell.Brand.Height}"
                Margin="{StaticResource Shell.Brand.Margin}">
                <Button x:Name="LogoButton" Click="OnLogoClick" Padding="0" BorderThickness="0"
                    Background="Transparent">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Base}">
                            <Setter Property="ToolTip" Value="Collapse sidebar" />
                            <Setter Property="AutomationProperties.Name" Value="Collapse sidebar" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                    <Setter Property="ToolTip" Value="Expand sidebar" />
                                    <Setter Property="AutomationProperties.Name" Value="Expand sidebar" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Image Width="{StaticResource Space.6}" Height="{StaticResource Space.6}"
                        Source="/Scriptorium.App;component/Assets/logo-90px.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
                <TextBlock Text="Scriptorium" Style="{StaticResource Shell.Brand}" />
            </StackPanel>
            <Border DockPanel.Dock="Top" Height="{StaticResource Stroke.Hairline}"
                Margin="{StaticResource Shell.Brand.Divider.Margin}" Background="{DynamicResource Brush.BorderStrong}"
                IsHitTestVisible="False" />
            <Border DockPanel.Dock="Bottom" Margin="{StaticResource Shell.Settings.Margin}"
                Padding="{StaticResource Shell.Settings.Padding}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="{StaticResource Shell.Settings.Divider}">
                <ItemsControl ItemTemplate="{StaticResource SidebarNavigationItemTemplate}" ItemsSource="{Binding SecondaryNavigationItems}" />
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemTemplate="{StaticResource SidebarNavigationItemTemplate}" ItemsSource="{Binding PrimaryNavigationItems}" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
