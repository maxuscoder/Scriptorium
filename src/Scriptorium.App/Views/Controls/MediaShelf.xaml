<UserControl x:Class="Scriptorium.App.Views.Controls.MediaShelf" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    Loaded="OnLoaded" Unloaded="OnUnloaded" PreviewMouseWheel="OnWheel" PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp">
    <StackPanel Margin="{StaticResource Home.Shelf.Margin}">
        <Grid MinHeight="36">
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
        </Grid>
        <Grid>
            <ListBox x:Name="Items" ItemsSource="{Binding ItemsSource, ElementName=Root}"
                Padding="{StaticResource Home.Shelf.Padding}"
                Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Page"
                ScrollViewer.ScrollChanged="OnScrollChanged">
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" /><Setter Property="Focusable" Value="False" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></ControlTemplate></Setter.Value></Setter>
                </Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <controls:MediaCard CardWidth="{StaticResource MediaCard.Width}" Margin="{StaticResource Home.Shelf.CardMargin}" IsListLayout="False"
                        Title="{Binding Title}" Metadata="{Binding CardMetadata}" ThumbnailPath="{Binding ThumbnailPath}"
                        IsMissing="{Binding IsMissing}" IsFavorite="{Binding IsFavorite}" HasPlaybackProgress="{Binding HasPlaybackProgress}"
                        PlaybackProgressPercentage="{Binding PlaybackProgressPercentage}" ActionText="Open" ActionParameter="{Binding}"
                        ActionCommand="{Binding OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:MediaShelf}}}"
                        FavoriteParameter="{Binding}" FavoriteCommand="{Binding FavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:MediaShelf}}}" />
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Grid Height="{Binding ArtworkHeight, ElementName=Root}" VerticalAlignment="Top" Margin="{StaticResource Home.Shelf.NavigationMargin}">
                <Button x:Name="PreviousButton" Style="{StaticResource Home.Shelf.NavigationButton}" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalAlignment="Center"
                    Click="OnPrevious" IsEnabled="{Binding CanScrollLeft, ElementName=Root}"
                    Visibility="{Binding CanScrollLeft, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="Previous titles" AutomationProperties.Name="Previous titles">
                    <Path Margin="4,0,0,0" Data="M 8,1 L 2,7 L 8,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource Home.Shelf.NavigationButton}" HorizontalAlignment="Right" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                    Click="OnNext" IsEnabled="{Binding CanScrollRight, ElementName=Root}"
                    Visibility="{Binding CanScrollRight, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="More titles" AutomationProperties.Name="More titles">
                    <Path Margin="0,0,4,0" Data="M 2,1 L 8,7 L 2,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
