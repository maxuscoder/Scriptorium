<UserControl x:Class="Scriptorium.App.Views.Controls.MediaEmptyArtwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root" Width="128" Height="128" IsHitTestVisible="False" Focusable="False">
    <Grid>
        <Ellipse Fill="{DynamicResource Brush.Card.Surface}" StrokeThickness="1.5">
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFE5D2" Offset="0" />
                    <GradientStop Color="{DynamicResource Color.AccentStrong}" Offset="0.4" />
                    <GradientStop Color="{DynamicResource Color.AccentBorder}" Offset="1" />
                </LinearGradientBrush>
            </Ellipse.Stroke>
            <Ellipse.Effect>
                <DropShadowEffect Color="{DynamicResource Color.Accent}" ShadowDepth="0" BlurRadius="28" Opacity="0.65" />
            </Ellipse.Effect>
        </Ellipse>
        <Path Width="50" Height="44" Stretch="Uniform"
              Data="M10,3 H44 Q51,3 51,10 V38 Q51,45 44,45 H10 Q3,45 3,38 V10 Q3,3 10,3 Z M21,14 L36,24 L21,34 Z"
              Stroke="{DynamicResource Brush.TextPrimary}" StrokeThickness="3" StrokeLineJoin="Round">
            <Path.Style>
                <Style TargetType="Path"><Style.Triggers>
                    <DataTrigger Binding="{Binding IsLibrary, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style>
            </Path.Style>
        </Path>
        <Path Width="46" Height="42" Stretch="Uniform"
              Data="M4,12 Q4,6 10,6 H20 L26,13 H42 Q48,13 48,19 V39 Q48,45 42,45 H10 Q4,45 4,39 Z M4,16 H19 L25,13"
              Stroke="{DynamicResource Brush.TextPrimary}" StrokeThickness="3" StrokeLineJoin="Round">
            <Path.Style>
                <Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                    <DataTrigger Binding="{Binding IsLibrary, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers></Style>
            </Path.Style>
        </Path>
    </Grid>
</UserControl>
