<UserControl
    x:Class="Scriptorium.App.Views.Controls.Library.LibraryMediaBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    xmlns:library="clr-namespace:Scriptorium.App.Views.Controls.Library"
    xmlns:pages="clr-namespace:Scriptorium.App.ViewModels.Pages"
    Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding ActiveBrowseDescription}" />
                <Button Grid.Column="1" Command="{Binding ClearFiltersCommand}" Content="Clear filters">
                    <Button.Style><Style BasedOn="{StaticResource Button.Secondary}" TargetType="Button"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasActiveFilters}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
            </Grid>
            <Border Margin="0,12,0,0" Background="{StaticResource Brush.SurfaceOverlay}" CornerRadius="{StaticResource CornerRadius.M}" Padding="12">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><ProgressBar Height="4" IsIndeterminate="True" Background="{StaticResource Brush.Border}" Foreground="{StaticResource Brush.Accent}" /><TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextPrimary}" Text="Loading your library…" /><TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Metadata}" Text="Reading indexed media and collections. You can continue using the app." /></StackPanel>
                    <Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding CancelLibraryLoadCommand}" Content="Stop loading" Style="{StaticResource Button.Secondary}" />
                </Grid>
            </Border>
            <Border Margin="0,12,0,0" Background="{StaticResource Brush.DangerSurface}" BorderBrush="{StaticResource Brush.Danger}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.M}" Padding="12">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasLibraryLoadIssue}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.Danger}" Text="{Binding LibraryLoadMessage}" TextWrapping="Wrap" /><Button Grid.Column="1" Margin="16,0,0,0" Command="{Binding RetryLibraryLoadCommand}" Content="Try again" Style="{StaticResource Button.Secondary}" /></Grid>
            </Border>
            <Border Margin="0,12,0,0" Background="{StaticResource Brush.SurfaceOverlay}" CornerRadius="{StaticResource CornerRadius.M}" Padding="12">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextPrimary}" Text="{Binding ScanProgressMessage}" /><TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Metadata}" Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding CurrentScanPath}" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding CancelScanCommand}" Content="Stop scan" Style="{StaticResource Button.Secondary}" /></Grid>
            </Border>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Metadata}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ListBox x:Name="BrowserList" Grid.Row="1" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" ItemsSource="{Binding BrowserRows}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" SizeChanged="OnBrowserSizeChanged">
            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch" /></ControlTemplate></Setter.Value></Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Resources>
                <DataTemplate DataType="{x:Type pages:LibraryBrowserSectionRow}"><TextBlock Margin="0,24,0,8" Style="{StaticResource Text.SectionTitle}" Text="{Binding Title}" /></DataTemplate>
                <DataTemplate DataType="{x:Type pages:LibraryBrowserCardsRow}">
                    <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding Cards}">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type pages:LibraryMediaItemViewModel}"><controls:MediaCard CardWidth="280" Margin="0,0,16,16" CategoryColor="{Binding CategoryColor}" CategoryName="{Binding CategoryName}" FavoriteCommand="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" FavoriteParameter="{Binding}" FallbackGlyph="{Binding TypeGlyph}" HasPlaybackProgress="{Binding HasPlaybackProgress}" IsFavorite="{Binding IsFavorite}" IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=ListBox}}" IsMissing="{Binding IsMissing}" PlaybackProgressPercentage="{Binding PlaybackProgressPercentage}" PlaybackProgressText="{Binding PlaybackProgressText}" PrimaryMetadata="{Binding Detail}" SecondaryMetadata="{Binding Runtime}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="{Binding MediaType}" /></DataTemplate>
                            <DataTemplate DataType="{x:Type pages:MovieItemViewModel}"><controls:MediaCard CardWidth="280" Margin="0,0,16,16" ActionCommand="{Binding DataContext.OpenMovieCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" ActionParameter="{Binding}" ActionText="Open movie" CategoryColor="{Binding CategoryColor}" CategoryName="{Binding CategoryName}" FavoriteCommand="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" FavoriteParameter="{Binding}" FallbackGlyph="M" HasPlaybackProgress="{Binding HasPlaybackProgress}" IsFavorite="{Binding IsFavorite}" IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=ListBox}}" IsMissing="{Binding IsMissing}" PlaybackProgressPercentage="{Binding PlaybackProgressPercentage}" PlaybackProgressText="{Binding PlaybackProgressText}" PrimaryMetadata="{Binding ReleaseYear}" SecondaryMetadata="{Binding Runtime}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="Movie" /></DataTemplate>
                            <DataTemplate DataType="{x:Type pages:TutorialCollectionViewModel}"><controls:MediaCard CardWidth="280" Margin="0,0,16,16" ActionCommand="{Binding DataContext.OpenTutorialCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" ActionParameter="{Binding}" ActionText="Open course" FallbackGlyph="T" IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=ListBox}}" PrimaryMetadata="{Binding LessonCountText}" SecondaryMetadata="{Binding SourceFolder}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="Tutorial" /></DataTemplate>
                            <DataTemplate DataType="{x:Type pages:TvShowCollectionViewModel}"><controls:MediaCard CardWidth="280" Margin="0,0,16,16" ActionCommand="{Binding DataContext.OpenTvShowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" ActionParameter="{Binding}" ActionText="Open show" FallbackGlyph="TV" IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=ListBox}}" PrimaryMetadata="{Binding CollectionInfo}" SecondaryMetadata="{Binding SourceFolder}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="TV show" /></DataTemplate>
                        </ItemsControl.Resources>
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter.Value></Setter>
                                <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style></Setter.Value></Setter>
                                <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter></DataTrigger></Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>
                </DataTemplate>
                <DataTemplate DataType="{x:Type pages:LibraryBrowserEmptyRow}">
                    <StackPanel Margin="0,40,0,40" HorizontalAlignment="Center" MaxWidth="420">
                        <TextBlock Style="{StaticResource Text.Display}" Text="{Binding DataContext.EmptyLibraryTitle, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Body.Center}" Text="{Binding DataContext.EmptyLibraryDescription, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <Button Margin="0,22,0,0" HorizontalAlignment="Center" Command="{Binding DataContext.FolderManagement.ImportFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" Content="Add library folder" Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate DataType="{x:Type pages:LibraryBrowserFoldersRow}"><library:WatchedFoldersPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" /></DataTemplate>
                <DataTemplate DataType="{x:Type pages:LibraryBrowserTvShowGroupsRow}"><library:TvShowGroupManager DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" /></DataTemplate>
            </ListBox.Resources>
        </ListBox>
    </Grid>
</UserControl>
