<UserControl
    x:Class="Scriptorium.App.Views.Controls.Library.LibraryMediaBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls">
    <StackPanel>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding ActiveBrowseDescription}" /><Button Grid.Column="1" Command="{Binding ClearFiltersCommand}" Content="Clear filters"><Button.Style><Style BasedOn="{StaticResource Button.Secondary}" TargetType="Button"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasActiveFilters}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid>
        <Border Margin="0,12,0,0" Background="{StaticResource Brush.SurfaceOverlay}" CornerRadius="{StaticResource CornerRadius.M}" Padding="12"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextPrimary}" Text="{Binding ScanProgressMessage}" /><TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Metadata}" Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding CurrentScanPath}" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding CancelScanCommand}" Content="Stop scan" Style="{StaticResource Button.Secondary}" /></Grid></Border><TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Metadata}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
        <StackPanel Margin="0,32,0,0" Style="{StaticResource Library.Section}"><TextBlock Style="{StaticResource Text.SectionTitle}" Text="Tutorials" /><ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Tutorials}" Style="{StaticResource Library.MediaItems}"><ItemsControl.ItemTemplate><DataTemplate><controls:MediaCard CardWidth="280" Margin="0,0,16,16" ActionCommand="{Binding DataContext.OpenTutorialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ActionParameter="{Binding}" ActionText="Open course" FallbackGlyph="T" IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" PrimaryMetadata="{Binding LessonCountText}" SecondaryMetadata="{Binding SourceFolder}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="Tutorial" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <StackPanel Margin="0,28,0,0" Style="{StaticResource Library.Section}"><TextBlock Style="{StaticResource Text.SectionTitle}" Text="TV shows" /><ItemsControl Margin="0,16,0,0" ItemsSource="{Binding TvShows}" Style="{StaticResource Library.MediaItems}"><ItemsControl.ItemTemplate><DataTemplate><controls:MediaCard CardWidth="280" Margin="0,0,16,16" ActionCommand="{Binding DataContext.OpenTvShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ActionParameter="{Binding}" ActionText="Open show" FallbackGlyph="TV" IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" PrimaryMetadata="{Binding CollectionInfo}" SecondaryMetadata="{Binding SourceFolder}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="TV show" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <StackPanel Margin="0,28,0,0" Style="{StaticResource Library.Section}"><TextBlock Style="{StaticResource Text.SectionTitle}" Text="Movies" /><ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Movies}" Style="{StaticResource Library.MediaItems}"><ItemsControl.ItemTemplate><DataTemplate><controls:MediaCard CardWidth="280" Margin="0,0,16,16" ActionCommand="{Binding DataContext.OpenMovieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ActionParameter="{Binding}" ActionText="Open movie" CategoryColor="{Binding CategoryColor}" CategoryName="{Binding CategoryName}" FallbackGlyph="M" HasPlaybackProgress="{Binding HasPlaybackProgress}" IsFavorite="{Binding IsFavorite}" IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" IsMissing="{Binding IsMissing}" PlaybackProgressPercentage="{Binding PlaybackProgressPercentage}" PlaybackProgressText="{Binding PlaybackProgressText}" PrimaryMetadata="{Binding ReleaseYear}" SecondaryMetadata="{Binding Runtime}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="Movie" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <StackPanel Margin="0,32,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasActiveFilters}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><Grid><TextBlock Style="{StaticResource Text.SectionTitle}" Text="Browse results" /><TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding MediaCountText}" /></Grid><ItemsControl Margin="0,16,0,0" ItemsSource="{Binding MediaItems}" Style="{StaticResource Library.MediaItems}"><ItemsControl.ItemTemplate><DataTemplate><controls:MediaCard CardWidth="260" Margin="0,0,16,16" CategoryColor="{Binding CategoryColor}" CategoryName="{Binding CategoryName}" FallbackGlyph="{Binding TypeGlyph}" HasPlaybackProgress="{Binding HasPlaybackProgress}" IsFavorite="{Binding IsFavorite}" IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" IsMissing="{Binding IsMissing}" PlaybackProgressPercentage="{Binding PlaybackProgressPercentage}" PlaybackProgressText="{Binding PlaybackProgressText}" PrimaryMetadata="{Binding Detail}" SecondaryMetadata="{Binding Runtime}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="{Binding MediaType}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <StackPanel Margin="0,56,0,0" HorizontalAlignment="Center" MaxWidth="420"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLibraryEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Style="{StaticResource Text.Display}" Text="{Binding EmptyLibraryTitle}" /><TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Body.Center}" Text="{Binding EmptyLibraryDescription}" /><Button Margin="0,22,0,0" HorizontalAlignment="Center" Command="{Binding FolderManagement.ImportFolderCommand}" Content="Add library folder" Style="{StaticResource Button.Primary}" /></StackPanel>
    </StackPanel>
</UserControl>
