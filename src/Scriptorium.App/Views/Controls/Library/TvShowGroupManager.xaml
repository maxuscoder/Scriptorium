<UserControl
    x:Class="Scriptorium.App.Views.Controls.Library.TvShowGroupManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,16,0,0" DataContext="{Binding TvShowGroupManagement}" Style="{StaticResource Library.ManagementCard}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" VerticalAlignment="Center" Background="{StaticResource Brush.SurfaceOverlay}" CornerRadius="{StaticResource CornerRadius.S}">
                    <Path Width="{StaticResource Icon.Size.Compact}" Height="{StaticResource Icon.Size.Compact}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M21,17H3V5H21M21,3H3C1.89,3 1,3.89 1,5V17A2,2 0 0,0 3,19H8V21H16V19H21A2,2 0 0,0 23,17V5C23,3.89 22.1,3 21,3Z" Fill="{StaticResource Brush.TextPrimary}" Stretch="Uniform" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Organize TV-show groups" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Helper}" Text="Organize and structure your detected TV-show groups." />
                </StackPanel>
            </StackPanel>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}" Text="Source group" />
                    <Grid Margin="0,6,0,0">
                        <ComboBox HorizontalAlignment="Stretch" MaxWidth="Infinity" DisplayMemberPath="DisplayName" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" Style="{StaticResource Library.ComboBox}" />
                        <TextBlock Text="Select source group">
                            <TextBlock.Style><Style BasedOn="{StaticResource Library.Placeholder}" TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SelectedGroup}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Media in source group" />
                    <Grid Margin="0,6,0,0">
                        <ComboBox HorizontalAlignment="Stretch" MaxWidth="Infinity" DisplayMemberPath="DisplayName" ItemsSource="{Binding SelectedGroup.Media}" SelectedItem="{Binding SelectedMedia, Mode=TwoWay}" Style="{StaticResource Library.ComboBox}" />
                        <TextBlock Text="Select media">
                            <TextBlock.Style><Style BasedOn="{StaticResource Library.Placeholder}" TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SelectedMedia}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Label}" Text="Destination group" />
            <Grid Margin="0,6,0,0">
                <ComboBox HorizontalAlignment="Stretch" MaxWidth="Infinity" DisplayMemberPath="DisplayName" ItemsSource="{Binding Groups}" SelectedItem="{Binding TargetGroup, Mode=TwoWay}" Style="{StaticResource Library.ComboBox}" />
                <TextBlock Text="Select destination group">
                    <TextBlock.Style><Style BasedOn="{StaticResource Library.Placeholder}" TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding TargetGroup}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>

            <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Label}" Text="Group name" />
            <TextBox Margin="0,6,0,0" Style="{StaticResource Input.TextBox}" Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Used when renaming a group or splitting selected media" />

            <Border Margin="0,16,0,0" Style="{StaticResource Library.InfoBanner}">
                <StackPanel Orientation="Horizontal"><Path Width="{StaticResource Icon.Size.Compact}" Height="{StaticResource Icon.Size.Compact}" VerticalAlignment="Center" Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12 10,10 0 0,0 12,22 10,10 0 0,0 22,12 10,10 0 0,0 12,2Z" Fill="{StaticResource Brush.TextMuted}" Stretch="Uniform" /><TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Helper}" Text="Choose a source group, select media, and pick a destination group to organize your library." /></StackPanel>
            </Border>

            <WrapPanel Margin="0,16,0,0">
                <Button Margin="0,0,8,8" Command="{Binding RenameGroupCommand}" Style="{StaticResource Button.Secondary}"><StackPanel Orientation="Horizontal"><Path Width="{StaticResource Icon.Size.Compact}" Height="{StaticResource Icon.Size.Compact}" Data="M20.71,7.04C21.1,6.65 21.1,6.02 20.71,5.63L18.37,3.29C17.98,2.9 17.35,2.9 16.96,3.29L15.12,5.12 18.87,8.87M3,17.25V21H6.75L17.81,9.93 14.06,6.18 3,17.25Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /><TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Rename group" /></StackPanel></Button>
                <Button Margin="0,0,8,8" Command="{Binding MoveMediaToGroupCommand}" Style="{StaticResource Button.Secondary}"><StackPanel Orientation="Horizontal"><Path Width="{StaticResource Icon.Size.Compact}" Height="{StaticResource Icon.Size.Compact}" Data="M4,11V13H16L10.5,18.5 11.92,19.92 19.84,12 11.92,4.08 10.5,5.5 16,11H4Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /><TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Move selected media" /></StackPanel></Button>
                <Button Margin="0,0,8,8" Command="{Binding MergeGroupsCommand}" Style="{StaticResource Button.Secondary}"><StackPanel Orientation="Horizontal"><Path Width="{StaticResource Icon.Size.Compact}" Height="{StaticResource Icon.Size.Compact}" Data="M7,3H5V9H7V3M19,3H17V9H19V3M12,5L7,10V21H17V10L12,5M12,8.83L15,11.83V19H9V11.83L12,8.83Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /><TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Merge into destination" /></StackPanel></Button>
                <Button Margin="0,0,0,8" Command="{Binding SplitGroupCommand}" Style="{StaticResource Button.Secondary}"><StackPanel Orientation="Horizontal"><Path Width="{StaticResource Icon.Size.Compact}" Height="{StaticResource Icon.Size.Compact}" Data="M9,3H7V9H9V3M17,3H15V9H17V3M14,11H10V13H14V11M21,11H19V13H21V11M5,11H3V13H5V11M17,15H7V21H17V15Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /><TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Split selected media" /></StackPanel></Button>
            </WrapPanel>

            <Border Margin="0,8,0,0" Background="{StaticResource Brush.DangerSurface}" BorderBrush="{StaticResource Brush.Danger}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.M}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource Text.CardTitle}" Foreground="{StaticResource Brush.Danger}" Text="Reset library view" /><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Helper}" Text="Clears saved filters and returns to the default sort. Your media and folders stay intact." /></StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding DataContext.ResetLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Button.Destructive}"><StackPanel Orientation="Horizontal"><Path Width="{StaticResource Icon.Size.Compact}" Height="{StaticResource Icon.Size.Compact}" Data="M12,5V1L7,6 12,11V7A6,6 0 0,1 18,13 6,6 0 0,1 12,19 6,6 0 0,1 6,13H4A8,8 0 0,0 12,21 8,8 0 0,0 20,13 8,8 0 0,0 12,5Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /><TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Reset view" /></StackPanel></Button>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
