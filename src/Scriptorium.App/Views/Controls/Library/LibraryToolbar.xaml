<UserControl
    x:Class="Scriptorium.App.Views.Controls.Library.LibraryToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:library="clr-namespace:Scriptorium.App.Views.Controls.Library">
    <Grid>
        <Border Margin="0,24,0,0" Background="{StaticResource Brush.SurfaceHeader}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.L}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Height="40" Style="{StaticResource Library.SearchField}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Icon}" Foreground="{StaticResource Brush.TextMuted}" Text="&#x2315;" /><TextBox Grid.Column="1" Margin="0,1,10,1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.TextPrimary}" TextElement.Foreground="{StaticResource Brush.TextPrimary}" Style="{StaticResource Input.SearchTextBox}" VerticalContentAlignment="Center" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search your library" /><TextBlock Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" IsHitTestVisible="False" Text="Search titles, shows, folders&#x2026;"><TextBlock.Style><Style BasedOn="{StaticResource Text.Metadata}" TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SearchQuery}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers><Setter Property="Visibility" Value="Collapsed" /></Style></TextBlock.Style></TextBlock></Grid></Border><ToggleButton x:Name="FiltersButton" Grid.Column="2" Content="Filters" Style="{StaticResource Library.FilterToggle}" Checked="OnOpenFilterPanel" Unchecked="OnFilterPanelClosed" /></Grid><WrapPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextMuted}" Text="Sort" /><ComboBox Width="176" DisplayMemberPath="DisplayName" ItemsSource="{Binding SortOrders}" SelectedValue="{Binding SelectedSortOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" Style="{StaticResource Library.ComboBox}" /><Border Width="1" Height="24" Margin="12,8" Background="{StaticResource Brush.Border}" /><Button Command="{Binding SetGridLayoutCommand}" Content="&#x25A6;" ToolTip="Grid view"><Button.Style><Style BasedOn="{StaticResource Button.Secondary}" TargetType="Button"><Setter Property="MinWidth" Value="38" /><Setter Property="Padding" Value="9,6" /><Style.Triggers><DataTrigger Binding="{Binding IsGridLayout}" Value="True"><Setter Property="Background" Value="{StaticResource Brush.SelectionSurface}" /><Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Margin="4,0,0,0" Command="{Binding SetListLayoutCommand}" Content="&#x2261;" ToolTip="List view"><Button.Style><Style BasedOn="{StaticResource Button.Secondary}" TargetType="Button"><Setter Property="MinWidth" Value="38" /><Setter Property="Padding" Value="9,6" /><Style.Triggers><DataTrigger Binding="{Binding IsListLayout}" Value="True"><Setter Property="Background" Value="{StaticResource Brush.SelectionSurface}" /><Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel></Grid></Border>
        <Popup AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="Bottom" PlacementTarget="{Binding ElementName=FiltersButton}" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=FiltersButton, Mode=TwoWay}">
            <library:LibraryFilterPanel ApplyRequested="OnApplyFilterPanel" CancelRequested="OnCancelFilterPanel" />
        </Popup>
    </Grid>
</UserControl>
