<UserControl x:Class="Scriptorium.App.Views.Controls.Library.LibraryToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:library="clr-namespace:Scriptorium.App.Views.Controls.Library">
    <StackPanel Margin="{StaticResource Library.ToolbarMargin}">
        <Grid x:Name="ToolbarRoot">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="SearchArea" Height="{StaticResource Library.SearchHeight}" Margin="0,0,0,14">
                <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{StaticResource Radius.Card}" Effect="{StaticResource Elevation.1}" IsHitTestVisible="False"/>
                <Border Style="{StaticResource Library.ToolbarSearchField}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,12,0" Style="{StaticResource Library.CommandIcon}" FontSize="{StaticResource Icon.Size.Default}" Foreground="{DynamicResource Brush.TextMuted}" Text="&#xE721;"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource Library.SearchTextBox}" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search library"/>
                    <TextBlock Grid.Column="1" Text="Search library&#x2026;" IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style><Style BasedOn="{StaticResource Text.Metadata}" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Navigation}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                </Border>
            </Grid>
            <WrapPanel x:Name="CommandsArea" Grid.Row="1">
                <ToggleButton x:Name="FiltersButton" Style="{StaticResource Library.ToolbarToggle}" Checked="OnOpenFilterPanel" Unchecked="OnFilterPanelClosed" AutomationProperties.Name="Filters">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Library.CommandIcon}" Text="&#xE71C;"/><TextBlock Margin="{StaticResource Margin.IconLabel}" Text="Filters"/></StackPanel>
                </ToggleButton>
                <ComboBox x:Name="SortBox" Width="{StaticResource Library.SortWidth}" DisplayMemberPath="DisplayName" ItemsSource="{Binding SortOrders}" SelectedValue="{Binding SelectedSortOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" Style="{StaticResource Library.SortComboBox}" ToolTip="Sort library" AutomationProperties.Name="Sort library"/>
                <ToggleButton x:Name="FavoritesFirstToggle" Style="{StaticResource Library.ToolbarToggle}" IsChecked="{Binding FavoritesFirst, Mode=TwoWay}" ToolTip="Show favorites before other media" AutomationProperties.Name="Favorites first">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Library.CommandIcon}" Text="&#xE734;"/><TextBlock Margin="{StaticResource Margin.IconLabel}" Text="Favorites first"/></StackPanel>
                </ToggleButton>
                <Border x:Name="LayoutSegment" Style="{StaticResource Library.LayoutSegment}">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="GridButton" Command="{Binding SetGridLayoutCommand}" ToolTip="Grid view" AutomationProperties.Name="Grid view">
                        <Button.Style><Style BasedOn="{StaticResource Library.LayoutButton}" TargetType="Button"><Style.Resources><CornerRadius x:Key="Radius.Control">10,0,0,10</CornerRadius></Style.Resources><Style.Triggers><DataTrigger Binding="{Binding IsGridLayout}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SelectionSurface}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Style="{StaticResource Library.CommandIcon}" Text="&#xE80A;"/>
                    </Button>
                    <Border Width="1" Height="22" VerticalAlignment="Center" Background="{DynamicResource Brush.Border}" IsHitTestVisible="False"/>
                    <Button x:Name="ListButton" Command="{Binding SetListLayoutCommand}" ToolTip="List view" AutomationProperties.Name="List view">
                        <Button.Style><Style BasedOn="{StaticResource Library.LayoutButton}" TargetType="Button"><Style.Resources><CornerRadius x:Key="Radius.Control">0,10,10,0</CornerRadius></Style.Resources><Style.Triggers><DataTrigger Binding="{Binding IsListLayout}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SelectionSurface}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Style="{StaticResource Library.CommandIcon}" Text="&#xE8FD;"/>
                    </Button>
                  </StackPanel>
                </Border>
            </WrapPanel>
        </Grid>
        <DockPanel LastChildFill="True">
            <DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasActiveFilters}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
            <Button DockPanel.Dock="Right" Command="{Binding ClearFiltersCommand}" Content="Clear all" Style="{StaticResource Library.ClearFilters}"/>
            <ItemsControl ItemsSource="{Binding ActiveFilters}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Style="{StaticResource Library.FilterChip}" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding Title, StringFormat=Remove filter: {0}}" ToolTip="{Binding Title}">
                        <DockPanel><TextBlock DockPanel.Dock="Right" Margin="{StaticResource Margin.IconLabel}" Text="&#xE711;" Style="{StaticResource Library.CommandIcon}"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DockPanel>
                    </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
        <Popup x:Name="FilterPopup" AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="Bottom" PlacementTarget="{Binding ElementName=FiltersButton}" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=FiltersButton, Mode=TwoWay}">
            <library:LibraryFilterPanel Width="{Binding ActualWidth, ElementName=ToolbarRoot}"
                                        MaxWidth="{StaticResource Control.MaxWidth.Flyout}"
                                        MaxHeight="{StaticResource Library.FilterPanelMaxHeight}"
                                        ApplyRequested="OnApplyFilterPanel" CancelRequested="OnCancelFilterPanel"/>
        </Popup>
    </StackPanel>
</UserControl>
