<UserControl x:Class="Scriptorium.App.Views.Controls.Library.LibraryToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:library="clr-namespace:Scriptorium.App.Views.Controls.Library"
    SizeChanged="OnToolbarSizeChanged">
    <StackPanel Margin="{StaticResource Library.ToolbarMargin}">
        <Grid x:Name="ToolbarRoot">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="SearchArea" Style="{StaticResource Library.SearchField}" Height="{StaticResource Control.Height.Input}" Margin="{StaticResource Library.CommandGap}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Margin="{StaticResource Spacing.XS}" Style="{StaticResource Library.CommandIcon}" Foreground="{DynamicResource Brush.TextMuted}" Text="&#xE721;"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource Input.SearchTextBox}" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search library"/>
                    <TextBlock Grid.Column="1" Text="Search library…" IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style><Style BasedOn="{StaticResource Text.Metadata}" TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <WrapPanel x:Name="CommandsArea" Grid.Column="1">
                <ToggleButton x:Name="FiltersButton" Style="{StaticResource Library.ToolbarToggle}" Checked="OnOpenFilterPanel" Unchecked="OnFilterPanelClosed">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Library.CommandIcon}" Text="&#xE71C;"/><TextBlock Margin="{StaticResource Margin.IconLabel}" Text="Filters"/></StackPanel>
                </ToggleButton>
                <ComboBox x:Name="SortBox" Width="{StaticResource Library.SortWidth}" Height="{StaticResource Control.Height.Input}" Margin="{StaticResource Library.CommandGap}" DisplayMemberPath="DisplayName" ItemsSource="{Binding SortOrders}" SelectedValue="{Binding SelectedSortOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" Style="{StaticResource Library.ComboBox}" ToolTip="Sort library" AutomationProperties.Name="Sort library"/>
                <ToggleButton x:Name="FavoritesFirstToggle" Content="Favorites first" Style="{StaticResource Library.ToolbarToggle}" IsChecked="{Binding FavoritesFirst, Mode=TwoWay}" ToolTip="Show favorites before other media"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="GridButton" Command="{Binding SetGridLayoutCommand}" ToolTip="Grid view" AutomationProperties.Name="Grid view">
                        <Button.Style><Style BasedOn="{StaticResource Library.LayoutButton}" TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsGridLayout}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SelectionSurface}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Style="{StaticResource Library.CommandIcon}" Text="&#xE80A;"/>
                    </Button>
                    <Button x:Name="ListButton" Command="{Binding SetListLayoutCommand}" ToolTip="List view" AutomationProperties.Name="List view">
                        <Button.Style><Style BasedOn="{StaticResource Library.LayoutButton}" TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsListLayout}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SelectionSurface}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Style="{StaticResource Library.CommandIcon}" Text="&#xE8FD;"/>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Grid>
        <DockPanel LastChildFill="True">
            <DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasActiveFilters}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
            <Button DockPanel.Dock="Right" Command="{Binding ClearFiltersCommand}" Content="Clear all" Style="{StaticResource Library.ClearFilters}"/>
            <ItemsControl ItemsSource="{Binding ActiveFilters}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Style="{StaticResource Library.FilterChip}" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding Title, StringFormat=Remove filter: {0}}" ToolTip="{Binding Title}">
                        <DockPanel><TextBlock DockPanel.Dock="Right" Margin="{StaticResource Margin.IconLabel}" Text="&#xE711;" Style="{StaticResource Library.CommandIcon}"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DockPanel>
                    </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
        <Popup AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="Bottom" PlacementTarget="{Binding ElementName=FiltersButton}" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=FiltersButton, Mode=TwoWay}">
            <library:LibraryFilterPanel ApplyRequested="OnApplyFilterPanel" CancelRequested="OnCancelFilterPanel"/>
        </Popup>
    </StackPanel>
</UserControl>
