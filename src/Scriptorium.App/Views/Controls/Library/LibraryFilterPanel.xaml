<UserControl
    x:Class="Scriptorium.App.Views.Controls.Library.LibraryFilterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnPanelSizeChanged"
    UseLayoutRounding="True">
    <Border Margin="{StaticResource Margin.Flyout}" Padding="{StaticResource Spacing.M}"
            Background="{DynamicResource Brush.SurfaceElevated}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="{StaticResource BorderThickness.Hairline}"
            CornerRadius="{StaticResource Radius.Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Style="{StaticResource Text.PanelTitle}" Text="Filters" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Metadata}" Text="Refine your library" />
            </StackPanel>
            <!-- Keep the header and actions visible when categories need to scroll. -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly" Focusable="False">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="ColumnGap" Width="{StaticResource Library.FilterColumnGap}" />
                            <ColumnDefinition x:Name="StatusColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="MediaFilters">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Media type" />
                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding MediaTypeFilters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{StaticResource Library.FilterCheckBox}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox Margin="0,8,0,0" Content="Favorites only" IsChecked="{Binding ShowFavoritesOnly, Mode=TwoWay}"
                                      Style="{StaticResource Library.FilterCheckBox}" />
                        </StackPanel>
                        <StackPanel x:Name="StatusFilters" Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Playback" />
                            <ComboBox Margin="0,8,0,0" DisplayMemberPath="DisplayName" ItemsSource="{Binding PlaybackFilters}"
                                      SelectedValue="{Binding SelectedPlaybackFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Value" Style="{StaticResource Library.FilterComboBox}"
                                      AutomationProperties.Name="Playback" />
                            <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Label}" Text="Completion" />
                            <ComboBox Margin="0,8,0,0" DisplayMemberPath="DisplayName" ItemsSource="{Binding CompletionFilters}"
                                      SelectedValue="{Binding SelectedCompletionFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Value" Style="{StaticResource Library.FilterComboBox}"
                                      AutomationProperties.Name="Completion" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,16,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Label}" Text="Categories" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Metadata}" Text="{Binding CategoryFilterSummary}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding CategoryFilterSummary}" />
                        </Grid>
                        <ItemsControl x:Name="CategoryChoices" ItemsSource="{Binding CategoryFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource Library.CategoryFilterChip}" ToolTip="{Binding DisplayName}"
                                              MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No categories yet" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CategoryFilters.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Margin="0,8,0,0" Padding="0,12,0,0"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <WrapPanel HorizontalAlignment="Right">
                    <Button Command="{Binding ClearFiltersCommand}" Content="Clear all"
                            Style="{StaticResource Library.FilterClearAction}" />
                    <Button Click="OnCancel" Content="Cancel" Style="{StaticResource Library.FilterSecondaryAction}" />
                    <Button Click="OnApply" Content="Apply filters" Style="{StaticResource Library.FilterPrimaryAction}" />
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
