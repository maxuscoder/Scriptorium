<UserControl
    x:Class="Scriptorium.App.Views.Controls.Library.LibraryFilterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="560" Margin="0,8,0,0" Padding="24" Background="{StaticResource Brush.SurfaceElevated}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.L}" Effect="{StaticResource Elevation.3}">
        <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Text.SectionTitle}" Text="Filters" /><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}" Text="Refine your library" /></StackPanel><Button Grid.Column="1" VerticalAlignment="Top" Command="{Binding ClearFiltersCommand}" Content="Clear all" Style="{StaticResource Button.Secondary}" /></Grid>
            <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Text.Label}" Text="Media type" /><Border Margin="0,10,0,0" Background="{StaticResource Brush.SurfaceHeader}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.M}"><ItemsControl ItemsSource="{Binding MediaTypeFilters}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Height="42" Margin="12,0" Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="{StaticResource Brush.TextSecondary}" VerticalContentAlignment="Center" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Text.Label}" Text="Playback" /><ComboBox Margin="0,10,0,0" Height="42" DisplayMemberPath="DisplayName" ItemsSource="{Binding PlaybackFilters}" SelectedValue="{Binding SelectedPlaybackFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" Style="{StaticResource Library.ComboBox}" /><TextBlock Margin="0,18,0,0" Style="{StaticResource Text.Label}" Text="Completion" /><ComboBox Margin="0,10,0,0" Height="42" DisplayMemberPath="DisplayName" ItemsSource="{Binding CompletionFilters}" SelectedValue="{Binding SelectedCompletionFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" Style="{StaticResource Library.ComboBox}" /><CheckBox Margin="0,18,0,0" Content="Favorites only" Foreground="{StaticResource Brush.TextSecondary}" IsChecked="{Binding ShowFavoritesOnly, Mode=TwoWay}" /></StackPanel></Grid>
            <Border Height="1" Margin="0,20,0,18" Background="{StaticResource Brush.Border}" />
            <TextBlock Style="{StaticResource Text.Label}" Text="Categories" />
            <Expander Margin="0,10,0,0"><Expander.Header><Border Height="42" Padding="12,0" Background="{StaticResource Brush.SurfaceHeader}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.M}"><Grid><TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Control}" Text="{Binding CategoryFilterSummary}" /><Path Width="10" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.5" /></Grid></Border></Expander.Header><Border Margin="0,5,0,0" Padding="8" Background="{StaticResource Brush.SurfaceHeader}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.M}"><ItemsControl ItemsSource="{Binding CategoryFilters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="4,4,12,4" Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="{StaticResource Brush.TextSecondary}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border></Expander>
            <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal"><Button Margin="0,0,10,0" Click="OnCancel" Content="Cancel" Style="{StaticResource Button.Secondary}" /><Button Click="OnApply" Content="Apply filters" Style="{StaticResource Button.Primary}" /></StackPanel>
        </StackPanel>
    </Border>
</UserControl>
