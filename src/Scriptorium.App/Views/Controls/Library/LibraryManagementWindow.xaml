<Window x:Class="Scriptorium.App.Views.Controls.Library.LibraryManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Scriptorium.App.Behaviors"
    xmlns:library="clr-namespace:Scriptorium.App.Views.Controls.Library"
    Title="Manage Library" Width="920" Height="720" MinWidth="680" MinHeight="500"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.TextPrimary}"
    UseLayoutRounding="True">
    <Grid Margin="{StaticResource Padding.Page.Compact}" behaviors:MotionBehavior.Enter="True">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Manage Library" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Helper}" Text="Manage watched locations and organize detected TV-show groups." />
        </StackPanel>
        <TabControl Grid.Row="1" Style="{StaticResource Library.ManagementTabs}">
            <TabItem Header="Watched folders">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <library:WatchedFoldersPanel />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="TV-show groups">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <library:TvShowGroupManager />
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center" MaxWidth="620" Style="{StaticResource Text.Metadata}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            <Button HorizontalAlignment="Right" Content="Close" IsCancel="True" Style="{StaticResource Button.Secondary}" />
        </Grid>
    </Grid>
</Window>
