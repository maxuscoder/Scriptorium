<UserControl
    x:Class="Scriptorium.App.Views.Controls.MediaSeasonEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource Text.SubsectionTitle}" Text="Season number" />
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                MaxLength="9"
                Style="{StaticResource Input.TextBox}"
                Text="{Binding EditableSeasonNumber, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="2"
                Command="{Binding SaveSeasonNumberCommand}"
                Content="Save season"
                Style="{StaticResource Button.Primary}" />
        </Grid>
        <Button
            Margin="0,8,0,0"
            HorizontalAlignment="Left"
            Command="{Binding RestoreSeasonNumberCommand}"
            Content="Restore detected season"
            Style="{StaticResource Button.Secondary}" />
        <TextBlock
            Margin="0,8,0,0"
            Foreground="{StaticResource Brush.TextSecondary}"
            Text="{Binding SeasonNumberStatus}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
