<UserControl
    x:Class="Scriptorium.App.Views.Controls.MediaThumbnailEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource Text.SubsectionTitle}" Text="Thumbnail" />
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                MaxLength="1000"
                Style="{StaticResource Input.TextBox}"
                Text="{Binding EditableThumbnailPath, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Path to the selected image" />
            <Button
                Grid.Column="2"
                Command="{Binding ChooseThumbnailCommand}"
                Content="Choose image"
                Style="{StaticResource Button.Secondary}" />
            <Button
                Grid.Column="4"
                Command="{Binding SaveThumbnailCommand}"
                Content="Save thumbnail"
                Style="{StaticResource Button.Primary}" />
        </Grid>
        <TextBlock
            Margin="0,8,0,0"
            Foreground="{StaticResource Brush.TextSecondary}"
            Text="{Binding ThumbnailStatus}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
