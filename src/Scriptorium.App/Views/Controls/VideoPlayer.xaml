<UserControl
    x:Class="Scriptorium.App.Views.Controls.VideoPlayer"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="True">
    <Border Background="{StaticResource Brush.Background}"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
            CornerRadius="{StaticResource CornerRadius.M}">
        <Grid DataContext="{Binding Player, ElementName=Root}" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Source="{Binding Video}" Stretch="Uniform" AutomationProperties.Name="Video preview" />
            <TextBlock Margin="{StaticResource Spacing.L}" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding Status}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" Padding="{StaticResource Spacing.S}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding TogglePlaybackCommand}" Content="{Binding PlayActionText}"
                            Style="{StaticResource Button.Primary}" MinWidth="80" ToolTip="Play or pause video" />
                    <StackPanel Grid.Column="1" Margin="{StaticResource Spacing.S}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource Text.Metadata}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Metadata}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="OnFullscreenClick"
                            ToolTip="Toggle fullscreen (F11); exit with Esc">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                <Setter Property="Content" Value="Fullscreen" />
                                <Setter Property="IsEnabled" Value="{Binding IsReady}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFullscreen, ElementName=Root}" Value="True">
                                        <Setter Property="Content" Value="Exit fullscreen" />
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
