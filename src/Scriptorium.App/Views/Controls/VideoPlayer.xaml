<UserControl
    x:Class="Scriptorium.App.Views.Controls.VideoPlayer"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="True">
    <Border Background="{StaticResource Brush.Background}"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
            CornerRadius="{StaticResource CornerRadius.M}">
        <Grid DataContext="{Binding Player, ElementName=Root}" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Source="{Binding Video}" Stretch="Uniform"
                   MouseLeftButtonUp="OnVideoPreviewMouseLeftButtonUp"
                   Cursor="Hand"
                   ToolTip="Click to play or pause"
                   AutomationProperties.Name="Video preview" />
            <TextBlock Margin="{StaticResource Spacing.L}" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding Status}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" Padding="8,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding TogglePlaybackCommand}"
                            Width="36" Height="36" MinHeight="36"
                            VerticalAlignment="Center"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Play or pause video"
                            AutomationProperties.Name="{Binding PlayActionText}">
                        <Grid Width="16" Height="16">
                            <Path x:Name="PlayIcon" Data="M3,1 L15,8 L3,15 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Grid x:Name="PauseIcon">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle Width="4" Height="14" HorizontalAlignment="Left"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Rectangle Width="4" Height="14" HorizontalAlignment="Right"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Grid Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                                   Text="{Binding CurrentPositionText}" Style="{StaticResource Text.Metadata}" />
                        <Slider x:Name="SeekSlider"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=OneWay}"
                                IsEnabled="{Binding CanSeek}"
                                ValueChanged="OnSeekSliderValueChanged"
                                PreviewMouseLeftButtonDown="OnSeekSliderMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="OnSeekSliderMouseLeftButtonUp"
                                PreviewKeyDown="OnSeekSliderPreviewKeyDown"
                                PreviewKeyUp="OnSeekSliderPreviewKeyUp"
                                LostKeyboardFocus="OnSeekSliderLostKeyboardFocus"
                                AutomationProperties.Name="Video playback position"
                                ToolTip="Drag to seek" />
                        <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding DurationText}" Style="{StaticResource Text.Metadata}" />
                    </Grid>
                    <Button Grid.Column="2" Click="OnFullscreenClick"
                            Width="36" Height="36" MinHeight="36"
                            VerticalAlignment="Center"
                            ToolTip="Toggle fullscreen (F11); exit with Esc"
                            AutomationProperties.Name="Toggle fullscreen">
                        <Path Width="18" Height="18"
                              Data="M2,7 V2 H7 M11,2 H16 V7 M16,11 V16 H11 M7,16 H2 V11"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                <Setter Property="Width" Value="36" />
                                <Setter Property="Height" Value="36" />
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="IsEnabled" Value="{Binding IsReady}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFullscreen, ElementName=Root}" Value="True">
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
