<UserControl
    x:Class="Scriptorium.App.Views.Controls.VideoPlayer"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Scriptorium.App.Views.Controls"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    Focusable="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Scriptorium.App;component/Resources/PlayerControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource Brush.PlaybackSurface}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.M}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEdgeToEdge, ElementName=Root}" Value="True">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid x:Name="PlayerLayout" Background="Transparent" ClipToBounds="True" Focusable="True">
            <vlc:VideoView x:Name="VideoSurface"
                           local:LibVlcVideoViewBinding.Output="{Binding VideoOutput}">
                <!-- VideoView content is rendered in its foreground window, avoiding WPF airspace issues. -->
                <!-- A zero-alpha layered window passes native mouse input through to VLC. -->
                <Grid x:Name="VideoOverlay" Background="#01000000"
                      PreviewMouseWheel="OnPlayerPreviewMouseWheel"
                      MouseLeftButtonUp="OnVideoPreviewMouseLeftButtonUp"
                      Cursor="Hand"
                      AutomationProperties.Name="Video preview">
                    <Path x:Name="LetterboxMatte" Fill="Black" Stretch="Fill" IsHitTestVisible="False"
                          RenderOptions.EdgeMode="Aliased" />
                    <Border x:Name="BackButtonChrome" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Button x:Name="VideoBackButton"
                                Content="&#x2190; Library" Padding="0"
                                Background="Transparent" Foreground="White" BorderThickness="0"
                                Cursor="Hand" ToolTip="Back to Library" AutomationProperties.Name="Back to Library">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Text}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      RecognizesAccessKey="True">
                                                        <ContentPresenter.Effect>
                                                            <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1"
                                                                              Opacity="1" RenderingBias="Quality" />
                                                        </ContentPresenter.Effect>
                                                    </ContentPresenter>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Command, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Border>
                    <Border x:Name="MomentsChrome" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="4" Background="{StaticResource Player.Panel}" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                                        <Button Click="OnSavedMomentsClick" IsEnabled="{Binding CanSaveMoment}" Style="{StaticResource Player.Icon}"
                                                ToolTip="Replay saved sequences" AutomationProperties.Name="Replay saved sequences" Content="&#x25B6;" />
                                        <Button Click="OnReturnToNormalClick" ToolTip="Return to normal playback" AutomationProperties.Name="Return to normal playback" Content="&#x21A9;">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Player.Icon}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsReplayingMoment}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style></Button.Style>
                                        </Button>
                                        <CheckBox Content="Loop moment" IsChecked="{Binding LoopMoment}" Foreground="{StaticResource Player.Text}" VerticalAlignment="Center" Margin="4,0">
                                            <CheckBox.Style><Style TargetType="CheckBox"><Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsReplayingMoment}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style></CheckBox.Style>
                                        </CheckBox>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ActionFeedback" Width="72" Height="72"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.PlaybackFeedback}" CornerRadius="36" Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <Path x:Name="ActionFeedbackIcon" Width="36" Height="36"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource Brush.TextOnDark}"
                              Stroke="{DynamicResource Brush.TextOnDark}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stretch="Uniform" />
                    </Border>
                    <TextBlock Margin="{StaticResource Spacing.L}" VerticalAlignment="Center"
                               HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding Status}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border x:Name="ControlPanel" Margin="0" VerticalAlignment="Bottom" Background="{StaticResource Player.Panel}"
                            CornerRadius="0" Padding="14,14,14,6" MinHeight="64">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CurrentPositionText}" Style="{StaticResource Player.Time}" VerticalAlignment="Center" Margin="0,0,12,0"
                                           AutomationProperties.Name="Elapsed time" />
                                <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource Player.Slider}"
                                    Minimum="0" Maximum="{Binding DurationSeconds}"
                                    Value="{Binding PositionSeconds, Mode=OneWay}" IsEnabled="{Binding CanSeek}"
                                    ValueChanged="OnSeekSliderValueChanged"
                                    PreviewMouseLeftButtonDown="OnSeekSliderMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="OnSeekSliderMouseLeftButtonUp"
                                    PreviewKeyDown="OnSeekSliderPreviewKeyDown"
                                    PreviewKeyUp="OnSeekSliderPreviewKeyUp"
                                    LostKeyboardFocus="OnSeekSliderLostKeyboardFocus"
                                    AutomationProperties.Name="Video playback position" ToolTip="Drag to seek" />
                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Player.Time}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Video duration" />
                            </Grid>
                            <Viewbox x:Name="ControlActionsViewport" Grid.Row="1" Margin="0,2,0,0" Stretch="Uniform" StretchDirection="DownOnly">
                                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" MinWidth="680">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding TogglePlaybackCommand}" Style="{StaticResource Player.Play}"
                                                ToolTip="Play or pause video (Space)" AutomationProperties.Name="{Binding PlayActionText}">
                                            <Grid Width="20" Height="20">
                                                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                         StrokeThickness="1.8" />
                                                <Path x:Name="PlayIcon" Data="M8,5.5 L14,10 L8,14.5 Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <Path x:Name="PauseIcon" Data="M7.5,6.5 V13.5 M12.5,6.5 V13.5"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                        </Button>
                                        <Button Click="OnSkipBackwardClick" IsEnabled="{Binding CanSeek}"
                                                Style="{StaticResource Player.Icon}" Margin="2,0,0,0"
                                                ToolTip="Back 5 seconds (Left arrow)" AutomationProperties.Name="Back 5 seconds">
                                            <Path Width="20" Height="20" Data="M5,7 A7,7 0 1 1 4,13 M5,2 V7 H10"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Button>
                                        <Button Click="OnSkipForwardClick" IsEnabled="{Binding CanSeek}"
                                                Style="{StaticResource Player.Icon}" ToolTip="Forward 5 seconds (Right arrow)"
                                                AutomationProperties.Name="Forward 5 seconds">
                                            <Path Width="20" Height="20" Data="M15,7 A7,7 0 1 0 16,13 M15,2 V7 H10"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="OnSaveMomentClick" IsEnabled="{Binding CanSaveMoment}"
                                                Style="{StaticResource Player.Icon}" ToolTip="Save moment" AutomationProperties.Name="Save moment">
                                            <Path Width="18" Height="20" Data="M4,2 H14 V18 L9,14 L4,18 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.7" StrokeLineJoin="Round" />
                                        </Button>
                                        <Button Command="{Binding ToggleMuteCommand}" Style="{StaticResource Player.Icon}" Width="32"
                                                ToolTip="{Binding MuteActionText}" AutomationProperties.Name="{Binding MuteActionText}">
                                            <Grid Width="20" Height="20">
                                                <Path Data="M2,7 H6 L11,3 V17 L6,13 H2 Z" Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.6" StrokeLineJoin="Round" />
                                                <Path Data="M14,7 C16,8.5 16,11.5 14,13 M17,4.5 C20,7.5 20,12.5 17,15.5"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMutedIconVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <Path Data="M2,2 L18,18" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMutedIconVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                        </Button>
                                        <Slider x:Name="VolumeSlider" Width="56" Margin="6,0,6,0" VerticalAlignment="Center"
                                                Style="{StaticResource Player.Slider}" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.1"
                                                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsReady}" PreviewMouseLeftButtonDown="OnVolumeSliderMouseLeftButtonDown"
                                                AutomationProperties.Name="Volume" ToolTip="Volume: boost quiet audio up to 200% (Up / Down)" />
                                        <TextBlock x:Name="VolumePercentage" Text="{Binding Volume, StringFormat={}{0:P0}}"
                                                   Width="42" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Player.Text}" FontSize="11"
                                                   TextAlignment="Right" AutomationProperties.Name="Volume percentage" />
                                        <ComboBox x:Name="AudioSelector" Width="116" Margin="0,0,6,0" VerticalAlignment="Center"
                                                  Style="{StaticResource Player.Speed}" AutomationProperties.Name="Audio track"
                                                  ToolTip="{Binding AudioStatus}" ToolTipService.ShowOnDisabled="True" IsEnabled="{Binding CanSelectAudio}"
                                                  ItemsSource="{Binding AudioTracks}"
                                                  SelectedItem="{Binding SelectedAudioTrack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox x:Name="SubtitleSelector" Width="116" Margin="0,0,6,0" VerticalAlignment="Center"
                                                  Style="{StaticResource Player.Speed}" AutomationProperties.Name="Subtitle track"
                                                  ToolTip="{Binding SubtitleStatus}" ToolTipService.ShowOnDisabled="True" IsEnabled="{Binding CanSelectSubtitles}"
                                                  ItemsSource="{Binding SubtitleTracks}"
                                                  SelectedItem="{Binding SelectedSubtitleTrack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox x:Name="PlaybackSpeedSelector" Margin="0,0,6,0" VerticalAlignment="Center"
                                                  Style="{StaticResource Player.Speed}" AutomationProperties.Name="Playback speed" ToolTip="Playback speed"
                                                  IsEnabled="{Binding IsReady}" ItemsSource="{Binding PlaybackSpeedOptions}"
                                                  SelectedItem="{Binding PlaybackSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat={}{0:0.##}×}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button x:Name="TimingButton" Click="OnTimingClick" Style="{StaticResource Player.Icon}"
                                                IsEnabled="{Binding CanOpenTrackSettings}" ToolTip="Audio, subtitles, and synchronization"
                                                AutomationProperties.Name="Audio and subtitle settings">
                                            <Grid Width="20" Height="20">
                                                <Ellipse Width="15" Height="15" Stroke="{StaticResource Player.Text}" StrokeThickness="1.5" />
                                                <Path Data="M10,5 V10 L14,12" Stroke="{StaticResource Player.Text}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                            </Grid>
                                        </Button>
                                        <Popup x:Name="TimingPopup" Placement="Top" PlacementTarget="{Binding ElementName=TimingButton}"
                                               VerticalOffset="-6" AllowsTransparency="True" StaysOpen="False"
                                               Opened="OnTimingPopupOpened" Closed="OnPlaybackSpeedDropDownChanged">
                                            <Border x:Name="TimingPanel" Width="320" Padding="12" Background="#262629" BorderBrush="#414146" Focusable="True"
                                                    BorderThickness="1" CornerRadius="10" PreviewKeyDown="OnTimingPanelKeyDown"
                                                    TextElement.FontFamily="{StaticResource FontFamily.Application}"
                                                    TextElement.Foreground="{StaticResource Player.Text}" TextElement.FontSize="12">
                                                <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <TextBlock Text="Synchronization" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                    <TextBlock Text="Positive = later. Negative = earlier."
                                                               FontSize="11" Margin="0,0,0,8" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Subtitles" Width="66" VerticalAlignment="Center" />
                                                        <Button Width="28" Content="−" Style="{StaticResource Player.Icon}" Command="{Binding DecreaseSubtitleDelayCommand}"
                                                                ToolTip="Show subtitles 50 ms earlier" AutomationProperties.Name="Decrease subtitle delay" />
                                                        <TextBox x:Name="SubtitleDelayInput" Margin="2,0" Style="{StaticResource Player.DelayInput}"
                                                                 Text="{Binding SubtitleDelayMilliseconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:+0;-0;0}, ValidatesOnExceptions=True}"
                                                                 IsEnabled="{Binding CanAdjustSubtitleDelay}" AutomationProperties.Name="Subtitle delay in milliseconds"
                                                                 ToolTip="Enter milliseconds (−600000 to +600000), then press Enter to apply." />
                                                        <TextBlock Text="ms" Width="24" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                        <Button Width="28" Content="+" Style="{StaticResource Player.Icon}" Command="{Binding IncreaseSubtitleDelayCommand}"
                                                                ToolTip="Show subtitles 50 ms later" AutomationProperties.Name="Increase subtitle delay" />
                                                        <Button Width="46" Content="Reset" Style="{StaticResource Player.Icon}" Command="{Binding ResetSubtitleDelayCommand}"
                                                                FontSize="11" ToolTip="Reset subtitle delay to zero" AutomationProperties.Name="Reset subtitle delay" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SubtitleDelayStatus}" Style="{StaticResource Player.DelayStatus}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <TextBlock Text="Audio" Width="66" VerticalAlignment="Center" />
                                                        <Button Width="28" Content="−" Style="{StaticResource Player.Icon}" Command="{Binding DecreaseAudioDelayCommand}"
                                                                ToolTip="Play audio 50 ms earlier" AutomationProperties.Name="Decrease audio delay" />
                                                        <TextBox x:Name="AudioDelayInput" Margin="2,0" Style="{StaticResource Player.DelayInput}"
                                                                 Text="{Binding AudioDelayMilliseconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:+0;-0;0}, ValidatesOnExceptions=True}"
                                                                 IsEnabled="{Binding CanAdjustAudioDelay}" AutomationProperties.Name="Audio delay in milliseconds"
                                                                 ToolTip="Enter milliseconds (−600000 to +600000), then press Enter to apply." />
                                                        <TextBlock Text="ms" Width="24" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                        <Button Width="28" Content="+" Style="{StaticResource Player.Icon}" Command="{Binding IncreaseAudioDelayCommand}"
                                                                ToolTip="Play audio 50 ms later" AutomationProperties.Name="Increase audio delay" />
                                                        <Button Width="46" Content="Reset" Style="{StaticResource Player.Icon}" Command="{Binding ResetAudioDelayCommand}"
                                                                FontSize="11" ToolTip="Reset audio delay to zero" AutomationProperties.Name="Reset audio delay" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding AudioDelayStatus}" Style="{StaticResource Player.DelayStatus}" />
                                                    <TextBlock Text="Saved for this media item." FontSize="11" Margin="0,8,0,0" />
                                                    <StackPanel x:Name="SubtitleAppearancePanel" Margin="0,16,0,0">
                                                        <TextBlock Text="Subtitle appearance" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                        <StackPanel IsEnabled="{Binding CanStyleSubtitles}">
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Font size" VerticalAlignment="Center" />
                                                                <ComboBox x:Name="SubtitleFontSizeSelector" Grid.Column="1" Style="{StaticResource Player.Speed}"
                                                                          ItemsSource="{Binding SubtitleFontSizes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                                          SelectedValue="{Binding SubtitleFontSize, Mode=TwoWay}" AutomationProperties.Name="Subtitle font size" />
                                                            </Grid>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Text color" VerticalAlignment="Center" />
                                                                <ComboBox x:Name="SubtitleTextColorSelector" Grid.Column="1" Style="{StaticResource Player.Speed}"
                                                                          ItemsSource="{Binding SubtitleColors}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                                          SelectedValue="{Binding SubtitleTextColor, Mode=TwoWay}" AutomationProperties.Name="Subtitle text color" />
                                                            </Grid>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Outline" VerticalAlignment="Center" />
                                                                <ComboBox x:Name="SubtitleOutlineSelector" Grid.Column="1" Style="{StaticResource Player.Speed}"
                                                                          ItemsSource="{Binding SubtitleOutlines}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                                          SelectedValue="{Binding SubtitleOutlineThickness, Mode=TwoWay}" AutomationProperties.Name="Subtitle outline thickness" />
                                                            </Grid>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Outline color" VerticalAlignment="Center" />
                                                                <ComboBox x:Name="SubtitleOutlineColorSelector" Grid.Column="1" Style="{StaticResource Player.Speed}"
                                                                          ItemsSource="{Binding SubtitleColors}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                                          SelectedValue="{Binding SubtitleOutlineColor, Mode=TwoWay}" AutomationProperties.Name="Subtitle outline color" />
                                                            </Grid>
                                                            <Grid Margin="0,2,0,4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Bottom margin" VerticalAlignment="Center" />
                                                                <Slider x:Name="SubtitleMarginSlider" Grid.Column="1" Style="{StaticResource Player.Slider}" Minimum="0" Maximum="200"
                                                                        TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="20"
                                                                        Value="{Binding SubtitleBottomMargin, Mode=TwoWay}" AutomationProperties.Name="Subtitle bottom margin" />
                                                                <TextBlock Grid.Column="2" Text="{Binding SubtitleBottomMargin, StringFormat={}{0} px}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Button x:Name="ResetSubtitleAppearanceButton" Content="Reset appearance" Width="130" HorizontalAlignment="Left"
                                                                    Style="{StaticResource Player.Icon}" FontSize="12" Command="{Binding ResetSubtitleAppearanceCommand}"
                                                                    AutomationProperties.Name="Reset subtitle appearance" />
                                                        </StackPanel>
                                                        <TextBlock Text="Changes preview in this video and are saved for all videos. Styled or image subtitles may keep their own appearance."
                                                                   TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
                                                        <TextBlock Text="{Binding SubtitleAppearanceStatus}" Style="{StaticResource Player.DelayStatus}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel x:Name="SeriesTrackPreferencesPanel" Margin="0,16,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasSeriesTrackPreferencesContext}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="Series track preferences" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                        <TextBlock Text="{Binding SeriesTrackPreferenceSummary}" TextWrapping="Wrap" FontSize="11" />
                                                        <TextBlock Text="Track changes apply to this episode. Save the selected audio and subtitles to use them for other episodes."
                                                                   TextWrapping="Wrap" FontSize="11" Margin="0,6,0,8" />
                                                        <Button x:Name="SaveSeriesTrackPreferencesButton" Content="Use selected tracks for series"
                                                                Command="{Binding SaveSeriesTrackPreferencesCommand}" Style="{StaticResource Player.Icon}"
                                                                Width="Auto" Padding="8,0" HorizontalAlignment="Left"
                                                                AutomationProperties.Name="Use selected tracks for series" />
                                                        <Button x:Name="UseSeriesTrackPreferencesButton" Content="Restore series tracks for this episode"
                                                                Command="{Binding UseSeriesTrackPreferencesCommand}" Style="{StaticResource Player.Icon}"
                                                                Width="Auto" Padding="8,0" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                AutomationProperties.Name="Restore series tracks for this episode" />
                                                    </StackPanel>
                                                </StackPanel>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                        <Button x:Name="FullscreenButton" Click="OnFullscreenClick" ToolTip="Toggle fullscreen (F11); exit with Esc"
                                                AutomationProperties.Name="Toggle fullscreen">
                                            <Path Width="20" Height="20" Data="M3,8 V3 H8 M12,3 H17 V8 M17,12 V17 H12 M8,17 H3 V12"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Player.Icon}">
                                                    <Setter Property="Width" Value="32" />
                                                    <Setter Property="IsEnabled" Value="{Binding Player.IsReady}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                                            <Setter Property="IsEnabled" Value="True" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>
            </vlc:VideoView>
        </Grid>
    </Border>
</UserControl>
