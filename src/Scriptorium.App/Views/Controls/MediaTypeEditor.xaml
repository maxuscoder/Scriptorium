<UserControl
    x:Class="Scriptorium.App.Views.Controls.MediaTypeEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource Text.SubsectionTitle}" Text="Media type" />
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding MediaTypes}"
                SelectedValue="{Binding SelectedMediaType, Mode=TwoWay}"
                SelectedValuePath="Value"
                Style="{StaticResource Input.ComboBox}" />
            <Button
                Grid.Column="2"
                Command="{Binding SaveMediaTypeCommand}"
                Content="Save media type"
                Style="{StaticResource Button.Primary}" />
        </Grid>
        <TextBlock
            Margin="0,8,0,0"
            Foreground="{StaticResource Brush.TextSecondary}"
            Text="{Binding MediaTypeStatus}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
