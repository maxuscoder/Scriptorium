<UserControl
    x:Class="Scriptorium.App.Views.Controls.MediaCategoryEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource Text.SubsectionTitle}" Text="Category" />
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                DisplayMemberPath="Name"
                ItemsSource="{Binding CategoryOptions}"
                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                Style="{StaticResource Library.ComboBox}" />
            <Button
                Grid.Column="2"
                Command="{Binding SaveCategoryCommand}"
                Content="Save category"
                Style="{StaticResource Button.Primary}" />
        </Grid>
        <TextBlock
            Margin="0,8,0,0"
            Foreground="{StaticResource Brush.TextSecondary}"
            Text="{Binding CategoryStatus}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
