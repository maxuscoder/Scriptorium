                    Fill="{StaticResource Bokeh.Distant.Charcoal}" Opacity="0.080" />
                <!-- Loose overlapping groups, plus a few quiet interior bubbles. -->
                <Ellipse Width="270" Height="264"
                    Fill="{StaticResource Bokeh.Near.Amber}" Opacity="0.1394" />
