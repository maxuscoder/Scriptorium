    <Grid Background="{Binding Background, ElementName=Root}">
        <!-- One cached, dithered surface stays below the animated bubble field. -->
        <Grid x:Name="ContentBackdrop"
            RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <!-- Viewport anchors and local offsets keep the loose clusters together
             on resize without stretching circles or magnifying their drift. -->
        <Grid x:Name="BubbleField" SizeChanged="OnBubbleFieldSizeChanged">
            <Canvas x:Name="Bubbles">
                <!-- Large, diffuse background disks; some extend beyond the viewport. -->
                <Ellipse Width="650" Height="620"
                    Fill="{StaticResource Bokeh.Distant.Orange}" Opacity="0.0451" />
                <Ellipse Width="620" Height="620"
                    Fill="{StaticResource Bokeh.Distant.Charcoal}" Opacity="0.115" />
