<UserControl x:Class="Scriptorium.App.Views.Controls.AmbientBokehBackground"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    Background="{DynamicResource Brush.AmbientBase}"
    IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
    <UserControl.Resources>
        <sys:Double x:Key="Bokeh.Intensity">0.8</sys:Double>
        <!-- The center colors are baked into shared dithered bell textures in code.
             Soft alpha falloff avoids visible disks, gradient bands and live blur. -->
        <RadialGradientBrush x:Key="Bokeh.Cool" po:Freeze="True">
            <GradientStop Color="#9AA4BA" Offset="0" />
            <GradientStop Color="#009AA4BA" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="Bokeh.Graphite" po:Freeze="True">
            <GradientStop Color="#727D91" Offset="0" />
            <GradientStop Color="#00727D91" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="Bokeh.Warm" po:Freeze="True">
            <GradientStop Color="#D78C58" Offset="0" />
            <GradientStop Color="#00D78C58" Offset="1" />
        </RadialGradientBrush>
        <Style TargetType="Ellipse">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{Binding Background, ElementName=Root}">
        <!-- One cached, dithered surface stays below the animated bubble field. -->
        <Grid x:Name="ContentBackdrop"
            RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <!-- Viewport anchors and local offsets keep the loose clusters together
             on resize without stretching circles or magnifying their drift. -->
        <Grid x:Name="BubbleField" SizeChanged="OnBubbleFieldSizeChanged">
            <Canvas x:Name="Bubbles">
                <Ellipse Width="820" Height="760" Fill="{StaticResource Bokeh.Cool}" Opacity="0.24" />
                <Ellipse Width="740" Height="700" Fill="{StaticResource Bokeh.Cool}" Opacity="0.24" />
                <Ellipse Width="680" Height="640" Fill="{StaticResource Bokeh.Graphite}" Opacity="0.12" />
                <Ellipse Width="650" Height="610" Fill="{StaticResource Bokeh.Warm}" Opacity="0.18" />
                <Ellipse Width="620" Height="580" Fill="{StaticResource Bokeh.Warm}" Opacity="0.2" />
                <Ellipse Width="560" Height="500" Fill="{StaticResource Bokeh.Cool}" Opacity="0.3" />
                <Ellipse Width="360" Height="340" Fill="{StaticResource Bokeh.Graphite}" Opacity="0.1" />
                <Ellipse Width="500" Height="470" Fill="{StaticResource Bokeh.Warm}" Opacity="0.24" />
                <Ellipse Width="440" Height="410" Fill="{StaticResource Bokeh.Cool}" Opacity="0.18" />
                <Ellipse Width="330" Height="310" Fill="{StaticResource Bokeh.Graphite}" Opacity="0.14" />
                <Ellipse Width="280" Height="260" Fill="{StaticResource Bokeh.Cool}" Opacity="0.28" />
                <Ellipse Width="310" Height="290" Fill="{StaticResource Bokeh.Warm}" Opacity="0.34" />
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
