<UserControl x:Class="Scriptorium.App.Views.Controls.MediaCard" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="True" KeyboardNavigation.TabNavigation="Local"
    AutomationProperties.Name="{Binding Title, ElementName=Root}"
    PreviewKeyDown="OnCardKeyDown">
    <UserControl.Resources>
        <Style x:Key="Card.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.CardTitle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>
    <UserControl.ToolTip>
        <ToolTip DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" />
                <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" MaxWidth="{StaticResource Control.MaxWidth.ToolTip}">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                        <Style.Triggers><DataTrigger Binding="{Binding FileName}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="File unavailable" Foreground="{DynamicResource Brush.Warning}">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ToolTip>
    </UserControl.ToolTip>
    <UserControl.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}" Opened="OnMenuOpened" Closed="OnMenuClosed">
            <MenuItem Header="{Binding DisplayActionText}" Command="{Binding ActionCommand}" CommandParameter="{Binding ActionParameter}">
                <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource Menu.Item}">
                    <Style.Triggers><DataTrigger Binding="{Binding ActionCommand}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style></MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{Binding FavoriteActionText}" Command="{Binding FavoriteCommand}" CommandParameter="{Binding FavoriteParameter}">
                <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource Menu.Item}">
                    <Style.Triggers><DataTrigger Binding="{Binding FavoriteCommand}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style></MenuItem.Style>
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>
    <!-- One artwork/title template for grid and list. Only positioning changes. -->
    <Grid x:Name="CardVisual" RenderTransformOrigin="0.5,0.5" Background="Transparent">
        <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid x:Name="ArtworkFrame">
            <Grid.Style><Style TargetType="Grid">
                <Setter Property="Grid.ColumnSpan" Value="2" />
                <Style.Triggers><DataTrigger Binding="{Binding IsListLayout, ElementName=Root}" Value="True">
                    <Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Width" Value="{StaticResource MediaCard.ListArtworkWidth}" />
                </DataTrigger></Style.Triggers>
            </Style></Grid.Style>
            <Border x:Name="ArtworkShadow" CornerRadius="{StaticResource Radius.Card}" Background="{StaticResource MediaCard.Brush.Fallback}" />
            <Grid x:Name="Artwork" SizeChanged="OnArtworkSizeChanged">
                <Border Background="{StaticResource MediaCard.Brush.Fallback}" />
                <Image x:Name="ArtworkImage" Stretch="UniformToFill" Source="{Binding ThumbnailSource, ElementName=Root}" ImageFailed="OnThumbnailImageFailed"
                    Opacity="{StaticResource MediaCard.Artwork.RestOpacity}" />
                <TextBlock Text="&#xE714;" FontFamily="{StaticResource MediaCard.FontFamily.Icons}"
                    FontSize="{StaticResource Icon.Size.Feature}" Foreground="{StaticResource MediaCard.Brush.FallbackIcon}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding HasUsableThumbnail, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Border x:Name="HoverScrim" Background="{StaticResource MediaCard.Brush.HoverScrim}" Opacity="0" IsHitTestVisible="False" />
                <Grid x:Name="Actions" Margin="{StaticResource MediaCard.Actions.Margin}" Opacity="0">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="IsHitTestVisible" Value="False" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsEngaged, ElementName=Root}" Value="True"><Setter Property="IsHitTestVisible" Value="True" /></DataTrigger></Style.Triggers>
                    </Style></Grid.Style>
                    <Button x:Name="PrimaryAction" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Command="{Binding ActionCommand, ElementName=Root}" CommandParameter="{Binding ActionParameter, ElementName=Root}"
                        Content="{Binding DisplayActionText, ElementName=Root}" AutomationProperties.Name="{Binding DisplayActionText, ElementName=Root}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MediaCard.Action}">
                            <Style.Triggers><DataTrigger Binding="{Binding ActionCommand, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                        <Button x:Name="FavoriteAction" Margin="{StaticResource MediaCard.Action.Gap}"
                            Command="{Binding FavoriteCommand, ElementName=Root}" CommandParameter="{Binding FavoriteParameter, ElementName=Root}"
                            ToolTip="{Binding FavoriteActionText, ElementName=Root}" AutomationProperties.Name="{Binding FavoriteActionText, ElementName=Root}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MediaCard.IconAction}">
                                <Setter Property="Content" Value="&#xE734;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FavoriteCommand, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsFavorite, ElementName=Root}" Value="True"><Setter Property="Content" Value="&#xE735;" /><Setter Property="Foreground" Value="{StaticResource MediaCard.Brush.Progress}" /></DataTrigger>
                                </Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button x:Name="MoreAction" Content="&#xE712;" Click="OnMoreClick" ToolTip="More actions" AutomationProperties.Name="More actions">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MediaCard.IconAction}">
                                <Style.Triggers><DataTrigger Binding="{Binding HasActions, ElementName=Root}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="PlaybackProgress" VerticalAlignment="Bottom" Value="{Binding PlaybackProgressPercentage, ElementName=Root}"
                    AutomationProperties.Name="Playback progress">
                    <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource MediaCard.Progress}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding ShowPlaybackProgress, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Grid>
        <StackPanel x:Name="Copy">
            <StackPanel.Style><Style TargetType="StackPanel">
                <Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" />
                <Setter Property="Margin" Value="{StaticResource MediaCard.Copy.Margin}" />
                <Style.Triggers><DataTrigger Binding="{Binding IsListLayout, ElementName=Root}" Value="True">
                    <Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="{StaticResource MediaCard.Copy.ListMargin}" />
                </DataTrigger></Style.Triggers>
            </Style></StackPanel.Style>
            <TextBlock Text="{Binding Title, ElementName=Root}">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Card.Title}">
                    <Style.Triggers><DataTrigger Binding="{Binding HasTitleHighlight, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            <TextBlock>
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Card.Title}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding HasTitleHighlight, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
                <Run Text="{Binding TitlePrefix, ElementName=Root}" /><Run Text="{Binding TitleHighlight, ElementName=Root}" Background="{DynamicResource Brush.AccentMuted}" /><Run Text="{Binding TitleSuffix, ElementName=Root}" />
            </TextBlock>
            <TextBlock x:Name="MetadataText" Text="{Binding Metadata, ElementName=Root}" Margin="{StaticResource MediaCard.Metadata.Margin}" TextTrimming="CharacterEllipsis">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                    <Style.Triggers><DataTrigger Binding="{Binding Metadata, ElementName=Root}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
