<UserControl
    x:Class="Scriptorium.App.Views.Controls.MediaCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MediaCard.Progress" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style x:Key="MediaCard.OverlayAction" BasedOn="{StaticResource Button.Primary}" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActionCommand, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardBorder}" Value="True"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></DataTrigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MediaCard.Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="CardBorder" Cursor="Hand" SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.L}" />
                <Setter Property="Effect" Value="{StaticResource Elevation.1}" />
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="0" /></Setter.Value></Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                        <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="-3" Duration="{StaticResource Motion.Duration.Fast}" EasingFunction="{StaticResource Motion.Easing.Enter}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="{StaticResource Motion.Duration.Fast}" EasingFunction="{StaticResource Motion.Easing.Exit}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <!-- Poster-first grid card -->
            <Grid>
                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsListLayout, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.RowDefinitions><RowDefinition Height="196" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid ClipToBounds="True">
                    <Border Background="{StaticResource Brush.AccentSurface}" CornerRadius="12,12,0,0" />
                    <Image Stretch="UniformToFill" ImageFailed="OnThumbnailImageFailed" Source="{Binding ThumbnailSource, ElementName=Root}" />
                    <Border Background="#44000000" CornerRadius="12,12,0,0" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasUsableThumbnail, ElementName=Root}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Width="52" Height="52" HorizontalAlignment="Center" Background="#5533271E" CornerRadius="26"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Brush.AccentText}" Text="{Binding FallbackGlyph, ElementName=Root}" /></Border>
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" Text="Artwork unavailable" />
                    </StackPanel>
                    <Border Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC181614" CornerRadius="{StaticResource CornerRadius.S}" Padding="8,3"><TextBlock Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" FontWeight="SemiBold" Text="{Binding TypeLabel, ElementName=Root}" /></Border>
                    <Border Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#CC181614" CornerRadius="16" Padding="7,4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFavorite, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock Foreground="{StaticResource Brush.Warning}" Text="&#x2605;" />
                    </Border>
                    <ProgressBar VerticalAlignment="Bottom" Value="{Binding PlaybackProgressPercentage, ElementName=Root}"><ProgressBar.Style><Style BasedOn="{StaticResource MediaCard.Progress}" TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPlaybackProgress, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
                    <Button HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding ActionCommand, ElementName=Root}" CommandParameter="{Binding ActionParameter, ElementName=Root}" Content="{Binding ActionText, ElementName=Root}" Style="{StaticResource MediaCard.OverlayAction}" />
                </Grid>
                <StackPanel Grid.Row="1" Margin="14,12,14,14">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title, ElementName=Root}" ToolTip="{Binding Title, ElementName=Root}"><TextBlock.Style><Style BasedOn="{StaticResource MediaCard.Title}" TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasTitleHighlight, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" Foreground="{StaticResource Brush.Warning}" Text="Unavailable"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsMissing, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <TextBlock ToolTip="{Binding Title, ElementName=Root}"><TextBlock.Style><Style BasedOn="{StaticResource MediaCard.Title}" TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasTitleHighlight, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style><Run Text="{Binding TitlePrefix, ElementName=Root}" /><Run Background="{StaticResource Brush.Accent}" Text="{Binding TitleHighlight, ElementName=Root}" /><Run Text="{Binding TitleSuffix, ElementName=Root}" /></TextBlock>
                    </Grid>
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding PrimaryMetadata, ElementName=Root}" TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="{Binding CategoryBrush, ElementName=Root}" CornerRadius="{StaticResource CornerRadius.S}" Padding="7,2"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasCategory, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock FontSize="12" Foreground="{StaticResource Brush.TextPrimary}" Text="{Binding CategoryName, ElementName=Root}" /></Border>
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding SecondaryMetadata, ElementName=Root}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Text="{Binding PlaybackProgressText, ElementName=Root}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPlaybackProgress, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
            </Grid>

            <!-- Compact, intentionally different list row -->
            <Grid>
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsListLayout, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="176" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Margin="10" Height="98" ClipToBounds="True"><Border Background="{StaticResource Brush.AccentSurface}" CornerRadius="{StaticResource CornerRadius.M}" /><Image Stretch="UniformToFill" ImageFailed="OnThumbnailImageFailed" Source="{Binding ThumbnailSource, ElementName=Root}" /><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasUsableThumbnail, ElementName=Root}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock HorizontalAlignment="Center" FontSize="24" Foreground="{StaticResource Brush.AccentText}" Text="{Binding FallbackGlyph, ElementName=Root}" /><TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Text="Artwork unavailable" /></StackPanel><ProgressBar VerticalAlignment="Bottom" Value="{Binding PlaybackProgressPercentage, ElementName=Root}"><ProgressBar.Style><Style BasedOn="{StaticResource MediaCard.Progress}" TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPlaybackProgress, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar></Grid>
                <StackPanel Grid.Column="1" Margin="4,16,16,16" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Foreground="{StaticResource Brush.AccentText}" FontSize="12" FontWeight="SemiBold" Text="{Binding TypeLabel, ElementName=Root}" /><TextBlock Margin="8,0,0,0" Foreground="{StaticResource Brush.Warning}" FontSize="12" Text="Unavailable"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsMissing, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><TextBlock Margin="0,4,0,0" Style="{StaticResource MediaCard.Title}" Text="{Binding Title, ElementName=Root}" ToolTip="{Binding Title, ElementName=Root}" /><TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding PrimaryMetadata, ElementName=Root}" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Column="2" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding SecondaryMetadata, ElementName=Root}" /><TextBlock Margin="0,5,0,0" HorizontalAlignment="Right" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Text="{Binding PlaybackProgressText, ElementName=Root}" /><Button Margin="0,10,0,0" Command="{Binding ActionCommand, ElementName=Root}" CommandParameter="{Binding ActionParameter, ElementName=Root}" Content="{Binding ActionText, ElementName=Root}" Style="{StaticResource Button.Secondary}" /></StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
