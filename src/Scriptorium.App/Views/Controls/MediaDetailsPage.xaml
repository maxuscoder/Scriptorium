<UserControl
    x:Class="Scriptorium.App.Views.Controls.MediaDetailsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Scriptorium.App.Behaviors">
    <UserControl.Resources>
        <ControlTemplate x:Key="Details.VideoScrollTemplate" TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource ScrollBar.Gutter}" />
                </Grid.ColumnDefinitions>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.ColumnSpan="2" Margin="{TemplateBinding Padding}"
                                        Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                        CanContentScroll="{TemplateBinding CanContentScroll}" />
                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                           Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
        </ControlTemplate>
        <Style x:Key="Details.Secondary" BasedOn="{StaticResource Button.Secondary}" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Command, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Details.Quiet" BasedOn="{StaticResource Button.Text}" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <DataTemplate x:Key="Details.Value">
            <StackPanel Margin="0,0,24,18" MinWidth="140">
                <TextBlock Style="{StaticResource Text.Metadata}" Text="{Binding Label}" />
                <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextPrimary}"
                           Text="{Binding Value}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainColumn" Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- Opacity masks cannot composite the player's native HWND and foreground window. -->
        <ScrollViewer x:Name="MainContent" behaviors:VerticalScrollFade.Height="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnContentSizeChanged">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer.MainContent}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVideoLayout, ElementName=Root}" Value="True">
                            <Setter Property="Template" Value="{StaticResource Details.VideoScrollTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="24,14,24,32" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVideoLayout, ElementName=Root}" Value="True">
                                <Setter Property="Margin" Value="0,0,0,32" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentPresenter Content="{Binding VideoContent, ElementName=Root}" />
                <Border x:Name="DetailsActions" Grid.Row="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Surface}">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,0,0,14" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVideoLayout, ElementName=Root}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="CornerRadius" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="24,24,24,20" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowHeader, ElementName=Root}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding BackCommand, ElementName=Root}" Content="&#x2190; Library"
                                Padding="8,4" BorderThickness="0" AutomationProperties.Name="Back to Library">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Text}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVideoLayout, ElementName=Root}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title, ElementName=Root}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="Text" Value="{Binding Title, ElementName=Root, StringFormat=/ {0}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVideoLayout, ElementName=Root}" Value="True">
                                            <Setter Property="Text" Value="{Binding Title, ElementName=Root}" />
                                            <Setter Property="FontSize" Value="26" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="HeaderProgress" Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center"
                                   Text="{Binding HeaderProgressText, ElementName=Root}">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsVideoLayout, ElementName=Root}" Value="True"><Setter Property="FontSize" Value="16" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center" Content="{Binding HeaderActionsContent, ElementName=Root}" />
                            <Button x:Name="ShowSidebarButton" Style="{StaticResource Button.Icon}"
                                    Click="OnToggleSidebar" Visibility="Collapsed" ToolTip="Show contents" AutomationProperties.Name="Show contents"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" /></Button>
                            <Button Command="{Binding EditCommand, ElementName=Root}"
                                    ToolTip="Edit metadata" AutomationProperties.Name="Edit metadata">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                        <Style.Triggers><DataTrigger Binding="{Binding EditCommand, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" />
                            </Button>
                            <Button Click="OnMoreActions"
                                    ToolTip="More actions" AutomationProperties.Name="More actions">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                        <Style.Triggers><DataTrigger Binding="{Binding ActionsMenu, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVideoLayout, ElementName=Root}" Value="True">
                                    <Setter Property="Margin" Value="24,0,24,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ContentColumn" Width="*" /><ColumnDefinition x:Name="SidebarColumn" Width="0" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MainDetailsContent, ElementName=Root}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="PreviewHost" Grid.Row="0" SizeChanged="OnPreviewSizeChanged">
                                <ContentPresenter Content="{Binding PreviewContent, ElementName=Root}" />
                                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreviewContent, ElementName=Root}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Image Stretch="Uniform" ImageFailed="OnThumbnailImageFailed" Source="{Binding ThumbnailSource, ElementName=Root}" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUsableThumbnail, ElementName=Root}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.ArtworkGlyph.Large}"
                                                       Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding FallbackGlyph, ElementName=Root}" />
                                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Helper}" Text="No image available" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                                <TextBlock Style="{StaticResource Text.PageTitle}" Text="{Binding Title, ElementName=Root}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding TypeLabel, ElementName=Root}" />
                                    <TextBlock Margin="8,0,8,0" Style="{StaticResource Text.Metadata}" Text="&#x2022;" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding HeaderMetadata, ElementName=Root}" />
                                </WrapPanel>
                                <TextBlock Margin="0,6,0,0" Text="Edited metadata">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource Text.Metadata}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasManualMetadata, ElementName=Root}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,8,0,0" Text="{Binding Status, ElementName=Root}">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource Text.Metadata}" TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Available"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Body}" Text="{Binding Description, ElementName=Root}" />
                                <WrapPanel Margin="0,18,0,0">
                                    <Button Margin="0,0,8,8" Command="{Binding PrimaryActionCommand, ElementName=Root}" Content="{Binding PrimaryActionText, ElementName=Root}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource Button.Primary}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PrimaryActionCommand, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Margin="0,0,8,8" Command="{Binding TertiaryActionCommand, ElementName=Root}" Content="{Binding TertiaryActionText, ElementName=Root}" Style="{StaticResource Details.Secondary}" />
                                    <Button Margin="0,0,8,8" Command="{Binding SecondaryActionCommand, ElementName=Root}" Content="{Binding SecondaryActionText, ElementName=Root}" Style="{StaticResource Details.Secondary}" />
                                    <Button Margin="0,0,0,8" Command="{Binding EditCommand, ElementName=Root}" Content="Edit" Style="{StaticResource Details.Secondary}" />
                                </WrapPanel>
                            </StackPanel>
                            <ContentPresenter Grid.Row="2" Margin="0,12,0,0" Content="{Binding ProgressContent, ElementName=Root}" />
                            <StackPanel Grid.Row="3" Margin="0,24,0,0">
                                <TextBlock Style="{StaticResource Text.SubsectionTitle}" Text="Details" />
                                <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding MetadataItems, ElementName=Root}" SizeChanged="OnMetadataSizeChanged">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Details.Value}" Width="{Binding MetadataColumnWidth, ElementName=Root}">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Label}" Value="File path"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Label}" Value="Playback"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource Text.SubsectionTitle}" Text="File" />
                                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding FileMetadataItems, ElementName=Root}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.Metadata}" Text="{Binding Label}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Value}" TextWrapping="Wrap" ToolTip="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ContentPresenter Grid.Row="5" Content="{Binding ExtensionContent, ElementName=Root}" />
                        </Grid>
                        <ContentPresenter Content="{Binding MainDetailsContent, ElementName=Root}" />
                    </Grid>
                    <Border x:Name="SidebarPanel" Grid.Column="1" Style="{StaticResource Surface}" Padding="10" VerticalAlignment="Top" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="4,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.SubsectionTitle}" Text="{Binding SidebarTitle, ElementName=Root}" />
                                <Button Grid.Column="1" Style="{StaticResource Button.Icon}"
                                        Click="OnToggleSidebar" ToolTip="Hide contents" AutomationProperties.Name="Hide contents"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE89F;" /></Button>
                            </Grid>
                            <ScrollViewer x:Name="SidebarScroll" Grid.Row="1" Style="{StaticResource ScrollViewer.MainContent}"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ContentPresenter Content="{Binding SidebarContent, ElementName=Root}" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
        <Border x:Name="EditorPanel" Grid.Column="1" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <ContentPresenter Content="{Binding EditorContent, ElementName=Root}" />
        </Border>
    </Grid>
</UserControl>
