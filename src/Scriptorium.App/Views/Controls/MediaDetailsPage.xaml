<UserControl
    x:Class="Scriptorium.App.Views.Controls.MediaDetailsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Details.Secondary" BasedOn="{StaticResource Button.Secondary}" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Command, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Details.Quiet" BasedOn="{StaticResource Button.Text}" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <DataTemplate x:Key="Details.Value">
            <StackPanel Margin="0,0,24,18" MinWidth="140">
                <TextBlock Style="{StaticResource Text.Metadata}" Text="{Binding Label}" />
                <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextPrimary}"
                           Text="{Binding Value}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Brush.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainColumn" Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="MainContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,14,24,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button HorizontalAlignment="Left" Margin="0,0,0,14" Command="{Binding BackCommand, ElementName=Root}"
                        Content="&#x2190; Back to Library" Style="{StaticResource Details.Quiet}" />
                <Grid x:Name="PreviewHost" Grid.Row="1" SizeChanged="OnPreviewSizeChanged">
                    <ContentPresenter Content="{Binding PreviewContent, ElementName=Root}" />
                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewContent, ElementName=Root}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Image Stretch="Uniform" ImageFailed="OnThumbnailImageFailed" Source="{Binding ThumbnailSource, ElementName=Root}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUsableThumbnail, ElementName=Root}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.ArtworkGlyph.Large}"
                                           Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding FallbackGlyph, ElementName=Root}" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Helper}" Text="No image available" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,22,0,0">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="{Binding Title, ElementName=Root}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding TypeLabel, ElementName=Root}" />
                        <TextBlock Margin="8,0,8,0" Style="{StaticResource Text.Metadata}" Text="&#x2022;" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding HeaderMetadata, ElementName=Root}" />
                    </WrapPanel>
                    <TextBlock Margin="0,6,0,0" Text="Edited metadata">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource Text.Metadata}" TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasManualMetadata, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" Text="{Binding Status, ElementName=Root}">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource Text.Metadata}" TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Available"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Body}" Text="{Binding Description, ElementName=Root}" />
                    <WrapPanel Margin="0,18,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding PrimaryActionCommand, ElementName=Root}" Content="{Binding PrimaryActionText, ElementName=Root}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource Button.Primary}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrimaryActionCommand, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Margin="0,0,8,8" Command="{Binding TertiaryActionCommand, ElementName=Root}" Content="{Binding TertiaryActionText, ElementName=Root}" Style="{StaticResource Details.Secondary}" />
                        <Button Margin="0,0,8,8" Command="{Binding SecondaryActionCommand, ElementName=Root}" Content="{Binding SecondaryActionText, ElementName=Root}" Style="{StaticResource Details.Secondary}" />
                        <Button Margin="0,0,0,8" Command="{Binding EditCommand, ElementName=Root}" Content="Edit" Style="{StaticResource Details.Secondary}" />
                    </WrapPanel>
                </StackPanel>
                <ContentPresenter Grid.Row="3" Margin="0,12,0,0" Content="{Binding ProgressContent, ElementName=Root}" />
                <StackPanel Grid.Row="4" Margin="0,24,0,0">
                    <TextBlock Style="{StaticResource Text.SubsectionTitle}" Text="Details" />
                    <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding MetadataItems, ElementName=Root}" SizeChanged="OnMetadataSizeChanged">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Details.Value}" Width="{Binding MetadataColumnWidth, ElementName=Root}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Label}" Value="File path"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Label}" Value="Playback"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Row="5" Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Text.SubsectionTitle}" Text="File" />
                    <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding FileMetadataItems, ElementName=Root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Metadata}" Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Value}" TextWrapping="Wrap" ToolTip="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ContentPresenter Grid.Row="6" Content="{Binding ExtensionContent, ElementName=Root}" />
            </Grid>
        </ScrollViewer>
        <Border x:Name="EditorPanel" Grid.Column="1" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <ContentPresenter Content="{Binding EditorContent, ElementName=Root}" />
        </Border>
    </Grid>
</UserControl>
