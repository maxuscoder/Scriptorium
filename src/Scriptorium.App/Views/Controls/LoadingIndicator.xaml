<UserControl
    x:Class="Scriptorium.App.Views.Controls.LoadingIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    Background="Transparent"
    AutomationProperties.Name="{Binding Message, ElementName=Root}"
    IsHitTestVisible="False">
    <StackPanel>
        <Grid Height="48" Margin="12,0">
            <Viewbox Width="{Binding ProgressWidth, ElementName=Root}" MaxWidth="440"
                     Height="20" Stretch="Fill"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="440" Height="20" ClipToBounds="True">
                    <Rectangle Canvas.Top="9" Width="440" Height="2" RadiusX="1" RadiusY="1"
                               Fill="{DynamicResource Brush.Accent}" Opacity="0.09" />
                    <Rectangle x:Name="Comet" Canvas.Top="9" Width="154" Height="2" RadiusX="1" RadiusY="1"
                               Fill="{DynamicResource Brush.Accent}">
                        <Rectangle.Effect>
                            <DropShadowEffect Color="{DynamicResource Color.Accent}" BlurRadius="8"
                                              ShadowDepth="0" Opacity="0.5" RenderingBias="Performance" />
                        </Rectangle.Effect>
                        <Rectangle.RenderTransform><TranslateTransform X="143" /></Rectangle.RenderTransform>
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#70FFFFFF" Offset="0.65" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.96" />
                                <GradientStop Color="#FFFFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Canvas>
            </Viewbox>
        </Grid>
        <StackPanel Visibility="{Binding ShowText, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource Text.Label}"
                Foreground="{DynamicResource Brush.TextPrimary}"
                Text="{Binding Message, ElementName=Root}" />
            <TextBlock
                Margin="0,3,0,0"
                Text="{Binding Detail, ElementName=Root}"
                TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource Text.Metadata}" TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Detail, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Detail, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </StackPanel>
</UserControl>
