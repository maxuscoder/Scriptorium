<UserControl
    x:Class="Scriptorium.App.Views.Controls.LoadingIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">
    <StackPanel>
        <ProgressBar
            Height="4"
            IsIndeterminate="{Binding IsIndeterminate, ElementName=Root}"
            Background="{StaticResource Brush.Border}"
            Foreground="{StaticResource Brush.Accent}"
            Width="{Binding ProgressWidth, ElementName=Root}" />
        <TextBlock
            Margin="0,8,0,0"
            Style="{StaticResource Text.Label}"
            Foreground="{StaticResource Brush.TextPrimary}"
            Text="{Binding Message, ElementName=Root}" />
        <TextBlock
            Margin="0,3,0,0"
            Text="{Binding Detail, ElementName=Root}"
            TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource Text.Metadata}" TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Detail, ElementName=Root}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Detail, ElementName=Root}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
