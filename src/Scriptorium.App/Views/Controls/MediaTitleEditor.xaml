<UserControl
    x:Class="Scriptorium.App.Views.Controls.MediaTitleEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource Text.SubsectionTitle}" Text="Title" />
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                MaxLength="200"
                Style="{StaticResource Input.TextBox}"
                Text="{Binding EditableTitle, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="2"
                Command="{Binding SaveTitleCommand}"
                Content="Save title"
                Style="{StaticResource Button.Primary}" />
        </Grid>
        <TextBlock
            Margin="0,8,0,0"
            Foreground="{StaticResource Brush.TextSecondary}"
            Text="{Binding TitleStatus}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
