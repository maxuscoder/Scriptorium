<UserControl x:Class="Scriptorium.App.Views.Controls.MediaDetailsEditor" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}">
            <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource Input.ComboBox}">
            <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="8,4" />
            <Setter Property="MaxWidth" Value="Infinity" />
        </Style>
        <Style x:Key="Editor.Quiet" TargetType="Button" BasedOn="{StaticResource Button.Text}">
            <Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="26" /><Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="Editor.Status" TargetType="TextBlock" BasedOn="{StaticResource Text.Helper}">
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Editor.EpisodeFields">
                <StackPanel Margin="0,14,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding RestoreSeasonNumberCommand}" Content="Restore detected" Style="{StaticResource Editor.Quiet}" AutomationProperties.Name="Restore detected season number" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Season number" />
                    </DockPanel>
                    <TextBox Margin="0,6,0,0" MaxLength="10" Text="{Binding EditableSeasonNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Season number" />
                    <TextBlock Style="{StaticResource Editor.Status}" Text="{Binding SeasonNumberStatus}" />
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding RestoreEpisodeNumberCommand}" Content="Restore detected" Style="{StaticResource Editor.Quiet}" AutomationProperties.Name="Restore detected episode number" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Episode number" />
                    </DockPanel>
                    <TextBox Margin="0,6,0,0" MaxLength="10" Text="{Binding EditableEpisodeNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Episode number" />
                    <TextBlock Style="{StaticResource Editor.Status}" Text="{Binding EpisodeNumberStatus}" />
                </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="22,22,22,18" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Style="{StaticResource Text.PanelTitle}" Text="Edit media" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}" Text="Make it yours." />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,18" IsEnabled="{Binding CanEditFields}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding RestoreThumbnailCommand}" Content="Restore detected" Style="{StaticResource Editor.Quiet}" AutomationProperties.Name="Restore detected thumbnail" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Thumbnail" />
                    </DockPanel>
                    <controls:CategoryArtworkPreview Height="100" Margin="0,8,0,8" ThumbnailPath="{Binding EditableThumbnailPath}" />
                    <TextBox MaxLength="1000" Text="{Binding EditableThumbnailPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Thumbnail path" />
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding ChooseThumbnailCommand}" Content="Choose image" Style="{StaticResource Button.Secondary}" BorderThickness="0" />
                    <TextBlock Style="{StaticResource Editor.Status}" Text="{Binding ThumbnailStatus}" />
                </StackPanel>

<StackPanel Margin="0,14,0,0">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding RestoreMediaTypeCommand}" Content="Restore detected" Style="{StaticResource Editor.Quiet}" AutomationProperties.Name="Restore detected media type" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Media type" />
                        </DockPanel>
                        <ComboBox ItemsSource="{Binding MediaTypes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding SelectedMediaType, Mode=TwoWay}" AutomationProperties.Name="Media type" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Editor.Status}" Text="{Binding MediaTypeStatus}" />
                    </StackPanel>
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowEpisodeFields, ElementName=Root}" Value="True">
                                    <Setter Property="Content" Value="{Binding}" />
                                    <Setter Property="ContentTemplate" Value="{StaticResource Editor.EpisodeFields}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
<StackPanel Margin="0,14,0,0">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding RestoreTitleCommand}" Content="Restore detected" Style="{StaticResource Editor.Quiet}" AutomationProperties.Name="Restore detected title" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Title" />
                        </DockPanel>
                        <TextBox MaxLength="200" Text="{Binding EditableTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Title" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Editor.Status}" Text="{Binding TitleStatus}" />
                    </StackPanel>
<StackPanel Margin="0,14,0,0">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding RestoreDescriptionCommand}" Content="Restore detected" Style="{StaticResource Editor.Quiet}" AutomationProperties.Name="Restore detected description" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Description" />
                        </DockPanel>
                        <TextBox MinHeight="84" MaxHeight="160" VerticalContentAlignment="Top" MaxLength="5000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding EditableDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Editor.Status}" Text="{Binding DescriptionStatus}" />
                    </StackPanel>
<StackPanel Margin="0,14,0,0">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding RestoreReleaseYearCommand}" Content="Restore detected" Style="{StaticResource Editor.Quiet}" AutomationProperties.Name="Restore detected release year" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Release year" />
                        </DockPanel>
                        <TextBox MaxLength="4" Text="{Binding EditableReleaseYear, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Release year" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Editor.Status}" Text="{Binding ReleaseYearStatus}" />
                    </StackPanel>
<StackPanel Margin="0,14,0,0">
                        <DockPanel LastChildFill="True">
                            
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Category" />
                        </DockPanel>
                        <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" AutomationProperties.Name="Category" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Editor.Status}" Text="{Binding CategoryStatus}" />
                    </StackPanel>
                <Button Margin="0,20,0,0" HorizontalAlignment="Left" Command="{Binding ResetMetadataCommand}" Content="Reset metadata" Style="{StaticResource Editor.Quiet}" />
                <TextBlock Style="{StaticResource Editor.Status}" Text="{Binding MetadataResetStatus}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.Body}" Text="{Binding EditStatus}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="Saving changes..." Margin="0,0,0,8" >
                <TextBlock.Style><Style BasedOn="{StaticResource Text.Metadata}" TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsSavingChanges}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            <WrapPanel>
                <Button Margin="0,0,8,0" Command="{Binding SaveChangesCommand}" Content="Save changes" Style="{StaticResource Button.Secondary}" BorderThickness="0" />
                <Button Command="{Binding CancelEditCommand}" Content="Cancel" Style="{StaticResource Button.Text}" BorderThickness="0" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
