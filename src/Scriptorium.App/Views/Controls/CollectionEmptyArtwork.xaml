<UserControl x:Class="Scriptorium.App.Views.Controls.CollectionEmptyArtwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root" Width="224" Height="156" IsHitTestVisible="False" Focusable="False">
    <UserControl.Resources>
        <Style x:Key="Artwork.Card" TargetType="Border">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="108" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Brush.Card.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlSurface.Selected}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border Style="{StaticResource Artwork.Card}" Margin="-94,0,0,12" Opacity="0.65">
            <Border.RenderTransform><RotateTransform Angle="-16" /></Border.RenderTransform>
            <StackPanel Margin="12,16">
                <Border Height="46" CornerRadius="4" Background="{DynamicResource Brush.SurfaceOverlay}" />
                <Border Height="4" Margin="0,10,8,0" CornerRadius="2" Background="{DynamicResource Brush.ControlSurface.Selected}" />
                <Border Height="4" Margin="0,6,24,0" CornerRadius="2" Background="{DynamicResource Brush.ControlSurface.Selected}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Artwork.Card}" Margin="94,0,0,12" Opacity="0.65">
            <Border.RenderTransform><RotateTransform Angle="16" /></Border.RenderTransform>
            <StackPanel Margin="12,16">
                <Border Height="46" CornerRadius="4" Background="{DynamicResource Brush.SurfaceOverlay}" />
                <Border Height="4" Margin="0,10,8,0" CornerRadius="2" Background="{DynamicResource Brush.ControlSurface.Selected}" />
                <Border Height="4" Margin="0,6,24,0" CornerRadius="2" Background="{DynamicResource Brush.ControlSurface.Selected}" />
            </StackPanel>
        </Border>
        <Border Width="112" Height="120" Margin="0,8,0,0" CornerRadius="14"
                Background="{DynamicResource Brush.ControlSurface}" BorderBrush="{DynamicResource Brush.ControlSurface.Selected}" BorderThickness="1">
            <Grid>
                <Path x:Name="Star" Width="46" Height="46" Stretch="Uniform" Margin="0,0,0,6"
                      Data="M24,3 L30.5,16.2 45,18.3 34.5,28.5 37,43 24,36.2 11,43 13.5,28.5 3,18.3 17.5,16.2 Z"
                      Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2" StrokeLineJoin="Round" Fill="{DynamicResource Brush.AccentMuted}">
                    <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsCategory, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Path.Style>
                </Path>
                <Path x:Name="Folder" Width="52" Height="44" Stretch="Uniform" Margin="0,0,0,6"
                      Data="M4,10 Q4,6 8,6 H20 L26,13 H47 Q51,13 51,17 V39 Q51,43 47,43 H8 Q4,43 4,39 Z M4,17 H51"
                      Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2" StrokeLineJoin="Round" Fill="{DynamicResource Brush.AccentMuted}">
                    <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsCategory, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Path.Style>
                </Path>
                <Border Width="32" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,18" Background="{DynamicResource Brush.TextMuted}" Opacity="0.4" />
            </Grid>
        </Border>
        <Border Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,42,12"
                CornerRadius="10" Background="{DynamicResource Brush.Accent}" BorderThickness="0">
            <Path Width="10" Height="10" Stretch="Uniform" Data="M5,0 V10 M0,5 H10" Stroke="{DynamicResource Brush.PrimaryButton.Text}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Border>
        <Ellipse Width="4" Height="4" Fill="{DynamicResource Brush.Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="38,10,0,0" Opacity="0.7" />
        <Ellipse Width="3" Height="3" Fill="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,27,0" />
    </Grid>
</UserControl>
