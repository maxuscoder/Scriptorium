<UserControl
    x:Class="Scriptorium.App.Views.Controls.MediaMetadataResetEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource Text.SubsectionTitle}" Text="Detected metadata" />
        <TextBlock
            Margin="0,8,0,0"
            Foreground="{StaticResource Brush.TextMuted}"
            Text="Discard manual title, type, grouping, and thumbnail changes." />
        <Button
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            Command="{Binding ResetMetadataCommand}"
            Content="Reset metadata"
            Style="{StaticResource Button.Secondary}" />
        <TextBlock
            Margin="0,8,0,0"
            Foreground="{StaticResource Brush.TextSecondary}"
            Text="{Binding MetadataResetStatus}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
