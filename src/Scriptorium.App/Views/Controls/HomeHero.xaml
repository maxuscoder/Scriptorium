<UserControl x:Class="Scriptorium.App.Views.Controls.HomeHero" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Scriptorium.App.Behaviors"
    Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="Hero.Copy" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Style.Triggers><DataTrigger Binding="{Binding HasBackdrop, ElementName=Root}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Home.Hero.TextSecondary}" />
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="Hero.Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>
        <LinearGradientBrush x:Key="Hero.ActionFill" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="{DynamicResource Color.PrimaryButton.NormalHighlight}" Offset="0" />
            <GradientStop Color="{DynamicResource Color.PrimaryButton.NormalMid}" Offset="0.45" />
            <GradientStop Color="{DynamicResource Color.PrimaryButton.NormalBase}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Hero.ActionHoverFill" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="{DynamicResource Color.PrimaryButton.HoverHighlight}" Offset="0" />
            <GradientStop Color="{DynamicResource Color.PrimaryButton.HoverMid}" Offset="0.45" />
            <GradientStop Color="{DynamicResource Color.PrimaryButton.HoverBase}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Hero.DetailsFill" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#EE27272B" Offset="0" />
            <GradientStop Color="#EE202024" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="Hero.Progress" TargetType="ProgressBar" BasedOn="{StaticResource MediaCard.Progress}">
            <Setter Property="Height" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Background" Value="#FF2C2F35" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border Height="6" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Height="6" VerticalAlignment="Center" Background="{TemplateBinding Foreground}" CornerRadius="3" />
                                <Ellipse x:Name="ProgressMarker" Width="12" Height="12" HorizontalAlignment="Right"
                                         Fill="White" Stroke="{TemplateBinding Foreground}" StrokeThickness="2.5">
                                    <Ellipse.RenderTransform><TranslateTransform X="6" /></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hero.ActionPrimary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Width" Value="171" />
            <Setter Property="Height" Value="39" />
            <Setter Property="MinHeight" Value="39" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Hero.ActionFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" Background="{DynamicResource Brush.Accent}" CornerRadius="12" IsHitTestVisible="False">
                                <Border.Effect><DropShadowEffect Color="{DynamicResource Color.Accent}" BlurRadius="30" ShadowDepth="6" Opacity="0.4" /></Border.Effect>
                            </Border>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    behaviors:BrushTransition.Target="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                    behaviors:BrushTransition.Duration="{StaticResource Motion.Duration.Standard}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Hero.ActionHoverFill}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
                                <Setter TargetName="Glow" Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Glow" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hero.ActionSecondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="37" />
            <Setter Property="MinHeight" Value="37" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="{StaticResource Hero.DetailsFill}" />
            <Setter Property="BorderBrush" Value="#FF48484D" />
            <Setter Property="Foreground" Value="#FFE3E3E6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                behaviors:BrushTransition.Target="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                behaviors:BrushTransition.Duration="{StaticResource Motion.Duration.Standard}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF303034" />
                    <Setter Property="BorderBrush" Value="#FF606066" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Hero.Icon" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.ArtworkScrim}" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid ClipToBounds="True">
                            <Grid.Clip>
                                <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18" />
                            </Grid.Clip>
                            <Ellipse x:Name="Backdrop" Opacity="0.8">
                                <Ellipse.Fill>
                                    <VisualBrush Visual="{Binding ElementName=ArtworkLayer}"
                                                 ViewboxUnits="Absolute" Viewbox="0,0,36,36" Stretch="Fill" />
                                </Ellipse.Fill>
                                <Ellipse.Effect><BlurEffect Radius="8" RenderingBias="Performance" /></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Surface" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Fill" Value="#48000000" />
                                <Setter TargetName="Surface" Property="Stroke" Value="#66FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Fill" Value="{DynamicResource Brush.SurfacePressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Stroke" Value="{DynamicResource Brush.FocusRing}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding HasArtwork, ElementName=Root}" Value="False">
                                <Setter TargetName="Backdrop" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Frame" SizeChanged="OnFrameSizeChanged" Background="{DynamicResource Brush.SurfaceHeader}">
        <Grid.Style><Style TargetType="Grid">
            <Style.Triggers><DataTrigger Binding="{Binding HasBackdrop, ElementName=Root}" Value="True">
                <Setter Property="MinHeight" Value="{DynamicResource Home.Hero.Height}" />
            </DataTrigger></Style.Triggers>
        </Style></Grid.Style>
        <Grid x:Name="Overlay">
            <Grid x:Name="ArtworkLayer">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding HasBackdrop, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Grid.Style>
                <!-- An ImageBrush does not let the image's natural aspect ratio enlarge the hero. -->
                <Border x:Name="ThumbnailBackdrop">
                    <Border.Style><Style TargetType="Border">
                        <Style.Triggers><DataTrigger Binding="{Binding Preview.HasPreview, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style></Border.Style>
                    <Border.Background><ImageBrush ImageSource="{Binding Artwork, ElementName=Root}" Stretch="UniformToFill" AlignmentX="Right" /></Border.Background>
                </Border>
                <Border Background="{StaticResource Home.Hero.Shade}" />
                <Border Background="{StaticResource Home.Hero.Fade}" />
            </Grid>
            <Grid Margin="{StaticResource Home.Hero.Padding}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel MaxWidth="{StaticResource Home.Hero.TextWidth}" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Eyebrow, ElementName=Root}" Style="{StaticResource Hero.Eyebrow}" />
                    <TextBlock Text="{Binding HeroTitle, ElementName=Root}" TextWrapping="Wrap" Margin="{StaticResource Home.Copy.Gap}">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.PageTitle}">
                            <Style.Triggers><DataTrigger Binding="{Binding HasBackdrop, ElementName=Root}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.TextOnDark}" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding HeroMetadata, ElementName=Root}" Style="{StaticResource Hero.Copy}" Margin="{StaticResource Home.Copy.Gap}" TextWrapping="Wrap" />
                    <Grid x:Name="ProgressRow" HorizontalAlignment="Left" Margin="{StaticResource Home.Copy.Gap}">
                        <Grid.Style><Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Media.HasPlaybackProgress, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ProgressBar x:Name="Progress" Width="{StaticResource Home.Hero.ProgressWidth}" VerticalAlignment="Center"
                                     Style="{StaticResource Hero.Progress}" AutomationProperties.Name="Saved playback progress" />
                        <TextBlock x:Name="ProgressTime" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Style="{StaticResource Hero.Copy}" FontSize="10.5">
                            <Run Text="{Binding PositionText, ElementName=Root, Mode=OneWay}">
                                <Run.Style><Style TargetType="Run">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding HasBackdrop, ElementName=Root}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnDark}" />
                                    </DataTrigger></Style.Triggers>
                                </Style></Run.Style>
                            </Run>
                            <Run Text="{Binding DurationText, ElementName=Root, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="{StaticResource Home.Action.Gap}">
                        <Button x:Name="ContinueButton" Style="{StaticResource Hero.ActionPrimary}"
                            Command="{Binding OpenCommand, ElementName=Root}"
                            ToolTip="Open the player using your saved playback preferences">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13.33" Height="13.33"
                                      Margin="0,0,5.33,0" Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" />
                                <TextBlock Text="{Binding ActionText, ElementName=Root}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DetailsButton" Margin="14,0,0,0" Style="{StaticResource Hero.ActionSecondary}"
                            Command="{Binding OpenCommand, ElementName=Root}" CommandParameter="{Binding Media, ElementName=Root}"
                            ToolTip="Open details">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Margin="0,0,5.33,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform">
                                    <Path.Data>
                                        <PathGeometry FillRule="EvenOdd"
                                            Figures="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 Z M11,10 H13 V17 H11 Z M11,7 H13 V9 H11 Z" />
                                    </Path.Data>
                                </Path>
                                <TextBlock Text="Details" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="FavoriteButton" Grid.Column="1" Style="{StaticResource Hero.Icon}" VerticalAlignment="Top"
                        Command="{Binding FavoriteCommand, ElementName=Root}" CommandParameter="{Binding Media, ElementName=Root}"
                        SizeChanged="OnIconSizeChanged" ToolTip="{Binding FavoriteText, ElementName=Root}" AutomationProperties.Name="{Binding FavoriteText, ElementName=Root}">
                    <TextBlock FontFamily="{StaticResource MediaCard.FontFamily.Icons}" FontSize="18">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xEB51;" />
                            <Style.Triggers><DataTrigger Binding="{Binding Media.IsFavorite, ElementName=Root}" Value="True">
                                <Setter Property="Text" Value="&#xEB52;" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button x:Name="PausePreviewButton" Style="{StaticResource Hero.Icon}" Margin="0,0,8,0"
                            Command="{Binding Preview.TogglePlaybackCommand, ElementName=Root}" IsEnabled="{Binding Preview.HasPreview, ElementName=Root, FallbackValue=False}"
                            SizeChanged="OnIconSizeChanged" ToolTip="{Binding Preview.PlaybackActionText, ElementName=Root}" AutomationProperties.Name="{Binding Preview.PlaybackActionText, ElementName=Root}">
                        <TextBlock FontFamily="{StaticResource MediaCard.FontFamily.Icons}" FontSize="16">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE768;" />
                                <Style.Triggers><DataTrigger Binding="{Binding Preview.IsPlaying, ElementName=Root}" Value="True"><Setter Property="Text" Value="&#xE769;" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button x:Name="MutePreviewButton" Style="{StaticResource Hero.Icon}"
                            Command="{Binding Preview.ToggleMuteCommand, ElementName=Root}" IsEnabled="{Binding Preview.HasPreview, ElementName=Root, FallbackValue=False}"
                            SizeChanged="OnIconSizeChanged" ToolTip="{Binding Preview.MuteActionText, ElementName=Root}" AutomationProperties.Name="{Binding Preview.MuteActionText, ElementName=Root}">
                        <TextBlock FontFamily="{StaticResource MediaCard.FontFamily.Icons}" FontSize="16">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE74F;" />
                                <Style.Triggers><DataTrigger Binding="{Binding Preview.IsMuted, ElementName=Root}" Value="False"><Setter Property="Text" Value="&#xE767;" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
            <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}"
                    IsHitTestVisible="False" />
            <Border IsHitTestVisible="False">
                <Border.Background><DrawingBrush Stretch="Fill"><DrawingBrush.Drawing>
                    <GeometryDrawing x:Name="CornerMaskDrawing" Brush="{DynamicResource Brush.Background}" />
                </DrawingBrush.Drawing></DrawingBrush></Border.Background>
            </Border>
        </Grid>
    </Grid>
</UserControl>


