<Window
    x:Class="Scriptorium.App.Views.CreateCategoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create category"
    Width="460"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
    <Border Margin="20" Style="{StaticResource Dialog.Surface}">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.PanelTitle}" Text="Create category" />
            <TextBlock
                Margin="0,8,0,0"
                Foreground="{StaticResource Brush.TextSecondary}"
                Text="Give this category a name and choose the color used for its media label."
                TextWrapping="Wrap" />

            <TextBlock Margin="0,20,0,6" Style="{StaticResource Text.Label}" Text="Category name" />
            <TextBox
                x:Name="CategoryNameTextBox"
                Style="{StaticResource Input.TextBox}"
                TextChanged="OnInputChanged" />

            <TextBlock Margin="0,16,0,6" Style="{StaticResource Text.Label}" Text="Category color" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="ColorPreview"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="{StaticResource Brush.Accent}"
                    CornerRadius="20" />
                <TextBox
                    x:Name="CategoryColorTextBox"
                    Grid.Column="2"
                    Style="{StaticResource Input.TextBox}"
                    Text="#CC4B08"
                    TextChanged="OnInputChanged"
                    ToolTip="Hex color, for example #CC4B08" />
            </Grid>

            <TextBlock
                x:Name="ValidationMessage"
                Margin="0,12,0,0"
                Foreground="{StaticResource Brush.Danger}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Click="OnCancel"
                    Content="Cancel"
                    Style="{StaticResource Button.Secondary}" />
                <Button
                    x:Name="CreateButton"
                    Click="OnCreate"
                    Content="Create category"
                    IsEnabled="False"
                    Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
