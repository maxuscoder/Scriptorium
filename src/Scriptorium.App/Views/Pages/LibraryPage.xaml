<UserControl
    x:Class="Scriptorium.App.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <Grid>
        <StackPanel
            MaxWidth="600"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource Text.Display}"
                Text="Library" />
            <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource Text.Body}"
                Text="Choose a local folder to add its media to your library." />
            <Button
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                Command="{Binding ImportFolderCommand}"
                Content="Add library folder"
                Style="{StaticResource Button.Primary}" />
            <Button
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Command="{Binding RemoveFolderCommand}"
                Content="Remove selected folder"
                Style="{StaticResource Button.Secondary}" />
            <TextBlock
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Foreground="{StaticResource Brush.TextSecondary}"
                Text="{Binding SelectedFolderPath}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Foreground="{StaticResource Brush.TextMuted}"
                Text="{Binding StatusMessage}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ListBox
                Margin="0,24,0,0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                Foreground="{StaticResource Brush.TextPrimary}"
                ItemsSource="{Binding ConfiguredFolders}"
                SelectedItem="{Binding SelectedFolder, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Brush.TextPrimary}"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{StaticResource Brush.TextSecondary}"
                                    Text="{Binding Path}"
                                    TextWrapping="Wrap" />
                                <CheckBox
                                    Margin="0,12,0,0"
                                    Command="{Binding DataContext.SaveFolderStateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Content="Include in future scans"
                                    Foreground="{StaticResource Brush.TextSecondary}"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</UserControl>
