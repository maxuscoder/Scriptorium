<UserControl x:Class="Scriptorium.App.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:library="clr-namespace:Scriptorium.App.Views.Controls.Library"
    Loaded="OnLoaded" PreviewMouseWheel="OnPagePreviewMouseWheel" ScrollViewer.ScrollChanged="OnPageScrollChanged">
    <Grid Margin="{StaticResource Library.PageInset}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Library"/>
                <TextBlock Style="{StaticResource Text.Metadata}" Text="{Binding MediaCountText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddFolderButton" Command="{Binding FolderManagement.ImportFolderCommand}" Style="{StaticResource Library.HeaderAction}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Library.CommandIcon}" Text="&#xE710;"/><TextBlock Margin="{StaticResource Margin.IconLabel}" Text="Add folder"/></StackPanel>
                </Button>
                <Button x:Name="RescanButton" Command="{Binding RefreshLibraryCommand}" Style="{StaticResource Library.HeaderAction}" ToolTip="Rescan enabled library folders">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Library.CommandIcon}" Text="&#xE72C;"/>
                        <TextBlock Margin="{StaticResource Margin.IconLabel}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Rescan"/><Style.Triggers><DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Text" Value="Scanning…"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="ManageLibraryButton" Style="{StaticResource Button.Icon}" ToolTip="Manage Library" AutomationProperties.Name="Manage Library" Click="OnManageLibrary">
                    <TextBlock Style="{StaticResource Library.CommandIcon}" Text="&#xE712;"/>
                </Button>
            </StackPanel>
        </Grid>
        <library:LibraryToolbar Grid.Row="1" x:Name="Toolbar"/>
        <library:LibraryMediaBrowser Grid.Row="2"/>
    </Grid>
</UserControl>
