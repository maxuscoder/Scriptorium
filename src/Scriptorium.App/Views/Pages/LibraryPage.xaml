<UserControl
    x:Class="Scriptorium.App.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <Grid>
        <StackPanel
            MaxWidth="600"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource Text.Display}"
                Text="Library" />
            <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource Text.Body}"
                Text="Choose a local folder to add its media to your library." />
            <Button
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                Command="{Binding ImportFolderCommand}"
                Content="Add library folder"
                Style="{StaticResource Button.Primary}" />
            <Button
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Command="{Binding RefreshLibraryCommand}">
                <Button.Style>
                    <Style BasedOn="{StaticResource Button.Primary}" TargetType="Button">
                        <Setter Property="Content" Value="Rescan library" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                <Setter Property="Content" Value="Scanning library…" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Command="{Binding CancelScanCommand}"
                Content="Stop scan"
                Style="{StaticResource Button.Secondary}" />
            <Button
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Command="{Binding RemoveFolderCommand}"
                Content="Remove selected folder"
                Style="{StaticResource Button.Secondary}" />
            <Button
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Command="{Binding ReconnectFolderCommand}"
                Content="Reconnect selected folder"
                Style="{StaticResource Button.Secondary}" />
            <StackPanel Margin="0,16,0,0">
                <TextBlock
                    Foreground="{StaticResource Brush.TextSecondary}"
                    Text="Friendly display name (optional)" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBox
                        Width="300"
                        Style="{StaticResource Input.TextBox}"
                        Text="{Binding CustomDisplayName, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Leave blank to use the folder name." />
                    <Button
                        Margin="12,0,0,0"
                        Command="{Binding SaveDisplayNameCommand}"
                        Content="Save display name"
                        Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </StackPanel>
            <TextBlock
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Foreground="{StaticResource Brush.TextSecondary}"
                Text="{Binding SelectedFolderPath}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Foreground="{StaticResource Brush.TextMuted}"
                Text="{Binding StatusMessage}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <StackPanel Margin="0,8,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ProgressBar Height="4" IsIndeterminate="True" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource Brush.TextSecondary}"
                    Text="{Binding ScanProgressMessage}"
                    TextAlignment="Center" />
                <TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource Brush.TextMuted}"
                    Text="{Binding CurrentScanPath}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Foreground="{StaticResource Brush.TextSecondary}"
                Text="{Binding LibrarySummary}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Border Margin="0,24,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        Text="Configured folders" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{StaticResource Brush.TextSecondary}"
                        Text="Select a folder to manage it or change whether it is included in scans." />
                    <ListBox
                        Margin="0,16,0,0"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        ItemsSource="{Binding ConfiguredFolders}"
                        SelectedItem="{Binding SelectedFolder, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                Foreground="{StaticResource Brush.Accent}"
                                                Text="▣" />
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource Brush.TextPrimary}"
                                                Text="{Binding DisplayName}" />
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="{StaticResource Brush.TextSecondary}"
                                            Text="{Binding Path}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            Foreground="{StaticResource Brush.Accent}"
                                            Text="{Binding ScanStatus}" />
                                        <TextBlock
                                            Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                    <Setter Property="Text" Value="{Binding ValidationStatus}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValidForScanning}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Text" Value="{Binding ValidationWarning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <CheckBox
                                            Margin="0,12,0,0"
                                            Command="{Binding DataContext.SaveFolderStateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="Include in future scans"
                                            Foreground="{StaticResource Brush.TextSecondary}"
                                            IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
