<UserControl x:Class="Scriptorium.App.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:library="clr-namespace:Scriptorium.App.Views.Controls.Library"
    Loaded="OnLoaded" PreviewMouseWheel="OnPagePreviewMouseWheel" ScrollViewer.ScrollChanged="OnPageScrollChanged">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <library:LibraryToolbar Margin="{StaticResource Library.ToolbarInset}" x:Name="Toolbar"/>
        <library:LibraryMediaBrowser Margin="{StaticResource Library.BrowserMargin}" Grid.Row="1"/>
    </Grid>
</UserControl>
