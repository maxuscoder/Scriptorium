<UserControl
    x:Class="Scriptorium.App.Views.Pages.LibraryPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="LibraryMediaItems" TargetType="ItemsControl">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsListLayout}" Value="True">
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer
        x:Name="PageScrollViewer"
        PreviewMouseWheel="OnPagePreviewMouseWheel"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Spacing.XL}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        Text="All media" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{StaticResource Brush.TextSecondary}"
                        Text="Browse every movie, TV episode, and tutorial imported into Scriptorium." />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0" Command="{Binding SetListLayoutCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource Button.Secondary}" TargetType="Button">
                                <Setter Property="Content" Value="&#x2630; List" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListLayout}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.AccentSurface}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="0,0,16,0" Command="{Binding SetGridLayoutCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource Button.Secondary}" TargetType="Button">
                                <Setter Property="Content" Value="&#x25A1; Grid" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridLayout}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.AccentSurface}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding ImportFolderCommand}"
                        Content="Add library folder"
                        Style="{StaticResource Button.Secondary}" />
                    <Button Command="{Binding RefreshLibraryCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource Button.Primary}" TargetType="Button">
                                <Setter Property="Content" Value="Rescan library" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Content" Value="Scanning library…" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{StaticResource Brush.TextMuted}"
                    Text="{Binding MediaCountText}" />
                <Button Grid.Column="1" Command="{Binding CancelScanCommand}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource Button.Secondary}" TargetType="Button">
                            <Setter Property="Content" Value="Stop scan" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <StackPanel Margin="0,12,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ProgressBar Height="4" IsIndeterminate="True" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{StaticResource Brush.TextSecondary}"
                    Text="{Binding ScanProgressMessage}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{StaticResource Brush.TextMuted}"
                    Text="{Binding CurrentScanPath}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock
                Margin="0,12,0,0"
                Foreground="{StaticResource Brush.TextSecondary}"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />

            <StackPanel Margin="0,32,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        Text="Tutorials" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Text="{Binding TutorialCountText}" />
                </Grid>
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{StaticResource Brush.TextSecondary}"
                    Text="Your imported tutorial collections, ordered alphabetically." />
                <ItemsControl
                    Margin="0,16,0,0"
                    ItemsSource="{Binding Tutorials}"
                    Style="{StaticResource LibraryMediaItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MediaCard
                                CardWidth="285"
                                Margin="0,0,16,16"
                                ActionCommand="{Binding DataContext.OpenTutorialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ActionParameter="{Binding}"
                                ActionText="View tutorial"
                                FallbackGlyph="T"
                                PrimaryMetadata="{Binding LessonCountText}"
                                SecondaryMetadata="{Binding SourceFolder}"
                                Status="Tutorial collection"
                                IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ThumbnailPath="{Binding ThumbnailPath}"
                                Title="{Binding Title}"
                                TypeLabel="Tutorial" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        Text="TV Shows" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Text="{Binding TvShowCountText}" />
                </Grid>
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{StaticResource Brush.TextSecondary}"
                    Text="Your imported TV-show collections, ordered alphabetically." />
                <ItemsControl
                    Margin="0,16,0,0"
                    ItemsSource="{Binding TvShows}"
                    Style="{StaticResource LibraryMediaItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MediaCard
                                CardWidth="285"
                                Margin="0,0,16,16"
                                ActionCommand="{Binding DataContext.OpenTvShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ActionParameter="{Binding}"
                                ActionText="View show"
                                FallbackGlyph="TV"
                                PrimaryMetadata="{Binding CollectionInfo}"
                                SecondaryMetadata="{Binding SourceFolder}"
                                Status="TV show"
                                IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ThumbnailPath="{Binding ThumbnailPath}"
                                Title="{Binding Title}"
                                TypeLabel="TV show" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        Text="Movies" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Text="{Binding MovieCountText}" />
                </Grid>
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{StaticResource Brush.TextSecondary}"
                    Text="Your imported movies, ordered alphabetically." />
                <ItemsControl
                    Margin="0,16,0,0"
                    ItemsSource="{Binding Movies}"
                    Style="{StaticResource LibraryMediaItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MediaCard
                                CardWidth="285"
                                Margin="0,0,16,16"
                                ActionCommand="{Binding DataContext.OpenMovieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ActionParameter="{Binding}"
                                ActionText="View movie"
                                FallbackGlyph="M"
                                IsMissing="{Binding IsMissing}"
                                PrimaryMetadata="{Binding ReleaseYear}"
                                SecondaryMetadata="{Binding Runtime}"
                                Status="{Binding Availability}"
                                IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                TertiaryMetadata="{Binding SourceFolder}"
                                ThumbnailPath="{Binding ThumbnailPath}"
                                Title="{Binding Title}"
                                TypeLabel="Movie" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel
                Margin="0,48,0,0"
                HorizontalAlignment="Center"
                MaxWidth="440">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLibraryEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="42"
                    Foreground="{StaticResource Brush.Accent}"
                    Text="▤" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Display}"
                    Text="Your library is empty" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Body}"
                    Text="Add a library folder, then rescan it to bring your supported media here." />
                <Button
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Command="{Binding ImportFolderCommand}"
                    Content="Add library folder"
                    Style="{StaticResource Button.Primary}" />
            </StackPanel>

            <ItemsControl Margin="0,20,0,0" ItemsSource="{Binding MediaItems}">
                <ItemsControl.Style>
                    <Style BasedOn="{StaticResource LibraryMediaItems}" TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLibraryEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:MediaCard
                            CardWidth="245"
                            Margin="0,0,16,16"
                            FallbackGlyph="{Binding TypeGlyph}"
                            IsMissing="{Binding IsMissing}"
                            PrimaryMetadata="{Binding Detail}"
                            SecondaryMetadata="{Binding Runtime}"
                            Status="{Binding Availability}"
                            IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            TertiaryMetadata="{Binding Location}"
                            ThumbnailPath="{Binding ThumbnailPath}"
                            Title="{Binding Title}"
                            TypeLabel="{Binding MediaType}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander Margin="0,24,0,0" Foreground="{StaticResource Brush.TextPrimary}" Header="Manage library folders">
                <StackPanel Margin="0,16,0,0">
                    <ListBox
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        ItemsSource="{Binding ConfiguredFolders}"
                        SelectedItem="{Binding SelectedFolder, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding Path}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding MediaType}" />
                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.Warning}" Text="{Binding ValidationWarning}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValidForScanning}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <CheckBox
                                            Margin="0,12,0,0"
                                            Command="{Binding DataContext.SaveFolderStateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="Include in future scans"
                                            Foreground="{StaticResource Brush.TextSecondary}"
                                            IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding RemoveFolderCommand}" Content="Remove selected folder" Style="{StaticResource Button.Secondary}" />
                        <Button Margin="0,0,8,8" Command="{Binding ReconnectFolderCommand}" Content="Reconnect selected folder" Style="{StaticResource Button.Secondary}" />
                    </WrapPanel>
                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}" Text="Friendly display name (optional)" />
                    <WrapPanel Margin="0,6,0,0">
                        <TextBox Width="300" Style="{StaticResource Input.TextBox}" Text="{Binding CustomDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="12,0,0,0" Command="{Binding SaveDisplayNameCommand}" Content="Save display name" Style="{StaticResource Button.Secondary}" />
                    </WrapPanel>
                    <TextBlock Margin="0,12,0,0" Foreground="{StaticResource Brush.TextSecondary}" Text="Media type" />
                    <WrapPanel Margin="0,6,0,0">
                        <ComboBox
                            Width="300"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding MediaTypes}"
                            SelectedValue="{Binding SelectedMediaType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedValuePath="Value"
                            Style="{StaticResource Input.ComboBox}" />
                        <Button Margin="12,0,0,0" Command="{Binding ChangeMediaTypeCommand}" Content="Apply media type" Style="{StaticResource Button.Secondary}" />
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <Expander Margin="0,16,0,0" Foreground="{StaticResource Brush.TextPrimary}" Header="Organize TV-show groups">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock
                        Foreground="{StaticResource Brush.TextSecondary}"
                        Text="Correct automatically detected show groups without changing the original media files."
                        TextWrapping="Wrap" />
                    <TextBlock Margin="0,16,0,0" Foreground="{StaticResource Brush.TextSecondary}" Text="Source group" />
                    <ListBox
                        MaxHeight="140"
                        Margin="0,6,0,0"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        ItemsSource="{Binding TvShowGroups}"
                        SelectedItem="{Binding SelectedTvShowGroup, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="8,4" Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="0,12,0,0" Foreground="{StaticResource Brush.TextSecondary}" Text="Media in source group" />
                    <ListBox
                        MaxHeight="140"
                        Margin="0,6,0,0"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        ItemsSource="{Binding SelectedTvShowGroup.Media}"
                        SelectedItem="{Binding SelectedTvShowMedia, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="8,4" Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="0,12,0,0" Foreground="{StaticResource Brush.TextSecondary}" Text="Destination group" />
                    <ComboBox
                        Margin="0,6,0,0"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding TvShowGroups}"
                        SelectedItem="{Binding TargetTvShowGroup, Mode=TwoWay}"
                        Style="{StaticResource Input.ComboBox}" />
                    <TextBlock Margin="0,12,0,0" Foreground="{StaticResource Brush.TextSecondary}" Text="Group name" />
                    <TextBox
                        Margin="0,6,0,0"
                        Style="{StaticResource Input.TextBox}"
                        Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding RenameGroupCommand}" Content="Rename group" Style="{StaticResource Button.Secondary}" />
                        <Button Margin="0,0,8,8" Command="{Binding MoveMediaToGroupCommand}" Content="Move selected media" Style="{StaticResource Button.Secondary}" />
                        <Button Margin="0,0,8,8" Command="{Binding MergeGroupsCommand}" Content="Merge into destination" Style="{StaticResource Button.Secondary}" />
                        <Button Margin="0,0,8,8" Command="{Binding SplitGroupCommand}" Content="Split selected media" Style="{StaticResource Button.Secondary}" />
                    </WrapPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
