<UserControl x:Class="Scriptorium.App.Views.Pages.LibraryPage" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls" Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="Library.ComboBox" BasedOn="{StaticResource Input.ComboBox}" TargetType="ComboBox"><Setter Property="MinHeight" Value="36" /><Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}" /><Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" /><Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" /><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,8" /><Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}" /><Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="{StaticResource CornerRadius.S}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource Brush.AccentSurface}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource Brush.NavigationSelected}" /><Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter></Style>
        <Style x:Key="Library.FilterCheckBox" TargetType="CheckBox"><Setter Property="Margin" Value="0,0,12,8" /><Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" /><Setter Property="Padding" Value="4" /></Style>
        <Style x:Key="Library.FilterToggle" TargetType="ToggleButton"><Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}" /><Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" /><Setter Property="Padding" Value="12,7" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource CornerRadius.M}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.AccentSurface}" /><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.Accent}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="Library.MediaItems" TargetType="ItemsControl"><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style></Setter.Value></Setter><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsListLayout}" Value="True"><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter></DataTrigger></Style.Triggers></Style>
        <Style x:Key="Library.Section" TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasActiveFilters}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScrollViewer" PreviewMouseWheel="OnPagePreviewMouseWheel" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28,32,48" MaxWidth="1600">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.PageTitle}" Text="Library" /><Border Margin="12,0,0,0" VerticalAlignment="Center" Background="{StaticResource Brush.AccentSurface}" CornerRadius="{StaticResource CornerRadius.Pill}" Padding="9,3"><TextBlock Foreground="{StaticResource Brush.AccentText}" FontSize="12" FontWeight="SemiBold" Text="{Binding MediaCountText}" /></Border></StackPanel><TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}" Text="Your personal collection, organized for the next thing you want to watch." /></StackPanel><WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Margin="0,0,8,8" Command="{Binding ImportFolderCommand}" Content="Add folder" Style="{StaticResource Button.Secondary}" /><Button Margin="0,0,0,8" Command="{Binding RefreshLibraryCommand}"><Button.Style><Style BasedOn="{StaticResource Button.Primary}" TargetType="Button"><Setter Property="Content" Value="Rescan library" /><Style.Triggers><DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Content" Value="Scanning…" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel></Grid>
        <Border Margin="0,24,0,0" Background="{StaticResource Brush.SurfaceHeader}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.L}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Height="40" Background="{StaticResource Brush.SurfaceElevated}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.M}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" FontSize="17" Text="&#x2315;" /><TextBox Grid.Column="1" Margin="0,1,10,1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.TextPrimary}" VerticalContentAlignment="Center" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search your library" /><TextBlock Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" IsHitTestVisible="False" Text="Search titles, shows, folders…"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SearchQuery}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers><Setter Property="Visibility" Value="Collapsed" /></Style></TextBlock.Style></TextBlock></Grid></Border><ToggleButton x:Name="FiltersButton" Grid.Column="2" Content="Filters" Style="{StaticResource Library.FilterToggle}" /></Grid><WrapPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" Text="Sort" /><ComboBox Width="176" DisplayMemberPath="DisplayName" ItemsSource="{Binding SortOrders}" SelectedValue="{Binding SelectedSortOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" Style="{StaticResource Library.ComboBox}" /><Border Width="1" Height="24" Margin="12,8" Background="{StaticResource Brush.Border}" /><Button Command="{Binding SetGridLayoutCommand}" Content="&#x25A6;" ToolTip="Grid view"><Button.Style><Style BasedOn="{StaticResource Button.Secondary}" TargetType="Button"><Setter Property="MinWidth" Value="38" /><Setter Property="Padding" Value="9,6" /><Style.Triggers><DataTrigger Binding="{Binding IsGridLayout}" Value="True"><Setter Property="Background" Value="{StaticResource Brush.AccentSurface}" /><Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Margin="4,0,0,0" Command="{Binding SetListLayoutCommand}" Content="&#x2261;" ToolTip="List view"><Button.Style><Style BasedOn="{StaticResource Button.Secondary}" TargetType="Button"><Setter Property="MinWidth" Value="38" /><Setter Property="Padding" Value="9,6" /><Style.Triggers><DataTrigger Binding="{Binding IsListLayout}" Value="True"><Setter Property="Background" Value="{StaticResource Brush.AccentSurface}" /><Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel></Grid></Border>
        <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=FiltersButton}" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=FiltersButton, Mode=TwoWay}"><Border Width="520" Margin="0,8,0,0" Background="{StaticResource Brush.SurfaceElevated}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.L}" Padding="20" Effect="{StaticResource Elevation.3}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource Text.SectionTitle}" Text="Refine your library" /><Button Grid.Column="1" Command="{Binding ClearFiltersCommand}" Content="Clear all" Style="{StaticResource Button.Secondary}" /></Grid><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Text.Label}" Text="Media type" /><ItemsControl Margin="0,8,0,0" ItemsSource="{Binding MediaTypeFilters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource Library.FilterCheckBox}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Text.Label}" Text="Playback" /><ComboBox Margin="0,8,0,0" DisplayMemberPath="DisplayName" ItemsSource="{Binding PlaybackFilters}" SelectedValue="{Binding SelectedPlaybackFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" Style="{StaticResource Library.ComboBox}" /><TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Label}" Text="Completion" /><ComboBox Margin="0,8,0,0" DisplayMemberPath="DisplayName" ItemsSource="{Binding CompletionFilters}" SelectedValue="{Binding SelectedCompletionFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" Style="{StaticResource Library.ComboBox}" /><CheckBox Margin="0,14,0,0" Content="Favorites only" Foreground="{StaticResource Brush.TextPrimary}" IsChecked="{Binding ShowFavoritesOnly, Mode=TwoWay}" /></StackPanel></Grid><Border Height="1" Margin="0,14,0,14" Background="{StaticResource Brush.Border}" /><TextBlock Style="{StaticResource Text.Label}" Text="Categories" /><ItemsControl Margin="0,8,0,0" ItemsSource="{Binding CategoryFilters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource Library.FilterCheckBox}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Popup>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding ActiveBrowseDescription}" /><Button Grid.Column="1" Command="{Binding ClearFiltersCommand}" Content="Clear filters"><Button.Style><Style BasedOn="{StaticResource Button.Secondary}" TargetType="Button"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasActiveFilters}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid>
        <Border Margin="0,12,0,0" Background="{StaticResource Brush.AccentSurface}" CornerRadius="{StaticResource CornerRadius.M}" Padding="12"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" Text="{Binding ScanProgressMessage}" /><TextBlock Margin="0,3,0,0" Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding CurrentScanPath}" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding CancelScanCommand}" Content="Stop scan" Style="{StaticResource Button.Secondary}" /></Grid></Border><TextBlock Margin="0,10,0,0" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
        <StackPanel Margin="0,32,0,0" Style="{StaticResource Library.Section}"><TextBlock Style="{StaticResource Text.SectionTitle}" Text="Tutorials" /><ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Tutorials}" Style="{StaticResource Library.MediaItems}"><ItemsControl.ItemTemplate><DataTemplate><controls:MediaCard CardWidth="280" Margin="0,0,16,16" ActionCommand="{Binding DataContext.OpenTutorialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ActionParameter="{Binding}" ActionText="Open course" FallbackGlyph="T" IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" PrimaryMetadata="{Binding LessonCountText}" SecondaryMetadata="{Binding SourceFolder}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="Tutorial" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <StackPanel Margin="0,28,0,0" Style="{StaticResource Library.Section}"><TextBlock Style="{StaticResource Text.SectionTitle}" Text="TV shows" /><ItemsControl Margin="0,16,0,0" ItemsSource="{Binding TvShows}" Style="{StaticResource Library.MediaItems}"><ItemsControl.ItemTemplate><DataTemplate><controls:MediaCard CardWidth="280" Margin="0,0,16,16" ActionCommand="{Binding DataContext.OpenTvShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ActionParameter="{Binding}" ActionText="Open show" FallbackGlyph="TV" IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" PrimaryMetadata="{Binding CollectionInfo}" SecondaryMetadata="{Binding SourceFolder}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="TV show" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <StackPanel Margin="0,28,0,0" Style="{StaticResource Library.Section}"><TextBlock Style="{StaticResource Text.SectionTitle}" Text="Movies" /><ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Movies}" Style="{StaticResource Library.MediaItems}"><ItemsControl.ItemTemplate><DataTemplate><controls:MediaCard CardWidth="280" Margin="0,0,16,16" ActionCommand="{Binding DataContext.OpenMovieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ActionParameter="{Binding}" ActionText="Open movie" CategoryColor="{Binding CategoryColor}" CategoryName="{Binding CategoryName}" FallbackGlyph="M" HasPlaybackProgress="{Binding HasPlaybackProgress}" IsFavorite="{Binding IsFavorite}" IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" IsMissing="{Binding IsMissing}" PlaybackProgressPercentage="{Binding PlaybackProgressPercentage}" PlaybackProgressText="{Binding PlaybackProgressText}" PrimaryMetadata="{Binding ReleaseYear}" SecondaryMetadata="{Binding Runtime}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="Movie" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <StackPanel Margin="0,32,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasActiveFilters}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><Grid><TextBlock Style="{StaticResource Text.SectionTitle}" Text="Browse results" /><TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding MediaCountText}" /></Grid><ItemsControl Margin="0,16,0,0" ItemsSource="{Binding MediaItems}" Style="{StaticResource Library.MediaItems}"><ItemsControl.ItemTemplate><DataTemplate><controls:MediaCard CardWidth="260" Margin="0,0,16,16" CategoryColor="{Binding CategoryColor}" CategoryName="{Binding CategoryName}" FallbackGlyph="{Binding TypeGlyph}" HasPlaybackProgress="{Binding HasPlaybackProgress}" IsFavorite="{Binding IsFavorite}" IsListLayout="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" IsMissing="{Binding IsMissing}" PlaybackProgressPercentage="{Binding PlaybackProgressPercentage}" PlaybackProgressText="{Binding PlaybackProgressText}" PrimaryMetadata="{Binding Detail}" SecondaryMetadata="{Binding Runtime}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="{Binding MediaType}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <StackPanel Margin="0,56,0,0" HorizontalAlignment="Center" MaxWidth="420"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLibraryEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Style="{StaticResource Text.Display}" Text="{Binding EmptyLibraryTitle}" /><TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Body.Center}" Text="{Binding EmptyLibraryDescription}" /><Button Margin="0,22,0,0" HorizontalAlignment="Center" Command="{Binding ImportFolderCommand}" Content="Add library folder" Style="{StaticResource Button.Primary}" /></StackPanel>
        <Expander Margin="0,48,0,0" Foreground="{StaticResource Brush.TextPrimary}" Header="Library management"><StackPanel Margin="0,16,0,0"><TextBlock Style="{StaticResource Text.Body}" Text="Manage folders and fine-tune automatically detected TV-show groups." /><ListBox Margin="0,16,0,0" Background="{StaticResource Brush.Surface}" ItemsSource="{Binding ConfiguredFolders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="14" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" /><TextBlock Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" /></StackPanel><CheckBox Grid.Column="1" VerticalAlignment="Center" Command="{Binding DataContext.SaveFolderStateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Content="Include in scans" IsChecked="{Binding IsEnabled, Mode=TwoWay}" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Margin="0,12,0,0"><Button Margin="0,0,8,8" Command="{Binding RemoveFolderCommand}" Content="Remove selected folder" Style="{StaticResource Button.Secondary}" /><Button Command="{Binding ReconnectFolderCommand}" Content="Reconnect selected folder" Style="{StaticResource Button.Secondary}" /></WrapPanel><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource Input.TextBox}" Text="{Binding CustomDisplayName, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding SaveDisplayNameCommand}" Content="Save name" Style="{StaticResource Button.Secondary}" /></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox DisplayMemberPath="DisplayName" ItemsSource="{Binding MediaTypes}" SelectedValue="{Binding SelectedMediaType, Mode=TwoWay}" SelectedValuePath="Value" Style="{StaticResource Library.ComboBox}" /><Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding ChangeMediaTypeCommand}" Content="Apply type" Style="{StaticResource Button.Secondary}" /></Grid><Expander Margin="0,20,0,0" Header="Organize TV-show groups"><StackPanel Margin="0,12,0,0"><TextBlock Style="{StaticResource Text.Label}" Text="Source group" /><ListBox MaxHeight="140" Margin="0,6,0,0" ItemsSource="{Binding TvShowGroups}" SelectedItem="{Binding SelectedTvShowGroup, Mode=TwoWay}" /><TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Label}" Text="Media in source group" /><ListBox MaxHeight="140" Margin="0,6,0,0" ItemsSource="{Binding SelectedTvShowGroup.Media}" SelectedItem="{Binding SelectedTvShowMedia, Mode=TwoWay}" /><TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Label}" Text="Destination group" /><ComboBox Margin="0,6,0,0" DisplayMemberPath="DisplayName" ItemsSource="{Binding TvShowGroups}" SelectedItem="{Binding TargetTvShowGroup, Mode=TwoWay}" Style="{StaticResource Library.ComboBox}" /><TextBox Margin="0,12,0,0" Style="{StaticResource Input.TextBox}" Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" /><WrapPanel Margin="0,12,0,0"><Button Margin="0,0,8,8" Command="{Binding RenameGroupCommand}" Content="Rename group" Style="{StaticResource Button.Secondary}" /><Button Margin="0,0,8,8" Command="{Binding MoveMediaToGroupCommand}" Content="Move selected media" Style="{StaticResource Button.Secondary}" /><Button Margin="0,0,8,8" Command="{Binding MergeGroupsCommand}" Content="Merge into destination" Style="{StaticResource Button.Secondary}" /><Button Command="{Binding SplitGroupCommand}" Content="Split selected media" Style="{StaticResource Button.Secondary}" /></WrapPanel></StackPanel></Expander><Border Margin="0,20,0,0" Background="{StaticResource Brush.DangerSurface}" BorderBrush="{StaticResource Brush.Danger}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.M}" Padding="14"><Grid><StackPanel><TextBlock FontWeight="SemiBold" Text="Reset library view" /><TextBlock Foreground="{StaticResource Brush.TextSecondary}" Text="Clears saved filters and returns to the default sort. Your media and folders stay intact." /></StackPanel><Button HorizontalAlignment="Right" Command="{Binding ResetLibraryCommand}" Content="Reset" Style="{StaticResource Button.Secondary}" /></Grid></Border></StackPanel></Expander>
    </StackPanel></ScrollViewer>
</UserControl>
