<UserControl x:Class="Scriptorium.App.Views.Pages.HomePage" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    xmlns:converters="clr-namespace:Scriptorium.App.Converters"
    xmlns:pages="clr-namespace:Scriptorium.App.Views.Pages" Loaded="OnLoaded" Background="Transparent">
    <UserControl.Resources>
        <converters:ViewportContentHeightConverter x:Key="ViewportContentHeightConverter" />
    </UserControl.Resources>
    <Grid>
        <ScrollViewer Style="{StaticResource ScrollViewer.MainContent}" x:Name="HomeScroll" SizeChanged="OnHomeLayoutSizeChanged" ScrollChanged="OnHomeScrollChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel Margin="{StaticResource Home.Page.Padding}">
                <controls:LoadingIndicator Message="Finding your next watch..." Detail="Loading your local media."
                    Visibility="{Binding ShowLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Border Style="{StaticResource Surface}" Padding="{StaticResource Spacing.M}" Margin="{StaticResource Home.Status.Margin}"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                </Border>
                <controls:HomeHero x:Name="Hero" Media="{Binding Hero}" HeroMetadata="{Binding HeroMetadata}" OpenCommand="{Binding OpenMediaCommand}"
                    FavoriteCommand="{Binding ToggleFavoriteCommand}" Preview="{Binding HeroPreview}" Margin="{StaticResource Home.Hero.Margin}"
                    Visibility="{Binding HasHero, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl x:Name="Shelves" ItemsSource="{Binding Shelves}" SizeChanged="OnHomeLayoutSizeChanged">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <controls:MediaShelf Title="{Binding Title}" ItemsSource="{Binding Items}"
                            OpenCommand="{Binding DataContext.OpenMediaCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:HomePage}}}"
                            FavoriteCommand="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:HomePage}}}" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="EmptyState"
                    MinHeight="{Binding ViewportHeight, ElementName=HomeScroll, Converter={StaticResource ViewportContentHeightConverter}, ConverterParameter={StaticResource Home.Page.Padding}}"
                    Visibility="{Binding ShowEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="0,24" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:MediaEmptyArtwork Margin="0,0,0,28" HorizontalAlignment="Center" />
                        <TextBlock Text="Your next watch starts here" Style="{StaticResource Text.EmptyStateTitle}" FontSize="{StaticResource FontSize.PageTitle}" />
                        <TextBlock Text="Add your local media in Library. Your latest additions, favorites and viewing history will appear here."
                            Style="{StaticResource Text.Body.Center}" FontSize="18" LineHeight="26" Margin="12,12,12,0" />
                        <Button Margin="0,28,0,0" MinWidth="208" MinHeight="50" FontSize="18" HorizontalAlignment="Center"
                            Command="{Binding DataContext.BrowseLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="Open library" Style="{StaticResource Button.Primary}">
                            <Button.ContentTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" FontSize="18" FontWeight="Medium" /></DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Width="{Binding ViewportWidth, ElementName=HomeScroll}" HorizontalAlignment="Left">
            <Button x:Name="ScrollUpButton" Style="{StaticResource Button.RoundIcon}" HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,16,0,0" Visibility="Collapsed" Click="OnScrollToTop"
                ToolTip="Scroll to top" AutomationProperties.Name="Scroll to top">
                <Path Data="M 1,7 L 7,1 L 13,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Button>
            <Button x:Name="ScrollDownButton" Style="{StaticResource Button.RoundIcon}" HorizontalAlignment="Center"
                VerticalAlignment="Bottom" Margin="0,0,0,16" Visibility="Collapsed" Click="OnScrollToBottom"
                ToolTip="Scroll to bottom" AutomationProperties.Name="Scroll to bottom">
                <Path Data="M 1,1 L 7,7 L 13,1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Button>
        </Grid>
    </Grid>
</UserControl>

