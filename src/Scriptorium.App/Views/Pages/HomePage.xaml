<UserControl
    x:Class="Scriptorium.App.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel
            MaxWidth="640"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource Text.Display}"
                Text="{Binding WelcomeMessage}" />

            <TextBlock
                Margin="0,12,0,24"
                HorizontalAlignment="Center"
                Style="{StaticResource Text.Body}"
                Text="{Binding StatusMessage}" />

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    MinWidth="120"
                    Height="32"
                    Margin="0,0,8,0"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding UpdateWelcomeMessageCommand}">
                    Click me mofo!
                </Button>
                <Button
                    MinWidth="170"
                    Height="32"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding UpdateWelcomeMessageAsyncCommand}">
                    Update asynchronously
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
