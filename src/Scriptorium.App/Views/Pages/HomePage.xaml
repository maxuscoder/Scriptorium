<UserControl x:Class="Scriptorium.App.Views.Pages.HomePage" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    xmlns:pages="clr-namespace:Scriptorium.App.Views.Pages" Loaded="OnLoaded" Background="{DynamicResource Brush.Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="{StaticResource Home.Page.Padding}">
            <Grid Margin="{StaticResource Home.Toolbar.Margin}">
                <TextBlock Text="Home" Style="{StaticResource Text.SectionTitle}" />
                <Button HorizontalAlignment="Right" Style="{StaticResource Button.RoundIcon}" Command="{Binding RefreshCommand}"
                    ToolTip="Refresh Home" AutomationProperties.Name="Refresh Home">
                    <TextBlock FontFamily="{StaticResource MediaCard.FontFamily.Icons}" Text="&#xE72C;" />
                </Button>
            </Grid>
            <controls:LoadingIndicator Message="Finding your next watch..." Detail="Loading your local media."
                Visibility="{Binding ShowLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Border Style="{StaticResource Surface}" Padding="{StaticResource Spacing.M}" Margin="{StaticResource Home.Toolbar.Margin}"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
            </Border>
            <controls:HomeHero x:Name="Hero" Media="{Binding Hero}" OpenCommand="{Binding OpenMediaCommand}"
                FavoriteCommand="{Binding ToggleFavoriteCommand}" Margin="{StaticResource Home.Hero.Margin}"
                Visibility="{Binding HasHero, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ItemsControl x:Name="Shelves" ItemsSource="{Binding Shelves}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <controls:MediaShelf Title="{Binding Title}" ItemsSource="{Binding Items}"
                        OpenCommand="{Binding DataContext.OpenMediaCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:HomePage}}}"
                        FavoriteCommand="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:HomePage}}}" />
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="EmptyState" Style="{StaticResource Surface}" Padding="{StaticResource Spacing.2XL}"
                Visibility="{Binding ShowEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Your next watch starts here" Style="{StaticResource Text.PageTitle}" TextWrapping="Wrap" />
                    <TextBlock Text="Add your local media in Library. Your latest additions, favorites and viewing history will appear here."
                        Style="{StaticResource Text.Secondary}" Margin="{StaticResource Home.Copy.Gap}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

