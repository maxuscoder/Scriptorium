<UserControl
    x:Class="Scriptorium.App.Views.Pages.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,48">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.PageTitle}" Text="Favorites" />
                        <Border Margin="12,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.SurfaceOverlay}" CornerRadius="{StaticResource CornerRadius.S}" Padding="9,3">
                            <TextBlock Style="{StaticResource Text.Badge}" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding FavoriteCountText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}" Text="The media you want to find quickly, all in one place." />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding RefreshCommand}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource Button.Secondary}" TargetType="Button">
                            <Setter Property="Content" Value="Refresh" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                    <Setter Property="Content" Value="Refreshing…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Border Margin="0,20,0,0" Background="{DynamicResource Brush.SurfaceOverlay}" CornerRadius="{StaticResource CornerRadius.M}" Padding="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:LoadingIndicator Message="Loading favorites…" Detail="Updating your saved media." />
            </Border>

            <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource Brush.Warning}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <ItemsControl Margin="0,28,0,0" ItemsSource="{Binding MediaItems}" Style="{StaticResource Library.MediaItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:MediaCard
                            CardWidth="{StaticResource MediaCard.Width}"
                            Margin="{StaticResource MediaCard.Margin}"
                            ActionCommand="{Binding DataContext.OpenFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ActionParameter="{Binding}"
                            ActionText="Open"
                            CategoryColor="{Binding CategoryColor}"
                            CategoryName="{Binding CategoryName}"
                            FavoriteCommand="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            FavoriteParameter="{Binding}"
                            FallbackGlyph="{Binding TypeGlyph}"
                            HasManualMetadata="{Binding HasManualMetadata}"
                            HasPlaybackProgress="{Binding HasPlaybackProgress}"
                            IsFavorite="{Binding IsFavorite}"
                            IsMissing="{Binding IsMissing}"
                            PlaybackProgressPercentage="{Binding PlaybackProgressPercentage}"
                            PlaybackProgressText="{Binding PlaybackProgressText}"
                            Metadata="{Binding CardMetadata}" FileName="{Binding FileName}"
                            Status="{Binding Availability}"
                            ThumbnailPath="{Binding ThumbnailPath}"
                            Title="{Binding Title}"
                            TypeLabel="{Binding MediaType}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,52,0,0" HorizontalAlignment="Center" MaxWidth="440">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasFavorites}" Value="False" />
                                    <Condition Binding="{Binding IsRefreshing}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Display}" Text="No favorites yet" />
                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Body.Center}" Text="Use the star on any media card to keep it close at hand." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

