<UserControl
    x:Class="Scriptorium.App.Views.Pages.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    xmlns:converters="clr-namespace:Scriptorium.App.Converters"
    Loaded="OnLoaded">
    <UserControl.Resources>
        <converters:ViewportContentHeightConverter x:Key="ViewportContentHeightConverter" />
    </UserControl.Resources>
    <ScrollViewer x:Name="FavoritesViewport" Style="{StaticResource ScrollViewer.MainContent}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource Padding.Page}" MaxWidth="1400" SizeChanged="OnContentSizeChanged"
              MinHeight="{Binding ViewportHeight, ElementName=FavoritesViewport, Converter={StaticResource ViewportContentHeightConverter}, ConverterParameter={StaticResource Padding.Page}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="Favorites" />
                    <Border Margin="12,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.SurfaceOverlay}" CornerRadius="{StaticResource CornerRadius.S}" Padding="9,3">
                        <TextBlock Style="{StaticResource Text.Badge}" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding FavoriteCountText}" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Style="{StaticResource Text.Body}" Text="The media you want to find quickly, all in one place." />
                <StackPanel x:Name="HeaderActions" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Command="{Binding RefreshCommand}"
                            Style="{StaticResource Button.Icon}" BorderThickness="0" ToolTip="Refresh favorites" AutomationProperties.Name="Refresh favorites">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <controls:LoadingIndicator Grid.Row="1" Margin="0,20,0,0" Message="Loading favorites…" Detail="Updating your saved media."
                Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Grid.Row="2" Margin="0,16,0,0" Foreground="{DynamicResource Brush.Warning}" Text="{Binding StatusMessage}" TextWrapping="Wrap">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding StatusMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ItemsControl Grid.Row="3" Margin="0,28,0,0" ItemsSource="{Binding MediaItems}">
                <ItemsControl.Style><Style TargetType="ItemsControl" BasedOn="{StaticResource Library.MediaItems}"><Style.Triggers><DataTrigger Binding="{Binding HasFavorites}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:MediaCard
                            CardWidth="{StaticResource MediaCard.Width}"
                            Margin="{StaticResource MediaCard.Margin}"
                            ActionCommand="{Binding DataContext.OpenFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ActionParameter="{Binding}"
                            ActionText="Open"
                            CategoryColor="{Binding CategoryColor}"
                            CategoryName="{Binding CategoryName}"
                            FavoriteCommand="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            FavoriteParameter="{Binding}"
                            FallbackGlyph="{Binding TypeGlyph}"
                            HasManualMetadata="{Binding HasManualMetadata}"
                            HasPlaybackProgress="{Binding HasPlaybackProgress}"
                            IsFavorite="{Binding IsFavorite}"
                            IsMissing="{Binding IsMissing}"
                            PlaybackProgressPercentage="{Binding PlaybackProgressPercentage}"
                            PlaybackProgressText="{Binding PlaybackProgressText}"
                            Metadata="{Binding CardMetadata}" FileName="{Binding FileName}"
                            Status="{Binding Availability}"
                            ThumbnailPath="{Binding ThumbnailPath}"
                            Title="{Binding Title}"
                            TypeLabel="{Binding MediaType}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel x:Name="FavoritesEmptyState" Grid.Row="4" Margin="0,24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasFavorites}" Value="False" />
                                    <Condition Binding="{Binding IsRefreshing}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <controls:MediaEmptyArtwork IsFavorite="True" Margin="0,0,0,28" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.EmptyStateTitle}" FontSize="{StaticResource FontSize.PageTitle}" Text="No favorites yet" />
                <TextBlock Margin="12,12,12,0" Style="{StaticResource Text.Body.Center}" FontSize="18" Text="Found something worth coming back to? Star any movie, show, or tutorial to save it here." LineHeight="26" />
                <Button Margin="0,28,0,0" MinWidth="208" MinHeight="50" FontSize="18" HorizontalAlignment="Center"
                        Command="{Binding DataContext.BrowseLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="Browse library" Style="{StaticResource Button.Primary}">
                    <Button.ContentTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" FontSize="18" FontWeight="Medium" /></DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

