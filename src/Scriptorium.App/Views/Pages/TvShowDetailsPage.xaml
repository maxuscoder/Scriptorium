<UserControl
    x:Class="Scriptorium.App.Views.Pages.TvShowDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Spacing.XL}" MaxWidth="800">
            <Button
                HorizontalAlignment="Left"
                Command="{Binding BackCommand}"
                Content="Back to library"
                Style="{StaticResource Button.Secondary}" />
            <TextBlock
                Margin="0,24,0,0"
                Style="{StaticResource Text.PageTitle}"
                Text="{Binding Title}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource Text.Metadata}"
                Text="{Binding SourceFolder}" />
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource Text.Metadata}"
                Text="{Binding EpisodeCountText}" />
            <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource Text.Metadata}"
                            Text="{Binding SelectedEpisodePositionText}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Text.CardTitle}"
                            Text="{Binding SelectedEpisode.Title}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Text.Metadata}"
                            Text="{Binding SelectedEpisode.SeasonAndPosition}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding PreviousEpisodeCommand}"
                            Content="Previous episode"
                            Style="{StaticResource Button.Secondary}" />
                        <Button
                            Command="{Binding NextEpisodeCommand}"
                            Content="Next episode"
                            Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </Grid>
            </Border>
            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Seasons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock
                                Style="{StaticResource Text.SubsectionTitle}"
                                Text="{Binding Title}" />
                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Episodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10">
                                            <Border.Style>
                                                <Style BasedOn="{StaticResource Card}" TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Style="{StaticResource Text.Metadata}"
                                                        Foreground="{StaticResource Brush.Accent}"
                                                        Text="{Binding Position}" />
                                                    <TextBlock Margin="0,4,0,0" Text="{Binding Runtime}">
                                                        <TextBlock.Style>
                                                            <Style BasedOn="{StaticResource Text.Metadata}" TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Runtime}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Style="{StaticResource Text.CardTitle}"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap"
                                                        ToolTip="{Binding Title}" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        Style="{StaticResource Text.Metadata}"
                                                        Text="{Binding FilePath}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        Style="{StaticResource Text.Metadata}"
                                                        Foreground="{StaticResource Brush.TextSecondary}"
                                                        Text="{Binding Availability}" />
                                                    <Button
                                                        Margin="0,8,0,0"
                                                        Command="{Binding DataContext.SelectEpisodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Select"
                                                        Style="{StaticResource Button.Secondary}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
