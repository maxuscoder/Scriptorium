<UserControl
    x:Class="Scriptorium.App.Views.Pages.TvShowDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Spacing.XL}" MaxWidth="800">
            <Button
                HorizontalAlignment="Left"
                Command="{Binding BackCommand}"
                Content="Back to library"
                Style="{StaticResource Button.Secondary}" />
            <TextBlock
                Margin="0,24,0,0"
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="{StaticResource Brush.TextPrimary}"
                Text="{Binding Title}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{StaticResource Brush.TextSecondary}"
                Text="{Binding SourceFolder}" />
            <TextBlock
                Margin="0,16,0,0"
                Foreground="{StaticResource Brush.TextMuted}"
                Text="{Binding EpisodeCountText}" />
            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Seasons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Brush.TextPrimary}"
                                Text="{Binding Title}" />
                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Episodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Style="{StaticResource Card}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Foreground="{StaticResource Brush.Accent}"
                                                        Text="{Binding Position}" />
                                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Runtime}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Runtime}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap"
                                                        ToolTip="{Binding Title}" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        Foreground="{StaticResource Brush.TextMuted}"
                                                        Text="{Binding FilePath}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource Brush.TextSecondary}"
                                                    Text="{Binding Availability}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
