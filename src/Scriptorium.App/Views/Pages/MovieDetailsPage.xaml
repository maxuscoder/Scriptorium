<UserControl
    x:Class="Scriptorium.App.Views.Pages.MovieDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls">
    <controls:MediaDetailsPage
        BackCommand="{Binding BackCommand}"
        Description="{Binding Description}"
        FallbackGlyph="▶"
        HeaderMetadata="{Binding HeaderMetadata}"
        MetadataItems="{Binding MetadataItems}"
        SecondaryActionCommand="{Binding ToggleCompletionCommand}"
        SecondaryActionText="{Binding CompletionActionText}"
        Status="{Binding Availability}"
        TertiaryActionCommand="{Binding ToggleFavoriteCommand}"
        TertiaryActionText="{Binding FavoriteActionText}"
        ThumbnailPath="{Binding ThumbnailPath}"
        Title="{Binding Title}"
        TypeLabel="Movie">
        <controls:MediaDetailsPage.PreviewContent>
            <controls:VideoPlayer Height="380" Player="{Binding Player}" />
        </controls:MediaDetailsPage.PreviewContent>
        <controls:MediaDetailsPage.ExtensionContent>
            <StackPanel>
                <controls:MediaCategoryEditor />
                <Border Height="1" Margin="0,20,0,20" Background="{StaticResource Brush.Border}" />
                <TextBlock Style="{StaticResource Text.SubsectionTitle}" Text="Playback progress" />
                <ProgressBar
                    Height="6"
                    Margin="0,12,0,0"
                    Background="{StaticResource Brush.Border}"
                    Foreground="{StaticResource Brush.Accent}"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding PlaybackProgressPercentage, Mode=OneWay}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{StaticResource Brush.TextMuted}"
                    Text="{Binding PlaybackProgressText}" />
                <Button
                    Margin="0,12,0,0"
                    Command="{Binding ResetProgressCommand}"
                    Content="Reset progress"
                    HorizontalAlignment="Left"
                    Style="{StaticResource Button.Secondary}" />
            </StackPanel>
        </controls:MediaDetailsPage.ExtensionContent>
    </controls:MediaDetailsPage>
</UserControl>
