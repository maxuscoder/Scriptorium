<UserControl
    x:Class="Scriptorium.App.Views.Pages.MovieDetailsPage"
    Background="{DynamicResource Brush.Background}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    xmlns:converters="clr-namespace:Scriptorium.App.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Theme/CollectionDetails.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:MediaPlayActionConverter x:Key="MediaPlayActionConverter" />
            <SolidColorBrush x:Key="Movie.FileSurface" Color="{DynamicResource Color.SurfaceOverlay}" Opacity="0.18" />
            <Style x:Key="Movie.Action" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="Background" Value="{StaticResource Movie.FileSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="Movie.MetadataValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="Not specified"><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" /></Trigger>
                    <Trigger Property="Text" Value="Never"><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Movie.FileExpander" TargetType="Expander">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Background="{StaticResource Movie.FileSurface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  HorizontalContentAlignment="Stretch" Foreground="{DynamicResource Brush.TextPrimary}"
                                                  Cursor="Hand" FocusVisualStyle="{StaticResource Focus.Keyboard}"
                                                  AutomationProperties.Name="File information">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="18,17" CornerRadius="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                                        <Path x:Name="Chevron" Grid.Column="1" Margin="18,0,2,0" VerticalAlignment="Center"
                                                              Data="M 0,0 L 4,5 L 8,0" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.3"
                                                              RenderTransformOrigin="0.5,0.5" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.AccentStrong}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Border x:Name="FileDetails" Visibility="Collapsed" Margin="18,0,18,18" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                                        <ContentPresenter />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True"><Setter TargetName="FileDetails" Property="Visibility" Value="Visible" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <controls:MediaDetailsPage BackCommand="{Binding BackCommand}" EditCommand="{Binding EditCommand}" IsEditing="{Binding IsEditing}"
                               Title="{Binding Title}" IsVideoLayout="True" ShowHeader="False">
        <controls:MediaDetailsPage.VideoContent>
            <Grid SizeChanged="OnPreviewSizeChanged">
                <controls:VideoPlayer Player="{Binding Player}" BackCommand="{Binding BackCommand}" IsEdgeToEdge="True" />
            </Grid>
        </controls:MediaDetailsPage.VideoContent>
        <controls:MediaDetailsPage.MainDetailsContent>
            <Border Margin="-14,18,-14,0" CornerRadius="16" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                    Background="{DynamicResource Brush.Background}">
                <Grid SizeChanged="OnCardSizeChanged">
                    <controls:ContentAtmosphereBackground />
                    <StackPanel Margin="33,32,33,34">
                        <TextBlock Text="M O V I E" Style="{StaticResource Text.Label}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" FontSize="38" FontWeight="Bold"
                                       LineHeight="48" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding EditCommand}" Style="{StaticResource Button.Icon}" ToolTip="Edit metadata" AutomationProperties.Name="Edit metadata">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" />
                                </Button>
                                <Button Style="{StaticResource Button.Icon}" Click="OnMoreActions" ToolTip="More actions" AutomationProperties.Name="More actions">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" />
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Edit metadata" Command="{Binding EditCommand}" />
                                            <MenuItem Header="Reset progress" Command="{Binding ResetProgressCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                            <TextBlock Text="&#x2022;" Style="{StaticResource Text.Metadata}" Margin="12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                            <TextBlock Text="&#x2022;" Style="{StaticResource Text.Metadata}" Margin="12,0" VerticalAlignment="Center" />
                            <Border Padding="10,7" CornerRadius="6" Background="{StaticResource Movie.FileSurface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style><Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPlaybackProgress}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Accent}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style></Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ViewingStatus}" Style="{StaticResource Text.Body}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <WrapPanel Margin="0,29,0,0">
                            <Button Command="{Binding Player.TogglePlaybackCommand}" Style="{StaticResource Button.Primary}" MinWidth="115" MinHeight="50" Padding="24,10" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 0,0 L 0,14 L 12,7 Z" Fill="{DynamicResource Brush.PrimaryButton.Text}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock FontWeight="Bold"><TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource MediaPlayActionConverter}"><Binding Path="Player.PlayActionText" /><Binding Path="PlayActionText" /></MultiBinding>
                                    </TextBlock.Text></TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleFavoriteCommand}" Style="{StaticResource Movie.Action}" Margin="0,0,10,0"
                                    ToolTip="{Binding FavoriteActionText}" AutomationProperties.Name="{Binding FavoriteActionText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xEB51;" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Text" Value="&#xEB52;" /><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" /></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding FavoriteButtonText}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleCompletionCommand}" Style="{StaticResource Movie.Action}"
                                    ToolTip="{Binding CompletionActionText}" AutomationProperties.Name="{Binding CompletionActionText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CompletionButtonText}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" Margin="0,18,0,0" Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding Availability}" Foreground="{DynamicResource Brush.Warning}" Margin="0,14,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                <Style.Triggers><Trigger Property="Text" Value="Available"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <Grid Margin="0,18,0,0" Visibility="{Binding HasPlaybackProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ProgressBar Style="{StaticResource Collection.Progress}" Value="{Binding PlaybackProgressPercentage, Mode=OneWay}" VerticalAlignment="Center" AutomationProperties.Name="Playback progress" />
                            <Button Grid.Column="1" Command="{Binding ResetProgressCommand}" Content="Reset progress" Margin="14,0,0,0" Style="{StaticResource Button.Text}" FontSize="12" />
                        </Grid>
                        <Border Margin="0,30,0,0" Height="1" Background="{DynamicResource Brush.BorderStrong}" />
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Details" Style="{StaticResource Text.SubsectionTitle}" />
                            <TextBlock Grid.Column="1" Text="Local media" Style="{StaticResource Text.Metadata}" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SummaryMetadataItems}" Margin="0,24,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" SizeChanged="OnMetadataSizeChanged" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel Margin="0,0,16,16">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Metadata}" FontSize="13" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Movie.MetadataValue}" Margin="0,12,0,0" />
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Margin="0,16,0,0" Style="{StaticResource Movie.FileExpander}" IsExpanded="False">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="39" Height="39" CornerRadius="8" Background="{DynamicResource Brush.SurfaceOverlay}" Margin="0,0,14,0">
                                        <Path Data="M 0,0 L 11,0 L 11,14 L 0,14 Z M 2,3 L 9,3 M 2,6 L 9,6 M 2,9 L 9,9 M 2,12 L 7,12"
                                              Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.CardTitle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Metadata}" Text="{Binding FileSizeText, StringFormat=File information · {0}}" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding FileMetadataItems}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Metadata}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Body}" ToolTip="{Binding Value}" />
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <TextBlock Text="File path, format, and other technical details available on expansion." Style="{StaticResource Text.Metadata}" FontSize="13" TextWrapping="Wrap" Margin="0,18,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </controls:MediaDetailsPage.MainDetailsContent>
        <controls:MediaDetailsPage.EditorContent>
            <controls:MediaDetailsEditor />
        </controls:MediaDetailsPage.EditorContent>
    </controls:MediaDetailsPage>
</UserControl>
