<UserControl
    x:Class="Scriptorium.App.Views.Pages.MovieDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls">
    <controls:MediaDetailsPage
        BackCommand="{Binding BackCommand}"
        Description="{Binding Description}"
        FallbackGlyph="▶"
        HeaderMetadata="{Binding HeaderMetadata}"
        MetadataItems="{Binding MetadataItems}"
        PrimaryActionCommand="{Binding PlayCommand}"
        PrimaryActionText="{Binding PlayActionText}"
        SecondaryActionCommand="{Binding ToggleCompletionCommand}"
        SecondaryActionText="{Binding CompletionActionText}"
        Status="{Binding Availability}"
        TertiaryActionCommand="{Binding ToggleFavoriteCommand}"
        TertiaryActionText="{Binding FavoriteActionText}"
        ThumbnailPath="{Binding ThumbnailPath}"
        Title="{Binding Title}"
        TypeLabel="Movie" />
</UserControl>
