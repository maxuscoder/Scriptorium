<UserControl
    x:Class="Scriptorium.App.Views.Pages.MovieDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Spacing.XL}" MaxWidth="800">
            <Button
                HorizontalAlignment="Left"
                Command="{Binding BackCommand}"
                Content="Back to library"
                Style="{StaticResource Button.Secondary}" />
            <TextBlock
                Margin="0,24,0,0"
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="{StaticResource Brush.TextPrimary}"
                Text="{Binding Title}" />
            <WrapPanel Margin="0,12,0,0">
                <TextBlock Margin="0,0,16,0" Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding ReleaseYear}" />
                <TextBlock Margin="0,0,16,0" Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding Runtime}" />
                <TextBlock Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding Availability}" />
            </WrapPanel>
            <TextBlock
                Margin="0,8,0,0"
                Foreground="{StaticResource Brush.TextMuted}"
                Text="{Binding SourceFolder}" />
            <Border Margin="0,24,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Description" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{StaticResource Brush.TextSecondary}"
                        Text="{Binding Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="File" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Text="{Binding FilePath}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
