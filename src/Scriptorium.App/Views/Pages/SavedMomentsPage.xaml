<UserControl x:Class="Scriptorium.App.Views.Pages.SavedMomentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style><Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer.MainContent}">
                <Style.Triggers><DataTrigger Binding="{Binding IsPlayerVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style></ScrollViewer.Style>
            <StackPanel Margin="{StaticResource Padding.Page}" MaxWidth="1400">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Saved Moments" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}" Text="Return to the timestamps and sequences saved across your library." TextWrapping="Wrap" />
                <WrapPanel Margin="0,22,0,0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,10"><TextBlock Style="{StaticResource Text.Label}" Text="Search title, notes, or tags" Margin="0,0,0,6" />
                        <TextBox Width="260" Style="{StaticResource Input.TextBox}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search saved moments" /></StackPanel>
                    <StackPanel Margin="0,0,12,10"><TextBlock Style="{StaticResource Text.Label}" Text="Filter" Margin="0,0,0,6" />
                        <ComboBox Width="150" Style="{StaticResource Input.ComboBox}" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" AutomationProperties.Name="Filter moments" /></StackPanel>
                    <StackPanel Margin="0,0,12,10"><TextBlock Style="{StaticResource Text.Label}" Text="Sort by" Margin="0,0,0,6" />
                        <ComboBox Width="150" Style="{StaticResource Input.ComboBox}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" AutomationProperties.Name="Sort moments" /></StackPanel>
                    <Button Margin="0,22,12,10" Command="{Binding RegenerateMissingCommand}" Content="Regenerate missing previews" Style="{StaticResource Button.Secondary}" />
                    <Button Margin="0,22,0,10" Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource Button.Secondary}" />
                </WrapPanel>
                <TextBlock Margin="0,8,0,0" Text="{Binding CountText}" Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding Status}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" Text="Loading saved moments?" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Moments}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Width="220" Margin="0,0,18,22">
                            <controls:MediaCard CardWidth="220" IsListLayout="False" Title="{Binding Title}" Metadata="{Binding Metadata}"
                                TypeLabel="{Binding Kind}" IsMissing="{Binding IsSourceMissing}" ThumbnailPath="{Binding ThumbnailPath}" ActionText="Open moment"
                                ActionCommand="{Binding DataContext.OpenMomentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ActionParameter="{Binding}" />
                            <StackPanel Orientation="Horizontal" Margin="4,8,0,0">
                                <Button Content="Edit" Click="OnEditMoment" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" AutomationProperties.Name="Edit moment" />
                                <Button Content="Delete" Click="OnDeleteMoment" Style="{StaticResource Button.Secondary}" AutomationProperties.Name="Delete moment" />
                            </StackPanel>
                            <TextBlock Margin="4,8,4,2" Text="Preview time (h:mm:ss)" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <DockPanel Margin="4,0,4,0">
                                <Button DockPanel.Dock="Right" Content="Set frame" Margin="6,0,0,0" Style="{StaticResource Button.Secondary}" Command="{Binding DataContext.ChoosePreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <TextBox Text="{Binding PreviewTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" AutomationProperties.Name="Preview time" />
                            </DockPanel>
                            <TextBlock Margin="4,4,4,0" Text="{Binding Timestamp}" Foreground="{DynamicResource Brush.TextSecondary}" AutomationProperties.Name="Moment timestamp" />
                            <TextBlock Margin="4,4,4,0" Text="{Binding Notes}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="4,3,4,0" Text="{Binding Tags}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,24,0,0" Text="No matching moments. Save one in the player or adjust your search." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Moments.Count}" Value="0" /><Condition Binding="{Binding IsLoading}" Value="False" /><Condition Binding="{Binding Status}" Value="{x:Null}" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
        <Grid Visibility="{Binding IsPlayerVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="{StaticResource Padding.Page}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Left" Command="{Binding BackToMomentsCommand}" Content="? Saved Moments" Style="{StaticResource Button.Secondary}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding PlayingTitle}" Style="{StaticResource Text.PanelTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <controls:VideoPlayer Grid.Row="1" Player="{Binding Player}" BackCommand="{Binding BackToMomentsCommand}" />
        </Grid>
    </Grid>
</UserControl>
