<UserControl
    x:Class="Scriptorium.App.Views.Pages.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,48" MaxWidth="1200">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.PageTitle}" Text="Categories" />
                        <Border
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brush.SurfaceOverlay}"
                            CornerRadius="{StaticResource CornerRadius.S}"
                            Padding="9,3">
                            <TextBlock
                                Style="{StaticResource Text.Badge}"
                                Foreground="{StaticResource Brush.TextPrimary}"
                                Text="{Binding CategoryCountText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource Text.Body}"
                        Text="Create and organize custom labels for your media library." />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        Style="{StaticResource Button.Secondary}" />
                    <Button
                        Command="{Binding CreateCategoryCommand}"
                        Content="Create category"
                        Style="{StaticResource Button.Primary}" />
                </StackPanel>
            </Grid>

            <TextBlock
                MinHeight="24"
                Margin="0,32,0,0"
                Foreground="{StaticResource Brush.TextSecondary}"
                Text="{Binding StatusMessage}" />

            <StackPanel
                Margin="0,16,0,0"
                Visibility="{Binding HasCategories, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Browse by category" />
                        <TextBlock
                            Margin="10,2,0,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Brush.TextMuted}"
                            Text="Select a category to see its media" />
                    </StackPanel>
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Text="{Binding SelectedCategoryMediaCountText}" />
                </Grid>

                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="220"
                                Margin="0,0,12,12"
                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                HorizontalContentAlignment="Stretch"
                                ToolTip="Browse this category">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource Button.Secondary}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.SelectionSurface}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding ColorBrush}"
                                        CornerRadius="6" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            Style="{StaticResource Text.Label}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Style="{StaticResource Text.Metadata}"
                                            Text="{Binding MediaCountText}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel
                Margin="0,20,0,0"
                Visibility="{Binding HasSelectedCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding SelectedCategoryName}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource Brush.TextMuted}">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource Text.Metadata}" TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Text" Value="Refreshing…" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ItemsControl
                    Margin="0,16,0,0"
                    ItemsSource="{Binding MediaItems}"
                    Style="{StaticResource Library.MediaItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MediaCard
                                CardWidth="260"
                                Margin="0,0,16,16"
                                CategoryColor="{Binding CategoryColor}"
                                CategoryName="{Binding CategoryName}"
                                FallbackGlyph="{Binding TypeGlyph}"
                                HasPlaybackProgress="{Binding HasPlaybackProgress}"
                                IsFavorite="{Binding IsFavorite}"
                                IsMissing="{Binding IsMissing}"
                                PlaybackProgressPercentage="{Binding PlaybackProgressPercentage}"
                                PlaybackProgressText="{Binding PlaybackProgressText}"
                                PrimaryMetadata="{Binding Detail}"
                                SecondaryMetadata="{Binding Runtime}"
                                Status="{Binding Availability}"
                                ThumbnailPath="{Binding ThumbnailPath}"
                                Title="{Binding Title}"
                                TypeLabel="{Binding MediaType}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMediaItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource Text.EmptyStateTitle}"
                        Text="{Binding SelectedCategoryEmptyTitle}" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource Text.Body.Center}"
                        Text="{Binding SelectedCategoryEmptyDescription}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasCategories, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Your categories" />
                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,12"
                                Padding="18"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadius.M}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:CategoryColorPicker
                                        Margin="0,0,14,0"
                                        SelectedColor="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBox
                                            Style="{StaticResource Input.TextBox}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Category name" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource Text.Metadata}"
                                            Text="{Binding MediaCountText}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.RenameCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Save"
                                            Style="{StaticResource Button.Secondary}" />
                                        <Button
                                            Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Delete"
                                            Style="{StaticResource Button.Destructive}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel
                MaxWidth="520"
                Margin="0,44,0,0"
                HorizontalAlignment="Center"
                Visibility="{Binding HasCategories, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.EmptyStateTitle}"
                    Text="No categories yet" />
                <TextBlock
                    Margin="0,10,0,0"
                    Style="{StaticResource Text.Body.Center}"
                    Text="Add your first category above to start organizing media beyond its type." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
