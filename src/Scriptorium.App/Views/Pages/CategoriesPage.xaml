<UserControl
    x:Class="Scriptorium.App.Views.Pages.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    xmlns:converters="clr-namespace:Scriptorium.App.Converters"
    xmlns:pages="clr-namespace:Scriptorium.App.Views.Pages"
    Loaded="OnLoaded" Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ViewportContentHeightConverter x:Key="ViewportContentHeightConverter" />
        <Style x:Key="Collections.Tile" TargetType="Button" BasedOn="{StaticResource Category.CollectionTile}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="CategoryViewport" Style="{StaticResource ScrollViewer.MainContent}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="CategoryContent" Margin="{StaticResource Categories.ContentInset}" MaxWidth="1400" SizeChanged="OnContentSizeChanged"
              MinHeight="{Binding ViewportHeight, ElementName=CategoryViewport, Converter={StaticResource ViewportContentHeightConverter}, ConverterParameter={StaticResource Categories.ContentInset}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="Categories" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Metadata}" Text="{Binding CategoryCountText}" />
                </StackPanel>
                <StackPanel x:Name="HeaderActions" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Icon}" BorderThickness="0" ToolTip="Refresh categories" AutomationProperties.Name="Refresh categories">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" />
                    </Button>
                    <Button Command="{Binding CreateCategoryCommand}" Content="Create category" Style="{StaticResource Button.Primary}" />
                </StackPanel>
            </Grid>

            <controls:LoadingIndicator Grid.Row="1" Margin="0,12,0,0" Message="Loading categories..." Detail="Updating collections and their media."
                Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Grid.Row="2" Margin="0,12,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers><DataTrigger Binding="{Binding StatusMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Row="3" Margin="0,22,0,0" Visibility="{Binding HasCategories, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource Text.SubsectionTitle}" Text="Your collections" />
                <ItemsControl x:Name="CollectionsGrid" Margin="-4,8,-16,0" ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding Path=(pages:CategoriesPage.BrowserCardWidth), RelativeSource={RelativeSource Self}}" Height="176" Margin="{StaticResource MediaCard.Margin}">
                                <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Browse this collection" Style="{StaticResource Collections.Tile}" AutomationProperties.Name="{Binding Name}">
                                    <Grid ClipToBounds="True">
                                        <Grid.RowDefinitions><RowDefinition Height="96" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <controls:CategoryArtworkPreview Grid.Row="0" ThumbnailPath="{Binding PreviewThumbnailPath}" Margin="1" />
                                        <TextBlock Grid.Row="0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="28" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PreviewThumbnailPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding PreviewThumbnailPath}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Grid.Row="0" Background="{StaticResource Brush.ArtworkScrim}" Opacity="0.16" IsHitTestVisible="False" />
                                        <StackPanel Grid.Row="1" Margin="12,8,12,9" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding ColorBrush}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.CardTitle}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            </Grid>
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Metadata}" Text="{Binding MediaCountText}" />
                                            <TextBlock Margin="0,2,0,0" Text="{Binding MediaTypeSummaryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MediaTypeSummaryText}">
                                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}"><Style.Triggers><DataTrigger Binding="{Binding MediaTypeSummaryText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Panel.ZIndex="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{StaticResource Category.Tile.MoreInset}" Style="{StaticResource Category.MoreButton}" Click="OnMoreCategoryActionsClick" ToolTip="Category actions" AutomationProperties.Name="Category actions">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE712;" />
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Rename / change color..." Click="OnEditCategoryClick" Style="{StaticResource Menu.Item}" />
                                            <Separator />
                                            <MenuItem Header="Delete category" Click="OnDeleteCategoryClick" Style="{StaticResource Menu.Item.Destructive}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,8,0,0" Visibility="{Binding HasSelectedCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectedCollectionTitle" Style="{StaticResource Text.SectionTitle}" Text="{Binding SelectedCategoryName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedCategoryName}" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Text.Metadata}" Text="{Binding SelectedCategoryMediaCountText}" />
                </Grid>
                <ItemsControl x:Name="CollectionMediaGrid" Margin="-4,8,-16,0" ItemsSource="{Binding MediaItems}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MediaCard CardWidth="{Binding Path=(pages:CategoriesPage.BrowserCardWidth), RelativeSource={RelativeSource Self}}" Margin="{StaticResource MediaCard.Margin}" ActionCommand="{Binding DataContext.OpenMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ActionParameter="{Binding}" CategoryColor="{Binding CategoryColor}" CategoryName="{Binding CategoryName}" FavoriteCommand="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" FavoriteParameter="{Binding}" FallbackGlyph="{Binding TypeGlyph}" HasManualMetadata="{Binding HasManualMetadata}" HasPlaybackProgress="{Binding HasPlaybackProgress}" IsFavorite="{Binding IsFavorite}" IsMissing="{Binding IsMissing}" PlaybackProgressPercentage="{Binding PlaybackProgressPercentage}" PlaybackProgressText="{Binding PlaybackProgressText}" Metadata="{Binding CardMetadata}" FileName="{Binding FileName}" Status="{Binding Availability}" ThumbnailPath="{Binding ThumbnailPath}" Title="{Binding Title}" TypeLabel="{Binding MediaType}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel HorizontalAlignment="Center" MaxWidth="440" Margin="0,28,0,24">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasMediaItems}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,12" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource Brush.TextMuted}" Text="&#xE8B7;" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.EmptyStateTitle}" Text="{Binding SelectedCategoryEmptyTitle}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Body.Center}" Text="{Binding SelectedCategoryEmptyDescription}" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="CategoriesEmptyState" Grid.Row="5" MaxWidth="520" Margin="{StaticResource EmptyState.Margin}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasCategories}" Value="False" /><Condition Binding="{Binding IsRefreshing}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock HorizontalAlignment="Center" Margin="{StaticResource EmptyState.IconMargin}" FontFamily="{StaticResource Shell.FontFamily.Icons}" FontSize="{StaticResource Icon.Size.Feature}" Foreground="{DynamicResource Brush.TextSecondary}" Text="&#xE8B7;" AutomationProperties.Name="Collections" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.EmptyStateTitle}" Text="No categories yet" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Body.Center}" Text="Create a collection to bring related movies, shows, and tutorials together." />
                <Button Margin="0,18,0,0" HorizontalAlignment="Center" Command="{Binding CreateCategoryCommand}" Content="Create category" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
