<UserControl
    x:Class="Scriptorium.App.Views.Pages.TutorialDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Spacing.XL}" MaxWidth="800">
            <Button
                HorizontalAlignment="Left"
                Command="{Binding BackCommand}"
                Content="Back to library"
                Style="{StaticResource Button.Secondary}" />
            <TextBlock
                Margin="0,24,0,0"
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="{StaticResource Brush.TextPrimary}"
                Text="{Binding Title}" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{StaticResource Brush.TextSecondary}"
                Text="{Binding SourceFolder}" />
            <TextBlock
                Margin="0,16,0,0"
                Foreground="{StaticResource Brush.TextMuted}"
                Text="{Binding LessonCountText}" />
            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Lessons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource Brush.Accent}"
                                    Text="{Binding Position}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{StaticResource Brush.TextMuted}"
                                        Text="{Binding FilePath}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource Brush.TextSecondary}"
                                    Text="{Binding Availability}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
