<UserControl
    x:Class="Scriptorium.App.Views.Pages.TutorialDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls">
    <UserControl.Resources>
        <Style x:Key="Course.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style x:Key="Course.Reorder" TargetType="Button" BasedOn="{StaticResource Button.Text}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="Course.HasLessons" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLessons}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="Course.ProgressTemplate" TargetType="ProgressBar">
            <Grid>
                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                    <Border Background="{TemplateBinding Foreground}" CornerRadius="2" />
                    <Ellipse Width="8" Height="8" Margin="0,-2,-4,-2" HorizontalAlignment="Right" Fill="{TemplateBinding Foreground}" />
                </Grid>
            </Grid>
        </ControlTemplate>
        <Style x:Key="Course.Row" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinHeight" Value="54" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SelectionSurface}" />
                    <Setter Property="BorderThickness" Value="2,0,0,0" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <controls:MediaDetailsPage BackCommand="{Binding BackCommand}" EditCommand="{Binding EditCommand}" IsEditing="{Binding IsEditing}">
        <controls:MediaDetailsPage.MainDetailsContent>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="{Binding Title}" TextWrapping="Wrap" ToolTip="{Binding SourceFolder}" />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Body}"
                           Text="Learn at your own pace. Pick up where you left off, with your progress saved across lessons." />
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding LessonCountText}" />
                    <TextBlock Margin="8,0" Style="{StaticResource Text.Metadata}" Text="&#x2022;" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding TotalDurationText}" />
                    <TextBlock Margin="8,0" Style="{StaticResource Text.Metadata}" Text="&#x2022;" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding RemainingDurationText, StringFormat={}{0} remaining}" />
                </WrapPanel>
                <TextBlock Margin="0,18,0,0" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding CourseProgressText}" />
                <ProgressBar Height="4" Margin="0,12,0,0" Minimum="0" Maximum="100"
                             Background="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.Accent}"
                             Value="{Binding CourseProgressPercentage, Mode=OneWay}" Template="{StaticResource Course.ProgressTemplate}"
                             AutomationProperties.Name="Course progress" />
                <WrapPanel Margin="0,18,0,14">
                    <Button Margin="0,0,8,8" Command="{Binding ContinueLearningCommand}" Content="{Binding ContinueLearningText}" Style="{StaticResource Button.Primary}" />
                    <Button Margin="0,0,0,8" Command="{Binding EditCommand}" Content="Edit" Style="{StaticResource Course.Secondary}" ToolTip="Edit current lesson metadata" />
                </WrapPanel>
                <StackPanel Style="{StaticResource Course.HasLessons}">
                    <Grid SizeChanged="OnPreviewSizeChanged">
                        <controls:VideoPlayer Player="{Binding Player}" />
                    </Grid>
                    <StackPanel Margin="0,22,0,0">
                        <TextBlock Style="{StaticResource Text.Metadata}" Text="{Binding SelectedLessonPositionText}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.SubsectionTitle}" Text="{Binding SelectedLesson.Title}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" Text="Edited metadata">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLesson.HasManualMetadata}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,12,0,0" Text="{Binding SelectedLesson.Description}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Margin="0,18,0,0">
                            <Button Margin="0,0,8,8" Command="{Binding PreviousLessonCommand}" Content="Previous" Style="{StaticResource Course.Secondary}" AutomationProperties.Name="Previous lesson" />
                            <Button Margin="0,0,8,8" Command="{Binding NextLessonCommand}" Content="Next" Style="{StaticResource Course.Secondary}" AutomationProperties.Name="Next lesson" />
                            <Button Margin="0,0,8,8" Command="{Binding ToggleLessonCompletionCommand}" Content="{Binding CompletionActionText}" Style="{StaticResource Course.Secondary}" />
                            <Button Margin="0,0,0,8" Command="{Binding ToggleFavoriteCommand}" Content="{Binding FavoriteActionText}" Style="{StaticResource Course.Secondary}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Margin="0,24,0,16" Style="{StaticResource Text.SubsectionTitle}" Text="Course content" />
                <TextBlock Text="{Binding OrderStatus}" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Lessons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Course.Row}"
                                        Command="{Binding DataContext.SelectLessonCommand, RelativeSource={RelativeSource AncestorType=controls:MediaDetailsPage}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                    <Button.ToolTip>
                                        <StackPanel MaxWidth="480">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0" Text="{Binding FilePath}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0" Text="{Binding Availability}" />
                                        </StackPanel>
                                    </Button.ToolTip>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Metadata}" Text="{Binding Position}" />
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <WrapPanel Margin="0,4,0,0">
                                                <TextBlock Text="&#x2713;" Foreground="{DynamicResource Brush.Success}" Margin="0,0,4,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding CompletionStatus}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="8,0,0,0" Text="Current lesson" Foreground="{DynamicResource Brush.Accent}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="8,0,0,0" Text="&#x2605;" Foreground="{DynamicResource Brush.Warning}" ToolTip="Favorite lesson">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="8,0,0,0" Text="{Binding Availability}" Foreground="{DynamicResource Brush.Warning}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </WrapPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.Metadata}" Text="{Binding Runtime}" />
                                    </Grid>
                                </Button>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <Button Style="{StaticResource Course.Reorder}" Content="&#x2191;" ToolTip="Move lesson up" AutomationProperties.Name="Move lesson up"
                                            Command="{Binding DataContext.MoveLessonUpCommand, RelativeSource={RelativeSource AncestorType=controls:MediaDetailsPage}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Course.Reorder}" Content="&#x2193;" ToolTip="Move lesson down" AutomationProperties.Name="Move lesson down"
                                            Command="{Binding DataContext.MoveLessonDownCommand, RelativeSource={RelativeSource AncestorType=controls:MediaDetailsPage}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,0,0,16" Text="No lessons have been found in this course yet.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasLessons}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </controls:MediaDetailsPage.MainDetailsContent>
        <controls:MediaDetailsPage.EditorContent>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="22,18,22,0">
                    <TextBlock Style="{StaticResource Text.Metadata}" Text="{Binding SelectedLessonPositionText}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}" Text="{Binding SelectedLesson.Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
                <controls:MediaDetailsEditor Grid.Row="1" />
            </Grid>
        </controls:MediaDetailsPage.EditorContent>
    </controls:MediaDetailsPage>
</UserControl>
