<UserControl
    x:Class="Scriptorium.App.Views.Pages.TutorialDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    xmlns:converters="clr-namespace:Scriptorium.App.Converters">
    <UserControl.Resources>
        <Style x:Key="Course.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style x:Key="Course.Reorder" TargetType="Button" BasedOn="{StaticResource Button.Text}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <ControlTemplate x:Key="Course.ProgressTemplate" TargetType="ProgressBar">
            <Grid>
                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                    <Border Background="{TemplateBinding Foreground}" CornerRadius="2" />
                    <Ellipse Width="8" Height="8" Margin="0,-2,-4,-2" HorizontalAlignment="Right" Fill="{TemplateBinding Foreground}" />
                </Grid>
            </Grid>
        </ControlTemplate>
        <Style x:Key="Course.Row" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinHeight" Value="64" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SelectionSurface}" />
                    <Setter Property="BorderThickness" Value="2,0,0,0" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <converters:MediaPlayActionConverter x:Key="MediaPlayActionConverter" />
    </UserControl.Resources>
    <controls:MediaDetailsPage BackCommand="{Binding BackCommand}" EditCommand="{Binding EditCommand}" IsEditing="{Binding IsEditing}"
                               Title="{Binding Title}" HeaderProgressText="{Binding CourseProgressText}" SidebarTitle="Course content">
        <controls:MediaDetailsPage.ActionsMenu>
            <ContextMenu>
                <MenuItem Header="{Binding ContinueLearningText}" Command="{Binding ContinueLearningCommand}" />
                <MenuItem Header="Previous lesson" Command="{Binding PreviousLessonCommand}" />
                <Separator />
                <MenuItem Header="{Binding CompletionActionText}" Command="{Binding ToggleLessonCompletionCommand}" />
            </ContextMenu>
        </controls:MediaDetailsPage.ActionsMenu>
        <controls:MediaDetailsPage.MainDetailsContent>
            <StackPanel>
                <Grid SizeChanged="OnPreviewSizeChanged">
                    <controls:VideoPlayer Player="{Binding Player}" />
                </Grid>
                <StackPanel Margin="8,20,8,0">
                    <TextBlock Style="{StaticResource Text.Metadata}" Text="{Binding SelectedLessonPositionText}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.SubsectionTitle}" Text="{Binding SelectedLesson.Title}"
                               TextWrapping="Wrap" ToolTip="{Binding SelectedLesson.FilePath}" />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding SelectedLesson.Runtime}" />
                        <TextBlock Margin="8,0" Style="{StaticResource Text.Metadata}" Text="&#x2022;" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding SelectedLesson.CompletionStatus}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding Player.TogglePlaybackCommand}" Style="{StaticResource Button.Primary}">
                            <Button.Content>
                                <MultiBinding Converter="{StaticResource MediaPlayActionConverter}">
                                    <Binding Path="Player.PlayActionText" /><Binding Path="SelectedLesson.PlayActionText" />
                                </MultiBinding>
                            </Button.Content>
                        </Button>
                        <Button Margin="0,0,8,8" Command="{Binding NextLessonCommand}" Content="Next &#x23ED;"
                                Style="{StaticResource Course.Secondary}" AutomationProperties.Name="Next lesson" />
                        <Button Margin="0,0,0,8" Command="{Binding ToggleFavoriteCommand}" ToolTip="{Binding FavoriteActionText}"
                                AutomationProperties.Name="{Binding FavoriteActionText}">
                            <Button.ContentTemplate><DataTemplate><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="{Binding}" /></DataTemplate></Button.ContentTemplate>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                    <Setter Property="Content" Value="&#xEB51;" />
                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedLesson.IsFavorite}" Value="True">
                                        <Setter Property="Content" Value="&#xEB52;" /><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0" Text="{Binding SelectedLesson.Description}">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                            </Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" Text="File unavailable" Foreground="{DynamicResource Brush.Warning}">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding SelectedLesson.IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,16,0,0" Text="No lessons have been found in this course yet.">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasLessons}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </controls:MediaDetailsPage.MainDetailsContent>
        <controls:MediaDetailsPage.SidebarContent>
            <StackPanel>
                <TextBlock Margin="4,0,4,6" Style="{StaticResource Text.Metadata}" Text="{Binding CourseProgressText}" />
                <ProgressBar Height="3" Margin="4,0,4,14" Minimum="0" Maximum="100"
                             Background="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.Accent}"
                             Value="{Binding CourseProgressPercentage, Mode=OneWay}" Template="{StaticResource Course.ProgressTemplate}"
                             AutomationProperties.Name="Course progress" />
                <TextBlock Text="{Binding OrderStatus}" AutomationProperties.LiveSetting="Polite" Margin="4,0,4,8" Style="{StaticResource Text.Metadata}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Lessons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Course.Row}"
                                        Command="{Binding DataContext.SelectLessonCommand, RelativeSource={RelativeSource AncestorType=controls:MediaDetailsPage}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                    <Button.ToolTip><StackPanel MaxWidth="480">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding FilePath}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding Availability}" />
                                    </StackPanel></Button.ToolTip>
                                    <StackPanel>
                                        <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <TextBlock.Text><MultiBinding StringFormat="{}{0} &#xB7; {1}"><Binding Path="NumberText" /><Binding Path="Title" /></MultiBinding></TextBlock.Text>
                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" /></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
                                                <Setter Property="Text" Value="{Binding CompletionStatus}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Text" Value="File unavailable" /><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <Button Style="{StaticResource Course.Reorder}" Width="24" Height="24" MinHeight="24" Content="&#x2191;" ToolTip="Move lesson up" AutomationProperties.Name="Move lesson up"
                                            Command="{Binding DataContext.MoveLessonUpCommand, RelativeSource={RelativeSource AncestorType=controls:MediaDetailsPage}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Course.Reorder}" Width="24" Height="24" MinHeight="24" Content="&#x2193;" ToolTip="Move lesson down" AutomationProperties.Name="Move lesson down"
                                            Command="{Binding DataContext.MoveLessonDownCommand, RelativeSource={RelativeSource AncestorType=controls:MediaDetailsPage}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="4,16,4,4" Style="{StaticResource Text.Metadata}" TextWrapping="Wrap">
                    <TextBlock.Text><MultiBinding StringFormat="{}{0} total &#xB7; {1} remaining"><Binding Path="TotalDurationText" /><Binding Path="RemainingDurationText" /></MultiBinding></TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </controls:MediaDetailsPage.SidebarContent>
        <controls:MediaDetailsPage.EditorContent>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="22,18,22,0">
                    <TextBlock Style="{StaticResource Text.Metadata}" Text="{Binding SelectedLessonPositionText}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}" Text="{Binding SelectedLesson.Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
                <controls:MediaDetailsEditor Grid.Row="1" />
            </Grid>
        </controls:MediaDetailsPage.EditorContent>
    </controls:MediaDetailsPage>
</UserControl>
