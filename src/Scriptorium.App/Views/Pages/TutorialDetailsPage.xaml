<UserControl
    x:Class="Scriptorium.App.Views.Pages.TutorialDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Spacing.XL}" MaxWidth="800">
            <Button
                HorizontalAlignment="Left"
                Command="{Binding BackCommand}"
                Content="Back to library"
                Style="{StaticResource Button.Secondary}" />
            <TextBlock
                Margin="0,24,0,0"
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="{StaticResource Brush.TextPrimary}"
                Text="{Binding Title}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{StaticResource Brush.TextSecondary}"
                Text="{Binding SourceFolder}" />
            <WrapPanel Margin="0,16,0,0">
                <TextBlock
                    Foreground="{StaticResource Brush.TextMuted}"
                    Text="{Binding LessonCountText}" />
                <TextBlock
                    Margin="16,0,0,0"
                    Foreground="{StaticResource Brush.TextMuted}"
                    Text="Total duration:" />
                <TextBlock
                    Margin="6,0,0,0"
                    Foreground="{StaticResource Brush.TextMuted}"
                    Text="{Binding TotalDurationText}" />
            </WrapPanel>
            <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            Foreground="{StaticResource Brush.TextMuted}"
                            Text="{Binding SelectedLessonPositionText}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedLesson.Title}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding PreviousLessonCommand}"
                            Content="Previous lesson"
                            Style="{StaticResource Button.Secondary}" />
                        <Button
                            Command="{Binding NextLessonCommand}"
                            Content="Next lesson"
                            Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </Grid>
            </Border>
            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Lessons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10">
                            <Border.Style>
                                <Style BasedOn="{StaticResource Card}" TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Foreground="{StaticResource Brush.Accent}"
                                        Text="{Binding Position}" />
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Runtime}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Runtime}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTip="{Binding Title}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{StaticResource Brush.TextMuted}"
                                        Text="{Binding FilePath}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Foreground="{StaticResource Brush.TextSecondary}"
                                        Text="{Binding Availability}" />
                                    <Button
                                        Margin="0,8,0,0"
                                        Command="{Binding DataContext.SelectLessonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Select"
                                        Style="{StaticResource Button.Secondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
