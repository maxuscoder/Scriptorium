<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ScrollBar.TrackButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBar.VerticalThumb" TargetType="Thumb">
        <Setter Property="MinHeight" Value="{StaticResource Control.Height.Compact}" />
        <Setter Property="Background" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        Margin="{StaticResource ScrollBar.ThumbInset}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource CornerRadius.XS}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.TextSecondary}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ScrollBar.HorizontalThumb" TargetType="Thumb" BasedOn="{StaticResource ScrollBar.VerticalThumb}">
        <Setter Property="MinWidth" Value="{StaticResource Control.Height.Default}" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <ControlTemplate x:Key="ScrollBar.VerticalTemplate" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Border
                Width="{StaticResource ScrollBar.TrackSize}"
                HorizontalAlignment="Center"
                Background="{DynamicResource Brush.SurfaceElevated}"
                CornerRadius="{StaticResource CornerRadius.XS}" />
            <Track x:Name="PART_Track" Width="{StaticResource ScrollBar.TrackSize}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.PageUpCommand"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}"
                        Style="{StaticResource ScrollBar.TrackButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.VerticalThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.PageDownCommand"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}"
                        Style="{StaticResource ScrollBar.TrackButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="ScrollBar.HorizontalTemplate" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Border
                Height="{StaticResource ScrollBar.TrackSize}"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.SurfaceElevated}"
                CornerRadius="{StaticResource CornerRadius.XS}" />
            <Track x:Name="PART_Track" Height="{StaticResource ScrollBar.TrackSize}" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.PageLeftCommand"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}"
                        Style="{StaticResource ScrollBar.TrackButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.HorizontalThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.PageRightCommand"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}"
                        Style="{StaticResource ScrollBar.TrackButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource ScrollBar.VerticalTemplate}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource ScrollBar.HorizontalTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
