<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Padding.Control}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource CornerRadius.S}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="Button.Primary"
        BasedOn="{StaticResource Button.Base}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.AccentStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="Button.Secondary"
        BasedOn="{StaticResource Button.Base}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="Button.Destructive"
        BasedOn="{StaticResource Button.Base}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.86" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="Button.Icon"
        BasedOn="{StaticResource Button.Base}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Control.Height.Default}" />
        <Setter Property="Height" Value="{StaticResource Control.Height.Default}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="NavigationItemButton"
        BasedOn="{StaticResource Button.Base}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource CornerRadius.M}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.AccentSurface}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="NavigationItemButton.Premium"
        BasedOn="{StaticResource NavigationItemButton}"
        TargetType="Button">
        <Setter Property="Height" Value="48" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border
                            x:Name="SelectionIndicator"
                            Width="3"
                            Margin="0,10,0,10"
                            HorizontalAlignment="Left"
                            Background="{StaticResource Brush.Accent}"
                            CornerRadius="{StaticResource CornerRadius.Pill}"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0.45" />
                            </Border.RenderTransform>
                        </Border>
                        <Border
                            x:Name="Surface"
                            Margin="4,0,0,0"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadius.M}"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PressScale" />
                                    <TranslateTransform x:Name="HoverTranslate" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="SelectionIndicator" Property="Opacity" Value="1" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SelectionIndicator"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="{StaticResource Motion.Duration.Standard}" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource Motion.Easing.Enter}"
                                            Storyboard.TargetName="SelectionIndicator"
                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                            To="1"
                                            Duration="{StaticResource Motion.Duration.Deliberate}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SelectionIndicator"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SelectionIndicator"
                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                            To="0.45"
                                            Duration="{StaticResource Motion.Duration.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        EasingFunction="{StaticResource Motion.Easing.Enter}"
                                        Storyboard.TargetName="HoverTranslate"
                                        Storyboard.TargetProperty="X"
                                        To="2"
                                        Duration="{StaticResource Motion.Duration.Standard}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        EasingFunction="{StaticResource Motion.Easing.Exit}"
                                        Storyboard.TargetName="HoverTranslate"
                                        Storyboard.TargetProperty="X"
                                        To="0"
                                        Duration="{StaticResource Motion.Duration.Fast}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="PressScale"
                                        Storyboard.TargetProperty="ScaleX"
                                        To="0.985"
                                        Duration="{StaticResource Motion.Duration.Instant}" />
                                    <DoubleAnimation
                                        Storyboard.TargetName="PressScale"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="0.94"
                                        Duration="{StaticResource Motion.Duration.Instant}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        EasingFunction="{StaticResource Motion.Easing.Enter}"
                                        Storyboard.TargetName="PressScale"
                                        Storyboard.TargetProperty="ScaleX"
                                        To="1"
                                        Duration="{StaticResource Motion.Duration.Fast}" />
                                    <DoubleAnimation
                                        EasingFunction="{StaticResource Motion.Easing.Enter}"
                                        Storyboard.TargetName="PressScale"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="1"
                                        Duration="{StaticResource Motion.Duration.Fast}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.NavigationSelected}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentSurface}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.NavigationHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.NavigationSelected}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            </MultiDataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.SurfaceOverlay}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.M}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
        <Setter Property="Effect" Value="{StaticResource Elevation.1}" />
    </Style>
    <Style x:Key="Input.TextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Input}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Input.ComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Input}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Dialog.Surface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.L}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.XL}" />
        <Setter Property="Effect" Value="{StaticResource Elevation.3}" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.AccentSurface}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.S}" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Brush.Border}" />
    </Style>
    <Style x:Key="Toggle.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid
                        Width="42"
                        Height="22"
                        Background="Transparent">

                        <!--  Track  -->
                        <Border
                            x:Name="Track"
                            Background="{StaticResource Brush.SurfaceOverlay}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="11">

                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="4"
                                    Opacity="0.10"
                                    ShadowDepth="0" />
                            </Border.Effect>
                        </Border>

                        <!--  Thumb  -->
                        <Border
                            x:Name="Thumb"
                            Width="16"
                            Height="16"
                            Margin="3,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brush.TextSecondary}"
                            CornerRadius="8">

                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="3"
                                    Opacity="0.30"
                                    ShadowDepth="1" />
                            </Border.Effect>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!--  Checked  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent}" />

                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />

                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />

                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />

                            <Setter TargetName="Thumb" Property="Background" Value="White" />
                        </Trigger>

                        <!--  Hover  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                        </Trigger>

                        <!--  Keyboard focus  -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />

                            <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                        </Trigger>

                        <!--  Disabled  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Page.Enter" TargetType="UserControl">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="4" />
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            EasingFunction="{StaticResource Motion.Easing.Enter}"
                            Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                            To="0"
                            Duration="{StaticResource Motion.Duration.Fast}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
