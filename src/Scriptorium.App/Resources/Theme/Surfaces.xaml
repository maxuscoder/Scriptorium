<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThickness.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Surface}" />
    </Style>
    <Style x:Key="Surface.Elevated" TargetType="Border" BasedOn="{StaticResource Surface}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
    </Style>
    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Surface}">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
        <Setter Property="Effect" Value="{StaticResource Elevation.0}" />
    </Style>
    <Style x:Key="Surface.Flyout" TargetType="Border" BasedOn="{StaticResource Surface.Elevated}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.S}" />
        <Setter Property="Effect" Value="{StaticResource Elevation.2}" />
    </Style>
    <Style x:Key="Dialog.Surface" TargetType="Border" BasedOn="{StaticResource Surface.Elevated}">
        <Setter Property="Padding" Value="{StaticResource Spacing.L}" />
        <Setter Property="Effect" Value="{StaticResource Elevation.3}" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceOverlay}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Badge}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Badge}" />
    </Style>
    <Style x:Key="Badge.Active" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThickness.Hairline}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource Stroke.Hairline}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
    </Style>
    <Style x:Key="Section.Header" TargetType="ContentControl">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.SectionTitle}" /></DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.SectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="{StaticResource Margin.SectionHeader}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="Input.SearchField" TargetType="Border" BasedOn="{StaticResource Surface.Elevated}">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Input}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
