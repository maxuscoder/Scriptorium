<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Scriptorium.App.Behaviors"
    xmlns:controls="clr-namespace:Scriptorium.App.Views.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Buttons.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!--  Shell-only tokens. Shared controls and page content retain the Phase 1 system.  -->
    <sys:Double x:Key="Shell.Sidebar.Width">232</sys:Double>
    <sys:Double x:Key="Shell.Sidebar.MinWidth">180</sys:Double>
    <sys:Double x:Key="Shell.Sidebar.MaxWidth">360</sys:Double>
    <sys:Double x:Key="Shell.Sidebar.ResizeHitWidth">8</sys:Double>
    <sys:Double x:Key="Shell.Sidebar.CompactWidth">72</sys:Double>
    <sys:Double x:Key="Shell.Sidebar.CompactThreshold">1000</sys:Double>
    <sys:Double x:Key="Shell.Brand.Height">64</sys:Double>
    <sys:Double x:Key="Shell.Indicator.Width">3</sys:Double>
    <sys:Double x:Key="Shell.Indicator.Height">16</sys:Double>
    <Thickness x:Key="Shell.Padding">12,8,12,12</Thickness>
    <!--  Keep the branding-to-navigation gap at 16 DIPs, including the hairline.  -->
    <Thickness x:Key="Shell.Brand.Margin">8,0,0,0</Thickness>
    <Thickness x:Key="Shell.Brand.Divider.Margin">0,0,0,11</Thickness>
    <Thickness x:Key="Shell.Item.Padding">14,0</Thickness>
    <Thickness x:Key="Shell.Item.Margin">0,2</Thickness>
    <Thickness x:Key="Shell.Label.Margin">12,0,0,0</Thickness>
    <Thickness x:Key="Shell.Settings.Margin">0,12,0,0</Thickness>
    <Thickness x:Key="Shell.Settings.Padding">0,12,0,0</Thickness>
    <Thickness x:Key="Shell.Settings.Divider">0,1,0,0</Thickness>
    <CornerRadius x:Key="Shell.Item.Radius">10</CornerRadius>
    <CornerRadius x:Key="Shell.Indicator.Radius">2</CornerRadius>
    <FontFamily x:Key="Shell.FontFamily.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Duration x:Key="Shell.Motion.Sidebar">0:0:0.12</Duration>
    <Duration x:Key="Shell.Motion.Hover">0:0:0.16</Duration>
    <Duration x:Key="Shell.Motion.Selection">0:0:0.15</Duration>

    <Style
        x:Key="Shell.Brand"
        BasedOn="{StaticResource Text.Brand}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.PanelTitle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource Shell.Label.Margin}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type controls:Sidebar}}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Shell.Sidebar.ResizeHandle" TargetType="Thumb">
        <Setter Property="Width" Value="{StaticResource Shell.Sidebar.ResizeHitWidth}" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Keyboard}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border
                            x:Name="Line"
                            Width="1"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource Brush.Border}"
                            Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="Shell.NavigationItem"
        BasedOn="{StaticResource Button.Base}"
        TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Control.Height.Default}" />
        <Setter Property="Padding" Value="{StaticResource Shell.Item.Padding}" />
        <Setter Property="Margin" Value="{StaticResource Shell.Item.Margin}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border
                            x:Name="Hover"
                            behaviors:OpacityTransition.Duration="{StaticResource Shell.Motion.Hover}"
                            Background="{DynamicResource Brush.Sidebar.Hover}"
                            CornerRadius="{StaticResource Shell.Item.Radius}"
                            Opacity="0" />
                        <Border
                            x:Name="Selected"
                            behaviors:OpacityTransition.Duration="{StaticResource Shell.Motion.Selection}"
                            Background="{DynamicResource Brush.Sidebar.Selected}"
                            BorderBrush="{DynamicResource Brush.Sidebar.Highlight}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Shell.Item.Radius}"
                            Opacity="0" />
                        <Border
                            x:Name="Pressed"
                            behaviors:OpacityTransition.Duration="{StaticResource Shell.Motion.Hover}"
                            Background="{DynamicResource Brush.Sidebar.Pressed}"
                            CornerRadius="{StaticResource Shell.Item.Radius}"
                            Opacity="0" />
                        <Border
                            x:Name="Indicator"
                            Width="{StaticResource Shell.Indicator.Width}"
                            Height="{StaticResource Shell.Indicator.Height}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            behaviors:OpacityTransition.Duration="{StaticResource Shell.Motion.Selection}"
                            Background="{DynamicResource Brush.Sidebar.Accent}"
                            CornerRadius="{StaticResource Shell.Indicator.Radius}"
                            Opacity="0" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="behaviors:OpacityTransition.Target" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pressed" Property="behaviors:OpacityTransition.Target" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Selected" Property="behaviors:OpacityTransition.Target" Value="1" />
                            <Setter TargetName="Indicator" Property="behaviors:OpacityTransition.Target" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type controls:Sidebar}}}" Value="True">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Shell.NavigationIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Shell.FontFamily.Icons}" />
        <Setter Property="FontSize" Value="{StaticResource Icon.Size.Default}" />
        <Setter Property="Width" Value="{StaticResource Icon.Size.Default}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="behaviors:BrushTransition.Duration" Value="{StaticResource Shell.Motion.Hover}" />
        <Setter Property="behaviors:BrushTransition.ForegroundTarget" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Label}" Value="Home">
                <Setter Property="Text" Value="&#xE80F;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Label}" Value="Library">
                <Setter Property="Text" Value="&#xE8F1;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Label}" Value="Favorites">
                <Setter Property="Text" Value="&#xE734;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Label}" Value="Categories">
                <Setter Property="Text" Value="&#xE8EC;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Label}" Value="Settings">
                <Setter Property="Text" Value="&#xE713;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="behaviors:BrushTransition.ForegroundTarget" Value="{DynamicResource Brush.Sidebar.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="Shell.ExpandedText"
        BasedOn="{StaticResource Text.Navigation}"
        TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource Shell.Label.Margin}" />
        <Setter Property="behaviors:BrushTransition.Duration" Value="{StaticResource Shell.Motion.Hover}" />
        <Setter Property="behaviors:BrushTransition.ForegroundTarget" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type controls:Sidebar}}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
