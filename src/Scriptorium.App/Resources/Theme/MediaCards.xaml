<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:behaviors="clr-namespace:Scriptorium.App.Behaviors">
    <sys:Double x:Key="MediaCard.Width">260</sys:Double>
    <sys:Double x:Key="MediaCard.ListArtworkWidth">160</sys:Double>
    <sys:Double x:Key="MediaCard.ArtworkRatio">2.14</sys:Double>
    <sys:Double x:Key="MediaCard.Artwork.Zoom">1.04</sys:Double>
    <sys:Double x:Key="MediaCard.Artwork.RestOpacity">0.94</sys:Double>
    <sys:Double x:Key="MediaCard.Progress.Height">4</sys:Double>
    <Duration x:Key="MediaCard.Motion.Duration">0:0:0.18</Duration>
    <sys:Int32 x:Key="MediaCard.ToolTip.Delay">800</sys:Int32>
    <sys:Int32 x:Key="MediaCard.ToolTip.Duration">6000</sys:Int32>
    <Thickness x:Key="MediaCard.Margin">4,4,16,16</Thickness>
    <Thickness x:Key="MediaCard.Copy.Margin">12,8,44,10</Thickness>
    <Thickness x:Key="MediaCard.Copy.ListMargin">16,8,44,10</Thickness>
    <Thickness x:Key="MediaCard.More.Margin">0,3,6,0</Thickness>
    <Thickness x:Key="MediaCard.Metadata.Margin">0,4,0,0</Thickness>
    <Thickness x:Key="MediaCard.Actions.Margin">8</Thickness>
    <Thickness x:Key="MediaCard.Action.Gap">0,0,8,0</Thickness>
    <SolidColorBrush x:Key="MediaCard.Brush.Progress" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="MediaCard.Brush.Action" Color="#E616171A" />
    <SolidColorBrush x:Key="MediaCard.Brush.ActionHover" Color="#F025272C" />
    <SolidColorBrush x:Key="MediaCard.Brush.Icon" Color="#F5F5F7" />
    <SolidColorBrush x:Key="MediaCard.Brush.FallbackIcon" Color="#73737A" />
    <LinearGradientBrush x:Key="MediaCard.Brush.Fallback" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#202026" Offset="0" />
        <GradientStop Color="#131316" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MediaCard.Brush.HoverScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#10000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="0.35" />
        <GradientStop Color="#C0000000" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="MediaCard.Surface" TargetType="Border">
        <Setter Property="behaviors:BrushTransition.Target" Value="{DynamicResource Brush.Card.Surface}" />
        <Setter Property="behaviors:BrushTransition.Duration" Value="{StaticResource MediaCard.Motion.Duration}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThickness.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEngaged, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter Property="behaviors:BrushTransition.Target" Value="{DynamicResource Brush.Card.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.BorderHover}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <FontFamily x:Key="MediaCard.FontFamily.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="MediaCard.Action" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Control}" />
        <Setter Property="Foreground" Value="{StaticResource MediaCard.Brush.Icon}" />
        <Setter Property="Background" Value="{StaticResource MediaCard.Brush.Action}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Frame" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}" BorderThickness="{StaticResource BorderThickness.Hairline}" BorderBrush="{DynamicResource Brush.BorderStrong}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource MediaCard.Brush.ActionHover}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="{StaticResource Opacity.Disabled}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="{StaticResource Opacity.Disabled}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="MediaCard.IconAction" TargetType="Button" BasedOn="{StaticResource MediaCard.Action}">
        <Setter Property="Width" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="Height" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderBrush" Value="#66565A62" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource MediaCard.FontFamily.Icons}" />
        <Setter Property="FontSize" Value="{StaticResource Icon.Size.Compact}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Frame" Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
        <!-- Explicit glyph text avoids the application's implicit TextBlock font overriding icons. -->
        <Setter Property="ContentTemplate"><Setter.Value>
            <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="{StaticResource MediaCard.FontFamily.Icons}"
                    FontSize="{StaticResource Icon.Size.Compact}"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </DataTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="MediaCard.PlayAction" TargetType="Button" BasedOn="{StaticResource MediaCard.Action}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource MediaCard.Brush.Icon}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="MediaCard.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="{StaticResource MediaCard.Progress.Height}" />
        <Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource MediaCard.Brush.Progress}" />
        <Setter Property="Background" Value="{DynamicResource Brush.ProgressTrack}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
                <Grid x:Name="PART_Track" ClipToBounds="True">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="MediaCard.MoreAction" TargetType="Button" BasedOn="{StaticResource MediaCard.IconAction}">
        <Setter Property="Width" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="Height" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource MediaCard.FontFamily.Icons}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SurfaceOverlay}" /><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}" /></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
