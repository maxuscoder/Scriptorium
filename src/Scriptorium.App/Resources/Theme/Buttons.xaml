<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:Scriptorium.App.Behaviors">
    <!-- Shared, restrained 3D treatment for primary actions. -->
    <LinearGradientBrush x:Key="Brush.PrimaryButton.Normal" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="{DynamicResource Color.PrimaryButton.NormalHighlight}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.PrimaryButton.NormalMid}" Offset="0.26" />
        <GradientStop Color="{DynamicResource Color.PrimaryButton.NormalBase}" Offset="0.72" />
        <GradientStop Color="{DynamicResource Color.PrimaryButton.NormalBase}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PrimaryButton.Hover" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="{DynamicResource Color.PrimaryButton.HoverHighlight}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.PrimaryButton.HoverMid}" Offset="0.26" />
        <GradientStop Color="{DynamicResource Color.PrimaryButton.HoverBase}" Offset="0.72" />
        <GradientStop Color="{DynamicResource Color.PrimaryButton.HoverBase}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PrimaryButton.Pressed" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="{DynamicResource Color.PrimaryButton.PressedHighlight}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.PrimaryButton.PressedMid}" Offset="0.34" />
        <GradientStop Color="{DynamicResource Color.PrimaryButton.PressedBase}" Offset="0.78" />
        <GradientStop Color="{DynamicResource Color.PrimaryButton.PressedBase}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PrimaryButton.Disabled" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="{DynamicResource Color.PrimaryButton.DisabledHighlight}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.PrimaryButton.DisabledMid}" Offset="0.38" />
        <GradientStop Color="{DynamicResource Color.PrimaryButton.DisabledBase}" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Effect.PrimaryButton.Elevation" Color="#000000" ShadowDepth="2" BlurRadius="6" Opacity="0.32" />
    <DropShadowEffect x:Key="Effect.PrimaryButton.HoverElevation" Color="#000000" ShadowDepth="3" BlurRadius="7" Opacity="0.40" />
    <DropShadowEffect x:Key="Effect.PrimaryButton.FocusElevation" Color="{DynamicResource Color.FocusRing}" ShadowDepth="0" BlurRadius="7" Opacity="0.48" />
    <DropShadowEffect x:Key="Effect.PrimaryButton.FocusHoverElevation" Color="{DynamicResource Color.FocusRing}" ShadowDepth="1" BlurRadius="8" Opacity="0.55" />
    <!-- Adorner focus is keyboard-only and does not move the control's content. -->
    <Style x:Key="Focus.Keyboard" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="{StaticResource Margin.Focus}" BorderBrush="{DynamicResource Brush.FocusRing}"
                            BorderThickness="{StaticResource BorderThickness.Focus}" CornerRadius="{StaticResource Radius.Control}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="{StaticResource Padding.Control}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThickness.Hairline}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Keyboard}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Padding}"
                            behaviors:BrushTransition.Target="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                            behaviors:BrushTransition.Duration="{StaticResource Motion.Duration.Instant}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryButton.Depth}" />
        <Setter Property="Tag" Value="{DynamicResource Brush.PrimaryButton.Normal}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryButton.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <!-- The base stays behind the surface to provide elevation without a visible lower lip. -->
                        <Border x:Name="Depth"
                                Background="{TemplateBinding Background}"
                                behaviors:BrushTransition.Target="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                behaviors:BrushTransition.Duration="{StaticResource Motion.Duration.Instant}"
                                CornerRadius="8"
                                Effect="{StaticResource Effect.PrimaryButton.Elevation}" />
                        <Border x:Name="Surface"
                                Background="{DynamicResource Brush.PrimaryButton.Normal}"
                                behaviors:BrushTransition.Target="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                behaviors:BrushTransition.Duration="{StaticResource Motion.Duration.Standard}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="ContentHost" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Depth" Property="Effect" Value="{StaticResource Effect.PrimaryButton.FocusElevation}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.PrimaryButton.HoverDepth}" />
                            <Setter Property="Tag" Value="{DynamicResource Brush.PrimaryButton.Hover}" />
                            <Setter TargetName="Depth" Property="Effect" Value="{StaticResource Effect.PrimaryButton.HoverElevation}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Depth" Property="Effect" Value="{StaticResource Effect.PrimaryButton.FocusHoverElevation}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.PrimaryButton.PressedDepth}" />
                            <Setter Property="Tag" Value="{DynamicResource Brush.PrimaryButton.Pressed}" />
                            <Setter TargetName="Depth" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Background" Value="{DynamicResource Brush.PrimaryButton.DisabledDepth}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryButton.DisabledText}" />
                            <Setter Property="Tag" Value="{DynamicResource Brush.PrimaryButton.Disabled}" />
                            <Setter TargetName="Depth" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- State visuals live in the template so the raised surface and content move together. -->
        </Style.Triggers>
    </Style>
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceOverlay}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Button.Destructive" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnDanger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.DangerHover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.DangerPressed}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Button.Text" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Text}">
        <Setter Property="Width" Value="{StaticResource Control.Height.Default}" />
        <Setter Property="Height" Value="{StaticResource Control.Height.Default}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.None}" />
    </Style>
    <Style x:Key="Button.RoundIcon" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#191B20" />
        <Setter Property="BorderBrush" Value="#292C32" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="999"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#24272D" />
                <Setter Property="BorderBrush" Value="#3A3D44" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#2C3037" />
                <Setter Property="BorderBrush" Value="#444851" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CategoryColorSwatch" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Width" Value="{StaticResource Control.Height.Compact}" />
        <Setter Property="Height" Value="{StaticResource Control.Height.Compact}" />
        <Setter Property="Margin" Value="{StaticResource Spacing.XXS}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.None}" />
        <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}" />
</ResourceDictionary>
