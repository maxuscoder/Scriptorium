<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:behaviors="clr-namespace:Scriptorium.App.Behaviors"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Input.TextBox" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Keyboard}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height.Input}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThickness.Hairline}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Input}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="InputSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource Radius.Input}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
            </Trigger>
        
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SurfaceOverlay}" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" /></Trigger>
            <Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Input.SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="Input.ComboBox" TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Keyboard}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height.Input}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThickness.Hairline}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Input}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MaxWidth" Value="{StaticResource Control.MaxWidth.Flyout}" />
        <Setter Property="MaxDropDownHeight" Value="{StaticResource Control.MaxHeight.Flyout}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            x:Name="PART_ToggleButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                            Foreground="{TemplateBinding Foreground}"
                            IsEnabled="{TemplateBinding IsEnabled}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Padding="{TemplateBinding Padding}"
                            ClickMode="Press"
                            Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        x:Name="ComboSurface"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{StaticResource Radius.Input}">
                                        <Grid>
                                            <ContentPresenter Margin="{StaticResource Padding.ComboContent}"
                                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" VerticalAlignment="Center" />
                                            <Path
                                                Width="{StaticResource Icon.Width.Chevron}"
                                                Height="{StaticResource Icon.Height.Chevron}"
                                                Margin="{StaticResource Margin.InputChevron}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Data="M0,0 L5,5 L10,0"
                                                Stroke="{DynamicResource Brush.TextSecondary}"
                                                StrokeThickness="{StaticResource Stroke.Icon}" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            MaxHeight="{StaticResource Control.MaxHeight.Flyout}"
                            MaxWidth="{StaticResource Control.MaxWidth.Flyout}"
                            Placement="Bottom"
                            PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            PopupAnimation="None"
                            StaysOpen="False"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border
                                Margin="{StaticResource Margin.Flyout}"
                                Background="{DynamicResource Brush.SurfaceElevated}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Input}"
                                HorizontalAlignment="Stretch">
                                <ScrollViewer
                                    behaviors:DropdownScrollBehavior.IsEnabled="True"
                                    CanContentScroll="False"
                                    Focusable="True"
                                    HorizontalScrollBarVisibility="Disabled"
                                    MaxHeight="{StaticResource Control.MaxHeight.Flyout}"
                                    PanningMode="VerticalOnly"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter Property="IsEnabled" Value="False" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
            </Trigger>
        
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SurfaceOverlay}" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" /></Trigger>
            <Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Input.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="{StaticResource Padding.Input}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="ItemSurface"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource Radius.Control}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.SurfaceOverlay}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.SelectionSurface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource Input.ComboBox}" />
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Input.ComboBoxItem}" />
</ResourceDictionary>
