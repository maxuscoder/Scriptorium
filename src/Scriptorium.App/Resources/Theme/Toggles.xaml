<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:Scriptorium.App.Behaviors">
    <Style x:Key="Toggle.Filter" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Control}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThickness.Hairline}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Keyboard}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border behaviors:BrushTransition.Target="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                            behaviors:BrushTransition.Duration="{StaticResource Motion.Duration.Fast}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SurfaceOverlay}" /></Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Filter}" />
    <Style x:Key="Toggle.CheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Keyboard}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="{StaticResource Icon.Size.Default}" Height="{StaticResource Icon.Size.Default}"
                                VerticalAlignment="Center" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{StaticResource BorderThickness.Hairline}" CornerRadius="{StaticResource CornerRadius.XS}">
                            <TextBlock x:Name="Check" Text="&#x2713;" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextOnAccent}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="{StaticResource Margin.IconLabel}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SurfaceOverlay}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Check" Property="Text" Value="&#x2212;" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Toggle.Switch" TargetType="CheckBox" BasedOn="{StaticResource Toggle.CheckBox}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="{StaticResource Control.MinHitTarget}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="{StaticResource Control.MinHitTarget}">
                        <Border x:Name="Track" Width="{StaticResource Control.Width.Switch}" Height="{StaticResource Control.Height.Switch}"
                                VerticalAlignment="Center" Background="{DynamicResource Brush.SurfaceOverlay}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="{StaticResource BorderThickness.Hairline}"
                                CornerRadius="{StaticResource Radius.Switch}">
                            <Border x:Name="Thumb" Width="{StaticResource Control.Size.SwitchThumb}" Height="{StaticResource Control.Size.SwitchThumb}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{StaticResource Margin.Switch.Off}"
                                    Background="{DynamicResource Brush.TextSecondary}" CornerRadius="{StaticResource Radius.SwitchThumb}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.SurfacePressed}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource Brush.TextOnAccent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="{StaticResource Margin.Switch.On}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource Toggle.CheckBox}" />
    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Keyboard}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.MinHitTarget}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
