<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Dark-content atmosphere only. Light/System backgrounds still use Brush.Background. -->
    <Color x:Key="Color.ContentAtmosphere.Base">#0D0E11</Color>
    <Color x:Key="Color.ContentAtmosphere.Graphite">#17191F</Color>
    <Color x:Key="Color.ContentAtmosphere.Cool">#5B6A80</Color>
    <Color x:Key="Color.ContentAtmosphere.Warm">#C65A25</Color>
    <sys:Double x:Key="ContentAtmosphere.CenterLift">0.64</sys:Double>
    <sys:Double x:Key="ContentAtmosphere.CoolAmount">0.25</sys:Double>
    <!-- About 30% of the original 0.34 warm-light design strength. -->
    <sys:Double x:Key="ContentAtmosphere.WarmAmount">0.102</sys:Double>
    <sys:Double x:Key="ContentAtmosphere.DiagonalDepth">6</sys:Double>
    <!-- Fluent Cinema. Eight-digit WPF colors are #AARRGGBB, not CSS #RRGGBBAA. -->
    <Color x:Key="Color.Background">#0B0B0D</Color>
    <Color x:Key="Color.AmbientBase">#000000</Color>
    <SolidColorBrush x:Key="Brush.AmbientBase" Color="{StaticResource Color.AmbientBase}" />
    <Color x:Key="Color.Surface">#101012</Color>
    <Color x:Key="Color.SurfaceHeader">#181A20</Color>
    <Color x:Key="Color.SurfaceElevated">#17171A</Color>
    <Color x:Key="Color.SurfaceOverlay">#363944</Color>
    <Color x:Key="Color.NavigationSelected">#0AFFFFFF</Color>
    <SolidColorBrush x:Key="Brush.NavigationSelected" Color="{StaticResource Color.NavigationSelected}" />
    <!-- Sidebar surface roles share the app accent palette. -->
    <Color x:Key="Color.Sidebar.Background">#EB282B34</Color>
    <Color x:Key="Color.Sidebar.Selected">#E3444753</Color>
    <Color x:Key="Color.Sidebar.Hover">#2D2D32</Color>
    <Color x:Key="Color.Sidebar.Pressed">#39393F</Color>
    <Color x:Key="Color.Sidebar.Highlight">#0CFFFFFF</Color>
    <Color x:Key="Color.Sidebar.Accent">#FF6508</Color>
    <!-- A uniform graphite surface avoids quantized bands in very dark gradients. -->
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="{StaticResource Color.Sidebar.Background}" />
    <SolidColorBrush x:Key="Brush.Sidebar.Selected" Color="{StaticResource Color.Sidebar.Selected}" />
    <SolidColorBrush x:Key="Brush.Sidebar.Hover" Color="{StaticResource Color.Sidebar.Hover}" />
    <SolidColorBrush x:Key="Brush.Sidebar.Pressed" Color="{StaticResource Color.Sidebar.Pressed}" />
    <SolidColorBrush x:Key="Brush.Sidebar.Highlight" Color="{StaticResource Color.Sidebar.Highlight}" />
    <SolidColorBrush x:Key="Brush.Sidebar.Accent" Color="{StaticResource Color.Sidebar.Accent}" />
    <Color x:Key="Color.SurfacePressed">#292C34</Color>
    <Color x:Key="Color.Border">#12FFFFFF</Color>
    <Color x:Key="Color.BorderStrong">#1CFFFFFF</Color>
    <Color x:Key="Color.Accent">#FF6508</Color>
    <Color x:Key="Color.AccentStrong">#FF8A2B</Color>
    <Color x:Key="Color.AccentPressed">#E94A00</Color>
    <Color x:Key="Color.AccentMuted">#18FF6508</Color>
    <Color x:Key="Color.AccentBorder">#55FF6508</Color>
    <!-- Primary button surface tokens. Kept separate from Accent so other orange UI cues remain flat. -->
    <Color x:Key="Color.PrimaryButton.Text">#FFFFFFFF</Color>
    <Color x:Key="Color.PrimaryButton.Depth">#D93F00</Color>
    <Color x:Key="Color.PrimaryButton.NormalHighlight">#FF8A2B</Color>
    <Color x:Key="Color.PrimaryButton.NormalMid">#FF6508</Color>
    <Color x:Key="Color.PrimaryButton.NormalBase">#F04400</Color>
    <Color x:Key="Color.PrimaryButton.HoverDepth">#E94A00</Color>
    <Color x:Key="Color.PrimaryButton.HoverHighlight">#FF9A43</Color>
    <Color x:Key="Color.PrimaryButton.HoverMid">#FF741C</Color>
    <Color x:Key="Color.PrimaryButton.HoverBase">#FF5208</Color>
    <Color x:Key="Color.PrimaryButton.PressedDepth">#B83300</Color>
    <Color x:Key="Color.PrimaryButton.PressedHighlight">#F57729</Color>
    <Color x:Key="Color.PrimaryButton.PressedMid">#E94A00</Color>
    <Color x:Key="Color.PrimaryButton.PressedBase">#D93F00</Color>
    <Color x:Key="Color.PrimaryButton.DisabledDepth">#B88A75</Color>
    <Color x:Key="Color.PrimaryButton.DisabledHighlight">#E0CFC5</Color>
    <Color x:Key="Color.PrimaryButton.DisabledMid">#D1A08B</Color>
    <Color x:Key="Color.PrimaryButton.DisabledBase">#C28B70</Color>
    <Color x:Key="Color.PrimaryButton.DisabledText">#714A3A</Color>
    <Color x:Key="Color.SelectionSurface">#18FF6508</Color>
    <Color x:Key="Color.NavigationHover">#1E1E22</Color>
    <Color x:Key="Color.Success">#63D297</Color>
    <Color x:Key="Color.SuccessSurface">#1863D297</Color>
    <Color x:Key="Color.Warning">#FF955C</Color>
    <Color x:Key="Color.WarningSurface">#18FF955C</Color>
    <Color x:Key="Color.Danger">#FF6B6B</Color>
    <Color x:Key="Color.DangerSurface">#18FF6B6B</Color>
    <Color x:Key="Color.DangerHover">#FF8585</Color>
    <Color x:Key="Color.DangerPressed">#E85C5C</Color>
    <Color x:Key="Color.TextPrimary">#F5F5F7</Color>
    <Color x:Key="Color.TextSecondary">#A7A7AD</Color>
    <Color x:Key="Color.TextMuted">#73737A</Color>
    <Color x:Key="Color.TextDisabled">#55555C</Color>
    <Color x:Key="Color.TextOnAccent">#0B0B0D</Color>
    <Color x:Key="Color.TextOnDanger">#0B0B0D</Color>
    <Color x:Key="Color.TextOnDark">#F5F5F7</Color>
    <Color x:Key="Color.FocusRing">#FF6508</Color>
    <Color x:Key="Color.Shadow">#000000</Color>
    <Color x:Key="Color.Overlay">#99000000</Color>
    <Color x:Key="Color.ArtworkScrim">#44000000</Color>
    <Color x:Key="Color.ArtworkBadge">#CC0B0B0D</Color>
    <Color x:Key="Color.ArtworkFallback">#55262626</Color>
    <Color x:Key="Color.ProgressTrack">#B32A2C31</Color>
    <Color x:Key="Color.PlaybackSurface">#000000</Color>
    <Color x:Key="Color.PlaybackFeedback">#C0000000</Color>

    <!-- Frosted graphite roles. Alpha provides depth over the shared ambient field;
         no backdrop capture, blur, or per-control effects are needed. -->
    <Color x:Key="Color.Sidebar.FrostEnd">#E31B1E25</Color>
    <Color x:Key="Color.Sidebar.SelectedEnd">#E332353F</Color>
    <Color x:Key="Color.ControlSurface.Top">#DE30323C</Color>
    <Color x:Key="Color.ControlSurface.Bottom">#EB23252D</Color>
    <Color x:Key="Color.ControlSurface.Selected">#E33B3E49</Color>
    <Color x:Key="Color.Card.Surface">#D914161C</Color>
    <Color x:Key="Color.Card.Hover">#EF1D2027</Color>
    <Color x:Key="Color.Card.Border">#FF2A2D34</Color>
    <Color x:Key="Color.Card.BorderHover">#FF383C45</Color>
    <Color x:Key="Color.ScrollBar.Default">#626570</Color>
    <Color x:Key="Color.ScrollBar.Hover">#969AA6</Color>

    <SolidColorBrush x:Key="Brush.Sidebar.FrostEnd" Color="{StaticResource Color.Sidebar.FrostEnd}" />
    <SolidColorBrush x:Key="Brush.Sidebar.SelectedEnd" Color="{StaticResource Color.Sidebar.SelectedEnd}" />
    <SolidColorBrush x:Key="Brush.ControlSurface.Top" Color="{StaticResource Color.ControlSurface.Top}" />
    <SolidColorBrush x:Key="Brush.ControlSurface.Bottom" Color="{StaticResource Color.ControlSurface.Bottom}" />
    <SolidColorBrush x:Key="Brush.ControlSurface.Selected" Color="{StaticResource Color.ControlSurface.Selected}" />
    <SolidColorBrush x:Key="Brush.Card.Surface" Color="{StaticResource Color.Card.Surface}" />
    <SolidColorBrush x:Key="Brush.Card.Hover" Color="{StaticResource Color.Card.Hover}" />
    <SolidColorBrush x:Key="Brush.Card.Border" Color="{StaticResource Color.Card.Border}" />
    <SolidColorBrush x:Key="Brush.Card.BorderHover" Color="{StaticResource Color.Card.BorderHover}" />
    <SolidColorBrush x:Key="Brush.ScrollBar.Default" Color="{StaticResource Color.ScrollBar.Default}" />
    <SolidColorBrush x:Key="Brush.ScrollBar.Hover" Color="{StaticResource Color.ScrollBar.Hover}" />
    <LinearGradientBrush x:Key="Brush.Sidebar.Frost" StartPoint="0,0" EndPoint="0.25,1">
        <GradientStop Color="{DynamicResource Color.Sidebar.Background}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.Sidebar.FrostEnd}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Sidebar.SelectedSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.Sidebar.Selected}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.Sidebar.SelectedEnd}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ControlSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.ControlSurface.Top}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.ControlSurface.Bottom}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceHeader" Color="{StaticResource Color.SurfaceHeader}" />
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}" />
    <SolidColorBrush x:Key="Brush.SurfaceOverlay" Color="{StaticResource Color.SurfaceOverlay}" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="{StaticResource Color.SurfacePressed}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentStrong" Color="{StaticResource Color.AccentStrong}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}" />
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="{StaticResource Color.AccentBorder}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.Text" Color="{StaticResource Color.PrimaryButton.Text}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.Depth" Color="{StaticResource Color.PrimaryButton.Depth}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.NormalHighlight" Color="{StaticResource Color.PrimaryButton.NormalHighlight}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.NormalMid" Color="{StaticResource Color.PrimaryButton.NormalMid}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.NormalBase" Color="{StaticResource Color.PrimaryButton.NormalBase}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.HoverDepth" Color="{StaticResource Color.PrimaryButton.HoverDepth}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.HoverHighlight" Color="{StaticResource Color.PrimaryButton.HoverHighlight}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.HoverMid" Color="{StaticResource Color.PrimaryButton.HoverMid}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.HoverBase" Color="{StaticResource Color.PrimaryButton.HoverBase}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.PressedDepth" Color="{StaticResource Color.PrimaryButton.PressedDepth}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.PressedHighlight" Color="{StaticResource Color.PrimaryButton.PressedHighlight}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.PressedMid" Color="{StaticResource Color.PrimaryButton.PressedMid}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.PressedBase" Color="{StaticResource Color.PrimaryButton.PressedBase}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.DisabledDepth" Color="{StaticResource Color.PrimaryButton.DisabledDepth}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.DisabledHighlight" Color="{StaticResource Color.PrimaryButton.DisabledHighlight}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.DisabledMid" Color="{StaticResource Color.PrimaryButton.DisabledMid}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.DisabledBase" Color="{StaticResource Color.PrimaryButton.DisabledBase}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton.DisabledText" Color="{StaticResource Color.PrimaryButton.DisabledText}" />
    <SolidColorBrush x:Key="Brush.SelectionSurface" Color="{StaticResource Color.SelectionSurface}" />
    <SolidColorBrush x:Key="Brush.NavigationHover" Color="{StaticResource Color.NavigationHover}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSurface" Color="{StaticResource Color.SuccessSurface}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSurface" Color="{StaticResource Color.WarningSurface}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSurface" Color="{StaticResource Color.DangerSurface}" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="{StaticResource Color.DangerHover}" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="{StaticResource Color.DangerPressed}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.TextOnAccent}" />
    <SolidColorBrush x:Key="Brush.TextOnDanger" Color="{StaticResource Color.TextOnDanger}" />
    <SolidColorBrush x:Key="Brush.TextOnDark" Color="{StaticResource Color.TextOnDark}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="{StaticResource Color.Shadow}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
    <SolidColorBrush x:Key="Brush.ArtworkScrim" Color="{StaticResource Color.ArtworkScrim}" />
    <SolidColorBrush x:Key="Brush.ArtworkBadge" Color="{StaticResource Color.ArtworkBadge}" />
    <SolidColorBrush x:Key="Brush.ArtworkFallback" Color="{StaticResource Color.ArtworkFallback}" />
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="{StaticResource Color.ProgressTrack}" />
    <SolidColorBrush x:Key="Brush.PlaybackSurface" Color="{StaticResource Color.PlaybackSurface}" />
    <SolidColorBrush x:Key="Brush.PlaybackFeedback" Color="{StaticResource Color.PlaybackFeedback}" />
</ResourceDictionary>
