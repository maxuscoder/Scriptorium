<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral surfaces: use hierarchy, never arbitrary dark shades. -->
    <Color x:Key="Color.Background">#171A21</Color>
    <Color x:Key="Color.Surface">#20242E</Color>
    <Color x:Key="Color.SurfaceElevated">#2B3240</Color>
    <Color x:Key="Color.SurfaceHeader">#1C2029</Color>
    <Color x:Key="Color.SurfaceOverlay">#343C4C</Color>
    <Color x:Key="Color.Border">#303746</Color>
    <Color x:Key="Color.BorderStrong">#465166</Color>

    <!-- Brand and feedback colors are semantic: consume the named role, not a hex value. -->
    <Color x:Key="Color.Accent">#668EE8</Color>
    <Color x:Key="Color.AccentStrong">#4F78D8</Color>
    <Color x:Key="Color.AccentSurface">#37435A</Color>
    <Color x:Key="Color.AccentText">#B8CDFF</Color>
    <Color x:Key="Color.Success">#4FCB8D</Color>
    <Color x:Key="Color.SuccessSurface">#1F4938</Color>
    <Color x:Key="Color.Warning">#E5A84B</Color>
    <Color x:Key="Color.WarningSurface">#4C3B20</Color>
    <Color x:Key="Color.Danger">#E57272</Color>
    <Color x:Key="Color.DangerSurface">#512D32</Color>

    <Color x:Key="Color.TextPrimary">#F4F6FA</Color>
    <Color x:Key="Color.TextSecondary">#AAB2C0</Color>
    <Color x:Key="Color.TextMuted">#7F899B</Color>
    <Color x:Key="Color.TextDisabled">#596476</Color>
    <Color x:Key="Color.TextOnAccent">#FFFFFF</Color>
    <Color x:Key="Color.FocusRing">#AFC6FF</Color>
    <Color x:Key="Color.Shadow">#000000</Color>
    <Color x:Key="Color.Overlay">#99000000</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}" />
    <SolidColorBrush x:Key="Brush.SurfaceHeader" Color="{StaticResource Color.SurfaceHeader}" />
    <SolidColorBrush x:Key="Brush.SurfaceOverlay" Color="{StaticResource Color.SurfaceOverlay}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentStrong" Color="{StaticResource Color.AccentStrong}" />
    <SolidColorBrush x:Key="Brush.AccentSurface" Color="{StaticResource Color.AccentSurface}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSurface" Color="{StaticResource Color.SuccessSurface}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSurface" Color="{StaticResource Color.WarningSurface}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSurface" Color="{StaticResource Color.DangerSurface}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.TextOnAccent}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
</ResourceDictionary>
