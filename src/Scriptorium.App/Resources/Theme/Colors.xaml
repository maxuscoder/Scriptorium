<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fluent Cinema. Eight-digit WPF colors are #AARRGGBB, not CSS #RRGGBBAA. -->
    <Color x:Key="Color.Background">#0B0B0D</Color>
    <Color x:Key="Color.Surface">#101012</Color>
    <Color x:Key="Color.SurfaceHeader">#101012</Color>
    <Color x:Key="Color.SurfaceElevated">#17171A</Color>
    <Color x:Key="Color.SurfaceOverlay">#1E1E22</Color>
    <Color x:Key="Color.SurfacePressed">#26262B</Color>
    <Color x:Key="Color.Border">#12FFFFFF</Color>
    <Color x:Key="Color.BorderStrong">#1CFFFFFF</Color>
    <Color x:Key="Color.Accent">#FF9D00</Color>
    <Color x:Key="Color.AccentStrong">#FFAD24</Color>
    <Color x:Key="Color.AccentPressed">#E58D00</Color>
    <Color x:Key="Color.AccentMuted">#18FF9D00</Color>
    <Color x:Key="Color.AccentBorder">#55FF9D00</Color>
    <Color x:Key="Color.SelectionSurface">#18FF9D00</Color>
    <Color x:Key="Color.NavigationHover">#1E1E22</Color>
    <Color x:Key="Color.Success">#63D297</Color>
    <Color x:Key="Color.SuccessSurface">#1863D297</Color>
    <Color x:Key="Color.Warning">#E5B567</Color>
    <Color x:Key="Color.WarningSurface">#18E5B567</Color>
    <Color x:Key="Color.Danger">#FF6B6B</Color>
    <Color x:Key="Color.DangerSurface">#18FF6B6B</Color>
    <Color x:Key="Color.DangerHover">#FF8585</Color>
    <Color x:Key="Color.DangerPressed">#E85C5C</Color>
    <Color x:Key="Color.TextPrimary">#F5F5F7</Color>
    <Color x:Key="Color.TextSecondary">#A7A7AD</Color>
    <Color x:Key="Color.TextMuted">#73737A</Color>
    <Color x:Key="Color.TextDisabled">#55555C</Color>
    <Color x:Key="Color.TextOnAccent">#0B0B0D</Color>
    <Color x:Key="Color.TextOnDanger">#0B0B0D</Color>
    <Color x:Key="Color.TextOnDark">#F5F5F7</Color>
    <Color x:Key="Color.FocusRing">#FF9D00</Color>
    <Color x:Key="Color.Shadow">#000000</Color>
    <Color x:Key="Color.Overlay">#99000000</Color>
    <Color x:Key="Color.ArtworkScrim">#44000000</Color>
    <Color x:Key="Color.ArtworkBadge">#CC0B0B0D</Color>
    <Color x:Key="Color.ArtworkFallback">#55262626</Color>
    <Color x:Key="Color.ProgressTrack">#66000000</Color>
    <Color x:Key="Color.PlaybackSurface">#000000</Color>
    <Color x:Key="Color.PlaybackFeedback">#C0000000</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceHeader" Color="{StaticResource Color.SurfaceHeader}" />
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}" />
    <SolidColorBrush x:Key="Brush.SurfaceOverlay" Color="{StaticResource Color.SurfaceOverlay}" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="{StaticResource Color.SurfacePressed}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentStrong" Color="{StaticResource Color.AccentStrong}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}" />
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="{StaticResource Color.AccentBorder}" />
    <SolidColorBrush x:Key="Brush.SelectionSurface" Color="{StaticResource Color.SelectionSurface}" />
    <SolidColorBrush x:Key="Brush.NavigationHover" Color="{StaticResource Color.NavigationHover}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSurface" Color="{StaticResource Color.SuccessSurface}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSurface" Color="{StaticResource Color.WarningSurface}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSurface" Color="{StaticResource Color.DangerSurface}" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="{StaticResource Color.DangerHover}" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="{StaticResource Color.DangerPressed}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.TextOnAccent}" />
    <SolidColorBrush x:Key="Brush.TextOnDanger" Color="{StaticResource Color.TextOnDanger}" />
    <SolidColorBrush x:Key="Brush.TextOnDark" Color="{StaticResource Color.TextOnDark}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="{StaticResource Color.Shadow}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
    <SolidColorBrush x:Key="Brush.ArtworkScrim" Color="{StaticResource Color.ArtworkScrim}" />
    <SolidColorBrush x:Key="Brush.ArtworkBadge" Color="{StaticResource Color.ArtworkBadge}" />
    <SolidColorBrush x:Key="Brush.ArtworkFallback" Color="{StaticResource Color.ArtworkFallback}" />
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="{StaticResource Color.ProgressTrack}" />
    <SolidColorBrush x:Key="Brush.PlaybackSurface" Color="{StaticResource Color.PlaybackSurface}" />
    <SolidColorBrush x:Key="Brush.PlaybackFeedback" Color="{StaticResource Color.PlaybackFeedback}" />
</ResourceDictionary>
