<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Open sections and quiet row rules keep controls, not containers, in focus. -->
    <Thickness x:Key="Settings.PageMargin">40,32,40,48</Thickness>
    <Thickness x:Key="Settings.SectionHeadingMargin">0,32,0,6</Thickness>
    <Thickness x:Key="Settings.RowContentMargin">8,14,24,14</Thickness>
    <Thickness x:Key="Settings.ValueMargin">0,0,8,0</Thickness>
    <Thickness x:Key="Settings.RowDescriptionMargin">0,4,0,0</Thickness>
    <Thickness x:Key="Settings.DividerMargin">8,0</Thickness>
    <Thickness x:Key="Settings.FolderPadding">8,12</Thickness>
    <Thickness x:Key="Settings.AboutLabelMargin">8,0</Thickness>
    <Thickness x:Key="Settings.ActionGap">0,0,8,0</Thickness>
    <GridLength x:Key="Settings.ValueColumnWidth">224</GridLength>
    <GridLength x:Key="Settings.VolumeLabelWidth">48</GridLength>

    <Style x:Key="Settings.SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource Text.SubsectionTitle}">
        <Setter Property="Margin" Value="{StaticResource Settings.SectionHeadingMargin}" />
    </Style>
    <Style x:Key="Settings.Group" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Settings.Row" TargetType="Grid">
        <Setter Property="MinHeight" Value="76" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="Settings.RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Settings.RowDescription" TargetType="TextBlock" BasedOn="{StaticResource Text.Helper}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Margin" Value="{StaticResource Settings.RowDescriptionMargin}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Settings.RowDivider" TargetType="Border" BasedOn="{StaticResource Divider}">
        <Setter Property="Margin" Value="{StaticResource Settings.DividerMargin}" />
    </Style>
    <Style x:Key="Settings.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource Input.ComboBox}">
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Settings.VolumeSlider" TargetType="Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Keyboard}" />
    </Style>
    <Style x:Key="Settings.ActionButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="MinWidth" Value="84" />
    </Style>
    <Style x:Key="Settings.DestructiveAction" TargetType="Button" BasedOn="{StaticResource Button.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.DangerSurface}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.DangerHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.DangerSurface}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
