  <ItemGroup>
    <ProjectReference Include="..\Scriptorium.Core\Scriptorium.Core.csproj" />
    <ProjectReference Include="..\Scriptorium.Infrastructure\Scriptorium.Infrastructure.csproj" />
  </ItemGroup>

</Project>
