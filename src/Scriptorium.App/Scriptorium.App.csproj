    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>Scriptorium.App</RootNamespace>
    <AssemblyName>Scriptorium.App</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
